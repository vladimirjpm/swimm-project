# Дамп бизнес-данных для наполнения прода (server/db/dump-seed.sh).
# 14 МБ строк из боевой базы — в репозитории им не место.
server/db/seed-data.sql

# Приватные тренировки групп — вход сидера --seed-dolphin-training. Репозиторий публичный,
# а тренировки видят только участники группы (Sys_-контур).
server/db/private/

# Архив файлов-источников справочника рекордов: чужие PDF, репозиторий публичный.
# Устройство и правила сверки — в README.md внутри самой папки (он тоже не коммитится).
# ⚠ Слэш обязателен: ведущий «!» в .gitignore значит ОТРИЦАНИЕ, и незаэкранированная
# строка «!records-sources/» читается как «наоборот, не игнорируй» (так и вышло с первого раза).
\!records-sources/
