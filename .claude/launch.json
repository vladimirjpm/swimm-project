{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "swimm-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "server/Swimm.API",
        "--urls",
        "http://localhost:5078"
      ],
      "port": 5078
    },
    {
      "name": "swimm-api-5079",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "server/Swimm.API",
        "--no-build",
        "--configuration",
        "Release",
        "--urls",
        "http://localhost:5079"
      ],
      "port": 5079
    },
    {
      "name": "client-5079",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set SWIMM_API_TARGET=http://localhost:5079&& npm --prefix client run dev"
      ],
      "port": 5173,
      "autoPort": true
    }
  ]
}