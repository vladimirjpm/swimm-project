@page
@model Swimm.API.Pages.Admin.Results.IndexModel
@{
    ViewData["Title"] = "Results";
    ViewData["PageSubtitle"] = "Ручная правка отдельного результата по Id";

    var flash = TempData["Flash"] as string;
}

@if (!string.IsNullOrEmpty(flash))
{
    <script>
        document.addEventListener('DOMContentLoaded', () => toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(flash)), 3000));
    </script>
}

<div class="max-w-[560px]">
    <div class="admin-card mb-4">
        <form method="post" class="flex items-end gap-3">
            <label class="flex flex-col gap-1 flex-1">
                <span class="text-xs text-admin-text-muted">Id результата <span class="text-admin-danger">*</span></span>
                <input asp-for="ResultId" type="number" min="1" class="admin-input" autocomplete="off" placeholder="напр. 123456" required />
            </label>
            <button type="submit" class="admin-btn admin-btn-primary">Открыть</button>
        </form>
    </div>

    <div class="admin-card border-l-[3px] border-l-admin-warning bg-admin-warning/5 py-3 px-4 text-xs text-admin-text-muted leading-relaxed">
        Форма правит одну строку результата (время, место, дорожку, дисквалификацию и т.п.)
        для исправления опечаток протокола — вместо переимпорта всего соревнования.
        <strong class="text-admin-text">Меняет публичные данные</strong>, все правки пишутся в
        <a href="/Admin/Audit" class="text-admin-accent hover:underline">журнал аудита</a>.
        Id результата виден в браузере данных <a href="/Admin/Api" class="text-admin-accent hover:underline">Admin/Api</a>.
        Эстафетные строки этой формой не правятся.
    </div>
</div>

<details id="anomalies-wrap" class="mt-8 max-w-[900px]">
    <summary id="anomalies-summary" class="cursor-pointer select-none text-sm font-semibold text-admin-text">Аномалии</summary>
    <div id="anomalies-body" class="mt-3 text-[13px] text-admin-text-muted">Не загружено — раскрой секцию.</div>
</details>

@section Scripts {
<script>
(function () {
    const API = '/api/admin/results/anomalies';
    // Deep-link фильтр с дашборда: ?filter=fk-anomaly|empty-relay — раскрыть секцию и подсветить нужную таблицу.
    const qsFilter = new URLSearchParams(location.search).get('filter');
    const highlight = qsFilter === 'fk-anomaly' ? 'fk' : qsFilter === 'empty-relay' ? 'relay' : null;

    let loaded = false;
    async function load() {
        if (loaded) return;
        loaded = true;
        const body = document.getElementById('anomalies-body');
        body.textContent = 'Загружаю…';
        try {
            const r = await fetch(API, { credentials: 'same-origin' });
            const data = await r.json();
            body.innerHTML = `
                <div id="fk-block" class="mb-4">
                    <div class="mb-1 font-semibold text-admin-text">FK-аномалии — показаны ${data.fkAnomalies.items.length} из ${data.fkAnomalies.total}</div>
                    ${data.fkAnomalies.items.length === 0 ? '<div class="italic">Нет.</div>' : `
                    <div class="overflow-x-auto"><table class="admin-table">
                        <thead><tr><th>Result Id</th><th>Swimmer Id</th><th>Club Id</th><th>Competition Id</th></tr></thead>
                        <tbody>${data.fkAnomalies.items.map(x => `
                            <tr><td><a href="/Admin/Results/Edit?id=${x.resultId}" class="text-admin-accent hover:underline">${x.resultId}</a></td>
                                <td>${x.swimmerId}</td><td>${x.clubId}</td><td>${x.competitionId}</td></tr>`).join('')}</tbody>
                    </table></div>`}
                </div>
                <div id="relay-block">
                    <div class="mb-1 font-semibold text-admin-text">Пустые эстафеты — показаны ${data.emptyRelays.items.length} из ${data.emptyRelays.total}</div>
                    ${data.emptyRelays.items.length === 0 ? '<div class="italic">Нет.</div>' : `
                    <div class="overflow-x-auto"><table class="admin-table">
                        <thead><tr><th>Relay Id</th><th>Competition Id</th></tr></thead>
                        <tbody>${data.emptyRelays.items.map(x => `
                            <tr><td>${x.relayId}</td><td>${x.competitionId}</td></tr>`).join('')}</tbody>
                    </table></div>`}
                </div>`;
            if (highlight) {
                const el = document.getElementById(highlight === 'fk' ? 'fk-block' : 'relay-block');
                if (el) {
                    el.style.outline = '2px solid var(--color-admin-accent, #4fc3f7)';
                    el.style.outlineOffset = '4px';
                    setTimeout(() => { el.style.outline = ''; el.style.outlineOffset = ''; }, 2000);
                }
            }
        } catch (e) {
            body.textContent = 'Ошибка: ' + e.message;
            loaded = false;
        }
    }

    document.getElementById('anomalies-wrap').addEventListener('toggle', (e) => {
        if (e.target.open) load();
    });

    if (highlight) {
        document.getElementById('anomalies-wrap').open = true;
        load();
        document.getElementById('anomalies-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
})();
</script>
}
