@page
@model Swimm.API.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "Import";
    ViewData["PageSubtitle"] = "Импорт соревнований (JSON/PDF) и рекордов из внешних источников";
}

<div class="max-w-[900px] mx-auto">
    <!-- Top-level tabs: что импортируем -->
    <div class="flex gap-2 mb-6">
        <button id="top-tab-competitions" class="import-tab import-tab-active py-2 px-5 rounded-md text-sm font-semibold cursor-pointer border-none">
            Соревнования
        </button>
        <button id="top-tab-records" class="import-tab py-2 px-5 rounded-md text-sm font-semibold cursor-pointer border-none">
            Рекорды
        </button>
    </div>

    <!-- ======================================================================== -->
    <!-- ТАБ «СОРЕВНОВАНИЯ» — прежняя логика JSON/PDF, источники теперь карточки  -->
    <!-- ======================================================================== -->
    <div id="competitions-panel">
        <!-- Source cards: PDF vs JSON -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
            <button id="tab-json" class="import-tab import-tab-active source-card text-left p-4 rounded-lg border-none cursor-pointer">
                <div class="text-2xl mb-1">🗂</div>
                <div class="font-semibold text-admin-text mb-1">JSON (legacy формат)</div>
                <div class="text-xs text-admin-text-muted">Файл выгрузки старого сайта — <code class="text-admin-accent">ResultWrap</code> или массив <code class="text-admin-accent">Result[]</code></div>
            </button>
            <button id="tab-pdf" class="import-tab source-card text-left p-4 rounded-lg border-none cursor-pointer">
                <div class="text-2xl mb-1">📄</div>
                <div class="font-semibold text-admin-text mb-1">PDF протокол (IsrOrg)</div>
                <div class="text-xs text-admin-text-muted">Протокол соревнования с isr.org.il, PDF, HE/EN — до 4 файлов на составные протоколы</div>
            </button>
        </div>

        <!-- ============ JSON mode ============ -->
        <div id="json-mode">
            <!-- Drop zone -->
            <div id="drop-zone" class="drop-zone border-2 border-dashed border-admin-border rounded-xl p-12 text-center cursor-pointer transition-colors duration-200 mb-6">
                <div class="text-4xl mb-4">📄</div>
                <div class="text-lg text-admin-text mb-2">Перетащите JSON-файл сюда</div>
                <div class="text-admin-text-muted mb-4">или</div>
                <label class="inline-flex items-center gap-2 bg-admin-accent text-[#0c2536] font-semibold py-2 px-5 rounded-md cursor-pointer hover:bg-[#81d4fa] transition-colors">
                    📁 Выбрать файл
                    <input type="file" id="file-input" accept=".json" class="hidden">
                </label>
                <div id="file-name" class="mt-4 text-admin-text-muted text-sm hidden"></div>
            </div>
        </div>

        <!-- ============ PDF mode ============ -->
        <div id="pdf-mode" class="hidden">
            <div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-[0.85rem] text-admin-text-muted leading-relaxed">
                Основной файл обязателен; для многодневных/составных протоколов можно добавить до трёх
                дополнительных файлов. После разбора появится превью — проверьте счётчики и только потом
                нажимайте «Импортировать».
            </div>

            <div class="admin-card p-5 mb-6 space-y-4">
                <div>
                    <label class="block text-sm text-admin-text mb-1">Основной файл <span class="text-admin-danger">*</span></label>
                    <input type="file" id="pdf-file" accept=".pdf" class="admin-input w-full">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Доп. файл 2</label>
                        <input type="file" id="pdf-file-2" accept=".pdf" class="admin-input w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Доп. файл 3</label>
                        <input type="file" id="pdf-file-3" accept=".pdf" class="admin-input w-full text-xs">
                    </div>
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Доп. файл 4</label>
                        <input type="file" id="pdf-file-4" accept=".pdf" class="admin-input w-full text-xs">
                    </div>
                </div>
                <div class="flex flex-wrap gap-4 items-end">
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Формат</label>
                        <select id="pdf-format" class="admin-input min-w-[180px]">
                            @foreach (var f in Model.ParseFormats)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Бассейн</label>
                        <select id="pdf-pool-type" class="admin-input min-w-[120px]">
                            <option value="">—</option>
                            @foreach (var pt in Model.PoolTypeOptions)
                            {
                                <option value="@pt">@pt</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Язык основного файла</label>
                        <select id="pdf-language" class="admin-input min-w-[150px]">
                            @foreach (var l in Swimm.API.Pages.Admin.ImportModel.Languages)
                            {
                                <option value="@l.Code">@l.Label</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs text-admin-text-muted mb-1">Страна соревнования</label>
                        <select id="pdf-country" class="admin-input min-w-[180px]">
                            <optgroup label="★ Избранные">
                                @foreach (var c in Swimm.API.Pages.Admin.Shared.CountryCatalog.Favorites)
                                {
                                    <option value="@c.Code">@c.Label (@c.Code)</option>
                                }
                            </optgroup>
                            <optgroup label="Все страны">
                                @foreach (var c in Swimm.API.Pages.Admin.Shared.CountryCatalog.Others)
                                {
                                    <option value="@c.Code">@c.Label (@c.Code)</option>
                                }
                            </optgroup>
                        </select>
                    </div>
                    <label class="inline-flex items-center gap-2 text-sm text-admin-text pb-2">
                        <input type="checkbox" id="pdf-is-award"> Наградной протокол (isAward)
                    </label>
                </div>
                <button id="btn-parse-pdf" disabled
                    class="admin-btn admin-btn-primary py-2.5 px-6 disabled:opacity-40 disabled:cursor-not-allowed">
                    🔍 Распарсить
                </button>
            </div>

            <!-- PDF preview -->
            <div id="pdf-preview" class="hidden mb-6">
                <div class="admin-card p-5">
                    <h3 class="text-lg mb-3 text-admin-accent">Превью разбора</h3>
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-3 mb-4" id="pdf-preview-stats"></div>
                    <table class="w-full text-sm mb-4" id="pdf-preview-table">
                        <thead>
                            <tr class="text-left text-admin-text-muted border-b border-admin-border">
                                <th class="py-1 pr-3">Соревнование</th>
                                <th class="py-1 pr-3">Дата</th>
                                <th class="py-1">Результатов</th>
                            </tr>
                        </thead>
                        <tbody id="pdf-preview-competitions"></tbody>
                    </table>
                    <div id="pdf-preview-warnings" class="hidden mb-4">
                        <h4 class="text-[#ffa726] text-sm mb-2">⚠️ Предупреждения:</h4>
                        <div id="pdf-warnings-list" class="bg-black/30 rounded-md p-3 max-h-[160px] overflow-y-auto text-xs text-[#ffcc80] font-mono leading-relaxed"></div>
                    </div>
                    <details id="pdf-debug-details" class="hidden">
                        <summary class="text-admin-text-muted text-xs cursor-pointer">Debug-лог парсера</summary>
                        <pre id="pdf-debug-log" class="bg-black/30 rounded-md p-3 mt-2 max-h-[240px] overflow-auto text-xs text-admin-text-muted whitespace-pre-wrap leading-relaxed"></pre>
                    </details>
                </div>
            </div>

            <!-- PDF parse error (persistent, copyable — не тост, чтобы не пропадало) -->
            <div id="pdf-parse-error" class="hidden mb-6">
                <div class="admin-card p-5 border-l-[3px] border-l-admin-danger bg-admin-danger/5">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-semibold text-admin-danger">Ошибка разбора PDF</h3>
                        <button id="btn-copy-pdf-error" type="button" class="admin-btn admin-btn-ghost py-1 px-2.5 text-xs">📋 Копировать</button>
                    </div>
                    <pre id="pdf-parse-error-log" class="bg-black/30 rounded-md p-3 max-h-[400px] overflow-auto text-xs text-admin-text whitespace-pre-wrap leading-relaxed"></pre>
                </div>
            </div>
        </div>

        <!-- Categories (shared) -->
        <div id="cat-section" class="mb-6">
            <div class="text-sm text-admin-text mb-2">
                Категории для этого импорта
                <span class="text-admin-text-muted text-xs">(перекрывают <code class="text-admin-accent">categories</code> из JSON; применяются ко всем соревнованиям файла)</span>
            </div>
            <div id="cat-list" class="flex flex-wrap gap-2 text-sm text-admin-text-muted">загрузка...</div>
        </div>

        <!-- Overwrite existing (upsert) — показывается только когда превью/файл матчит существующее соревнование -->
        <div id="overwrite-section" class="mb-6 hidden">
            <label class="inline-flex items-center gap-2 text-sm text-admin-text bg-[rgba(255,213,79,0.08)] border border-[rgba(255,213,79,0.3)] rounded-md py-2 px-3 cursor-pointer">
                <input type="checkbox" id="overwrite-existing-cb">
                Обновить существующее соревнование <span id="overwrite-comp-name" class="text-admin-text-muted"></span> (upsert: сматченные результаты обновятся на месте, медиа сохранится)
            </label>
            <label id="delete-missing-block" class="hidden mt-2 inline-flex items-center gap-2 text-sm text-admin-text bg-admin-danger/5 border border-admin-danger/30 rounded-md py-2 px-3 cursor-pointer">
                <input type="checkbox" id="delete-missing-cb">
                Удалять результаты, которых нет в файле
            </label>
            <div id="overwrite-delete-warning" class="hidden mt-2 text-sm text-admin-danger border-l-[3px] border-l-admin-danger bg-admin-danger/5 rounded-md py-2 px-3"></div>
        </div>

        <!-- Multi-day event (shared) -->
        <div id="event-section" class="mb-6">
            <div class="text-sm text-admin-text mb-2">
                Многодневное соревнование
                <span class="text-admin-text-muted text-xs">(привязать этот файл-день к событию; имя дня уйдёт в SubName, общее имя — у события)</span>
            </div>
            <div class="flex flex-wrap gap-3 items-center">
                <select id="event-select" class="admin-input min-w-[280px]">
                    <option value="">— Без события (обычное соревнование) —</option>
                    <option value="__new__">➕ Создать новое событие…</option>
                </select>
                <input type="text" id="event-new-name" placeholder="Имя нового события" class="admin-input min-w-[280px] hidden" />
            </div>
        </div>

        <!-- Правила начисления очков (shared, Э5) -->
        <div id="rules-section" class="mb-6">
            <div class="text-sm text-admin-text mb-2">
                Правила начисления очков
                <span class="text-admin-text-muted text-xs">
                    (проставляются каждому создаваемому соревнованию; «Авто» — подбор по дате и типу,
                    кроме правил с пометкой <strong class="text-admin-text">manual</strong>)
                </span>
            </div>
            <div class="flex flex-wrap gap-3 items-end">
                <div>
                    <label class="block text-xs text-admin-text-muted mb-1">Клубные очки</label>
                    <select id="rule-clubs" class="admin-input min-w-[280px]">
                        <option value="">— Авто (по дате и типу) —</option>
                        @foreach (var r in Model.ClubRules)
                        {
                            <option value="@r.Id">@r.Version · @r.Scope · с @r.EffectiveFrom.ToString("dd/MM/yyyy")@(r.ManualOnly ? " · manual" : "")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-admin-text-muted mb-1">High Point</label>
                    <select id="rule-swimmers" class="admin-input min-w-[280px]">
                        <option value="">— Авто (по дате и типу) —</option>
                        @foreach (var r in Model.SwimmerRules)
                        {
                            <option value="@r.Id">@r.Version · @r.Scope · с @r.EffectiveFrom.ToString("dd/MM/yyyy")@(r.ManualOnly ? " · manual" : "")</option>
                        }
                    </select>
                </div>
                <a href="/Admin/PointsRules" class="admin-btn admin-btn-ghost py-2 px-3 mb-[2px]">Правила →</a>
            </div>
            <div class="text-xs text-admin-text-muted mt-1.5">
                Переимпорт существующего соревнования привязку не меняет — она правится на
                <a href="/Admin/Competitions" class="text-admin-accent hover:underline">/Admin/Competitions</a>.
            </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-3 mb-6">
            <button id="btn-upload"
                class="import-action-json bg-admin-success text-white font-semibold py-2.5 px-6 rounded-md border-none cursor-pointer text-sm transition-opacity hover:opacity-85 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                🚀 Загрузить и импортировать
            </button>
            <button id="btn-import-pdf"
                class="import-action-pdf hidden bg-admin-success text-white font-semibold py-2.5 px-6 rounded-md border-none cursor-pointer text-sm transition-opacity hover:opacity-85 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
                🚀 Импортировать
            </button>
            <button id="btn-clear" class="import-action-json admin-btn admin-btn-ghost py-2.5 px-5 hidden">
                ✕ Очистить
            </button>
        </div>

        <!-- Progress -->
        <div id="progress" class="hidden mb-6">
            <div class="flex items-center gap-3 text-admin-text-muted">
                <span class="admin-spinner size-5 text-admin-accent"></span>
                <span>Импорт выполняется...</span>
            </div>
        </div>

        <!-- Result -->
        <div id="result" class="hidden">
            <div id="result-card" class="bg-admin-surface rounded-lg p-5 border-l-[3px]">
                <h3 id="result-title" class="text-lg mb-4"></h3>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-3 mb-4" id="result-stats"></div>
                <div id="result-errors" class="hidden mt-4">
                    <h4 class="text-admin-danger text-sm mb-2">Ошибки:</h4>
                    <div id="error-list" class="bg-black/30 rounded-md p-3 max-h-[200px] overflow-y-auto text-xs text-[#ef9a9a] font-mono leading-relaxed"></div>
                </div>
                <div id="result-diag" class="hidden mt-4">
                    <h4 class="text-admin-accent text-sm mb-2">📋 Diagnostic Log:</h4>
                    <div id="diag-list" class="bg-black/30 rounded-md p-3 max-h-[200px] overflow-y-auto text-xs text-[#80cbc4] font-mono leading-relaxed"></div>
                </div>
            </div>
        </div>

        <!-- Preview -->
        <div id="preview" class="hidden mt-6">
            <h3 class="text-admin-accent text-sm uppercase mb-2">Предпросмотр JSON</h3>
            <div class="bg-black/30 rounded-lg p-4 max-h-[300px] overflow-auto">
                <pre id="preview-content" class="text-xs text-admin-text-muted whitespace-pre-wrap break-all leading-relaxed"></pre>
            </div>
        </div>

        <!-- Clear Data Section -->
        <div class="pt-0">
            <hr class="border-admin-border mb-6">
            <div class="admin-card bg-admin-danger/5 border-l-[3px] border-l-admin-danger py-3 px-4 mb-4 text-[0.85rem] text-admin-text-muted leading-relaxed">
                ⚠️ <strong class="text-admin-danger">Опасная зона.</strong>
                Полная очистка удалит все импортированные данные: <span id="danger-tables">загрузка...</span>.<br>
                Справочник Styles и пользователи сохранятся.<br>
                <span class="text-admin-text-muted text-xs">Список таблиц: <code class="text-admin-accent">JsonImportService.ClearableTables</code> · Метод: <code class="text-admin-accent">JsonImportService.ClearDataAsync()</code></span>
            </div>
            <button id="btn-clear-data"
                class="bg-[#c62828] text-white font-semibold py-2.5 px-6 rounded-md border-none cursor-pointer text-sm transition-opacity hover:opacity-85">
                🗑️ Очистить все данные
            </button>
            <div id="clear-result" class="hidden mt-4">
                <div id="clear-result-card" class="bg-admin-surface rounded-lg p-5 border-l-[3px] border-l-admin-danger">
                    <h3 class="text-admin-danger text-lg mb-3">Результат очистки</h3>
                    <div id="clear-stats" class="grid grid-cols-[repeat(auto-fit,minmax(110px,1fr))] gap-3"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================================== -->
    <!-- ТАБ «РЕКОРДЫ» — этап 2.6: fetch/файл → дифф-превью → apply               -->
    <!-- ======================================================================== -->
    <div id="records-panel" class="hidden">
        <div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-[0.85rem] text-admin-text-muted leading-relaxed">
            Fetch/файл только парсит и строит дифф — запись в БД происходит отдельным шагом
            «Применить выбранное». Ничего не удаляется автоматически — «нет в источнике» показывается
            только для информации.
        </div>

        <!-- Свежесть справочника (records-freshness-plan U2/U4): «Проверить все» — fetch + dry-run
             дифф каждого источника по очереди, в журнал Sys_RecordSourceChecks. Ничего не применяет. -->
        <div class="flex flex-wrap items-center gap-3 mb-4">
            <button id="rs-check-all-btn" class="admin-btn admin-btn-primary text-sm">🔎 Проверить все источники</button>
            <span id="rs-check-all-status" class="text-xs text-admin-text-muted">
                сходит в каждый источник и покажет, что изменилось; до 5 минут, World Aquatics медленный
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
            <div class="admin-card p-4 records-source-card" data-source="worldrecords">
                <div class="text-2xl mb-1">🌍</div>
                <div class="font-semibold text-admin-text mb-1">World Records</div>
                <div class="text-xs text-admin-text-muted mb-2">api.worldaquatics.com · XLSX, 4 файла, авто</div>
                <div class="text-xs text-admin-text-muted mb-3">Обновлено: <span class="rs-status" data-source="worldrecords">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-2">Проверено: <span class="rs-checked" data-source="worldrecords">—</span></div>
                <button class="admin-btn admin-btn-primary w-full text-sm rs-fetch-btn" data-source="worldrecords" data-pool-primary="25m">
                    ⬇ Fetch from URL
                </button>
            </div>

            <div class="admin-card p-4 records-source-card" data-source="wa-masters">
                <div class="text-2xl mb-1">🌍</div>
                <div class="font-semibold text-admin-text mb-1">Masters World Records</div>
                <div class="text-xs text-admin-text-muted mb-2">worldaquatics.com · PDF, личные дистанции (25-29…)</div>
                <div class="text-xs text-admin-text-muted mb-1">Обновлено: <span class="rs-status" data-source="wa-masters">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-2">Проверено: <span class="rs-checked" data-source="wa-masters">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-3">Файлы: <span class="rs-links" data-source="wa-masters">ищу на сайте…</span></div>
                <div class="flex gap-2 mb-2">
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-fetch-btn" data-source="wa-masters" data-pool-primary="50m">⬇ Fetch</button>
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-file-toggle" data-source="wa-masters">📁 Файл</button>
                </div>
                <div class="rs-file-panel hidden space-y-2 mt-2" data-source="wa-masters">
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Файл LCM (50 м)</label>
                        <input type="file" accept=".pdf" class="admin-input w-full text-xs rs-file-primary">
                    </div>
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Файл SCM (25 м, опц.)</label>
                        <input type="file" accept=".pdf" class="admin-input w-full text-xs rs-file-secondary">
                    </div>
                    <button class="admin-btn admin-btn-primary w-full text-xs rs-parse-files-btn" data-source="wa-masters" data-pool-primary="50m">
                        Разобрать файл(ы)
                    </button>
                </div>
            </div>

            <div class="admin-card p-4 records-source-card" data-source="wa-junior">
                <div class="text-2xl mb-1">🌍</div>
                <div class="font-semibold text-admin-text mb-1">World Junior Records</div>
                <div class="text-xs text-admin-text-muted mb-2">api.worldaquatics.com · JSON, 4 запроса (ж 14-17, м 15-18), авто · до 3 мин</div>
                <div class="text-xs text-admin-text-muted mb-3">Обновлено: <span class="rs-status" data-source="wa-junior">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-2">Проверено: <span class="rs-checked" data-source="wa-junior">—</span></div>
                <div class="flex gap-2 mb-2">
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-fetch-btn" data-source="wa-junior" data-pool-primary="50m">⬇ Fetch</button>
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-file-toggle" data-source="wa-junior">📁 Файл</button>
                </div>
                <div class="rs-file-panel hidden space-y-2 mt-2" data-source="wa-junior">
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">JSON-ответ (пол и бассейн — внутри файла)</label>
                        <input type="file" accept=".json" class="admin-input w-full text-xs rs-file-primary">
                    </div>
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Второй JSON (опц.)</label>
                        <input type="file" accept=".json" class="admin-input w-full text-xs rs-file-secondary">
                    </div>
                    <button class="admin-btn admin-btn-primary w-full text-xs rs-parse-files-btn" data-source="wa-junior" data-pool-primary="50m">
