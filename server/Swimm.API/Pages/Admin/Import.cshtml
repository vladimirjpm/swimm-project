                </div>
            </div>

            <div class="admin-card p-4 records-source-card" data-source="isrorg-age">
                <div class="text-2xl mb-1">🇮🇱</div>
                <div class="font-semibold text-admin-text mb-1">Age Records</div>
                <div class="text-xs text-admin-text-muted mb-2">isr.org.il · PDF-протокол (10–18, national)</div>
                <div class="text-xs text-admin-text-muted mb-1">Обновлено: <span class="rs-status" data-source="isrorg-age">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-2">Проверено: <span class="rs-checked" data-source="isrorg-age">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-3">Файлы: <span class="rs-links" data-source="isrorg-age">ищу на сайте…</span></div>
                <div class="flex gap-2 mb-2">
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-fetch-btn" data-source="isrorg-age" data-pool-primary="25m">⬇ Fetch</button>
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-file-toggle" data-source="isrorg-age">📁 Файл</button>
                </div>
                <div class="rs-file-panel hidden space-y-2 mt-2" data-source="isrorg-age">
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Файл 25m</label>
                        <input type="file" accept=".pdf" class="admin-input w-full text-xs rs-file-primary">
                    </div>
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Файл 50m (опц.)</label>
                        <input type="file" accept=".pdf" class="admin-input w-full text-xs rs-file-secondary">
                    </div>
                    <button class="admin-btn admin-btn-primary w-full text-xs rs-parse-files-btn" data-source="isrorg-age" data-pool-primary="25m">
                        Разобрать файл(ы)
                    </button>
                </div>
            </div>

            <div class="admin-card p-4 records-source-card" data-source="isrorg-masters">
                <div class="text-2xl mb-1">🇮🇱</div>
                <div class="font-semibold text-admin-text mb-1">Masters Records</div>
                <div class="text-xs text-admin-text-muted mb-2">isr.org.il · PDF-протокол (25-29…)</div>
                <div class="text-xs text-admin-text-muted mb-1">Обновлено: <span class="rs-status" data-source="isrorg-masters">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-2">Проверено: <span class="rs-checked" data-source="isrorg-masters">—</span></div>
                <div class="text-[11px] text-admin-text-muted mb-3">Файлы: <span class="rs-links" data-source="isrorg-masters">ищу на сайте…</span></div>
                <div class="flex gap-2 mb-2">
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-fetch-btn" data-source="isrorg-masters" data-pool-primary="50m">⬇ Fetch</button>
                    <button class="admin-btn admin-btn-ghost flex-1 text-xs rs-file-toggle" data-source="isrorg-masters">📁 Файл</button>
                </div>
                <div class="rs-file-panel hidden space-y-2 mt-2" data-source="isrorg-masters">
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Файл 50m</label>
                        <input type="file" accept=".pdf" class="admin-input w-full text-xs rs-file-primary">
                    </div>
                    <div>
                        <label class="block text-[10px] text-admin-text-muted mb-0.5">Файл 25m (опц.)</label>
                        <input type="file" accept=".pdf" class="admin-input w-full text-xs rs-file-secondary">
                    </div>
                    <button class="admin-btn admin-btn-primary w-full text-xs rs-parse-files-btn" data-source="isrorg-masters" data-pool-primary="50m">
                        Разобрать файл(ы)
                    </button>
                </div>
            </div>
        </div>

        <!-- ================================================================ -->
        <!-- ПРОГОН ПО СТРАНАМ (11.1.4). Национальные рекорды всех стран       -->
        <!-- источника: WR один раз + NR по стране, час-два фоном.             -->
        <!-- ================================================================ -->
        <div class="admin-card p-4 mb-6" id="countries-run-card">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
                <div>
                    <div class="font-semibold text-admin-text">Прогон по странам</div>
                    <div class="text-xs text-admin-text-muted mt-0.5">
                        Национальные рекорды (<code>open</code>) всех стран источника.
                        Мировые качаются один раз на прогон, дальше по паре файлов на страну.
                    </div>
                </div>
                <div class="text-xs text-admin-text-muted text-right whitespace-nowrap">
                    стран в источнике: <span id="cr-countries-total">—</span>
                </div>
            </div>

            @* Израиль исключается САМИМ прогоном, даже если его попросили явно (инвариант 2
               плана 11.1.2): на country/ISR/open федерация обязана применяться ПОСЛЕ World
               Aquatics, иначе молча откатятся её более свежие рекорды. *@
            <div class="text-[11px] text-admin-text-muted mb-3 leading-relaxed">
                ⚠ Израиль в прогон не входит никогда — его обновляет только
                <code>--records-refresh</code>, где порядок источников зашит (data-integrity, И-13).
                Прогон живёт в памяти процесса: рестарт API его теряет, дифф придётся собирать заново.
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button id="cr-run-all" class="admin-btn admin-btn-primary py-2 px-5 text-sm">
                    ▶ Прогнать все страны
                </button>
                <button id="cr-toggle-subset" class="admin-btn admin-btn-ghost py-1.5 px-3 text-xs">
                    Коды вручную
                </button>
                <span id="cr-hint" class="text-xs text-admin-text-muted"></span>
            </div>

            @* Список кодов — НЕ выбор охвата (он решён: все страны), а два узких случая:
               повтор упавших и одна страна для отладки. Потому и спрятан. *@
            <div id="cr-subset" class="hidden mt-3 flex flex-wrap items-end gap-2">
                <label class="text-[11px] text-admin-text-muted flex flex-col gap-0.5 flex-1 min-w-[16rem]">
                    Коды стран через запятую — повтор упавших или одна страна для отладки
                    <input id="cr-codes" class="admin-input w-full text-xs" placeholder="AGU, JAM" />
                </label>
                <button id="cr-run-subset" class="admin-btn admin-btn-ghost py-2 px-4 text-xs">Прогнать выбранные</button>
            </div>

            <div id="cr-progress" class="hidden mt-4">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs mb-2">
                    <span id="cr-state" class="text-admin-accent"></span>
                    <span class="text-admin-text-muted">строк набрано: <span id="cr-rows">0</span></span>
                    <span class="text-admin-text-muted">мировые: <span id="cr-world">—</span></span>
                    <span id="cr-israel" class="text-admin-text-muted"></span>
                </div>
                <div class="h-1.5 w-full rounded bg-admin-bg overflow-hidden">
                    <div id="cr-bar" class="h-full bg-admin-accent transition-all" style="width:0%"></div>
                </div>
                <div id="cr-failed" class="hidden mt-3 text-xs"></div>
                <div id="cr-mismatch" class="hidden mt-2 text-[11px] text-admin-text-muted"></div>
                @* Куда легла выгрузка разобранных строк: её надо закоммитить, а значит — найти.
                   Правило 11 в docs/pre-push-rules.md. *@
                <div id="cr-archive" class="hidden mt-2 text-[11px] text-admin-text-muted"></div>
            </div>
        </div>


        <!-- Diff preview -->
        <div id="records-diff" class="hidden admin-card p-5 mb-6">
            <h3 class="text-lg mb-3 text-admin-accent">Превью диффа: <span id="records-diff-source"></span></h3>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-3 mb-4" id="records-diff-stats"></div>
            <div class="overflow-auto max-h-[320px] mb-4">
                <table class="w-full text-xs" id="records-diff-table">
                    <thead>
                        <tr class="text-left text-admin-text-muted border-b border-admin-border">
                            <th class="py-1 pr-2">Дисциплина</th>
                            <th class="py-1 pr-2">Было</th>
                            <th class="py-1 pr-2">Станет</th>
                        </tr>
                    </thead>
                    <tbody id="records-diff-rows"></tbody>
                </table>
            </div>
            <div class="flex flex-wrap gap-4 items-center">
                <label class="inline-flex items-center gap-1.5 text-sm text-admin-text">
                    <input type="checkbox" id="records-apply-added" checked> Новые (<span id="records-added-count">0</span>)
                </label>
                <label class="inline-flex items-center gap-1.5 text-sm text-admin-text">
                    <input type="checkbox" id="records-apply-changed" checked> Изменившиеся (<span id="records-changed-count">0</span>)
                </label>
                <button id="records-apply-btn" class="admin-btn admin-btn-primary py-2 px-5 text-sm">✅ Применить выбранное</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Modal -->
<div id="confirm-modal" class="fixed inset-0 bg-black/60 z-[2000] hidden items-center justify-center" style="display:none;">
    <div class="bg-admin-surface rounded-xl p-6 max-w-md w-full mx-4 border border-admin-danger/30 shadow-2xl">
        <h3 class="text-admin-danger text-lg mb-3">⚠️ Подтверждение очистки</h3>
        <p class="text-admin-text text-sm mb-5 leading-relaxed">
            Будут удалены <strong>все</strong> записи из таблиц:<br>
            <span id="confirm-tables">загрузка...</span>.<br><br>
            Это действие <strong class="text-admin-danger">необратимо</strong>. Продолжить?
        </p>
        <div class="flex gap-3 justify-end">
            <button id="confirm-cancel" class="admin-btn admin-btn-ghost py-2 px-5">
                Отмена
            </button>
            <button id="confirm-ok"
                class="bg-[#c62828] text-white font-semibold py-2 px-5 rounded-md border-none cursor-pointer text-sm hover:opacity-85">
                🗑️ Да, очистить
            </button>
        </div>
    </div>
</div>

