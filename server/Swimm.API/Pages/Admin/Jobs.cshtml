@page
@model Swimm.API.Pages.Admin.JobsModel
@{
    ViewData["Title"] = "Jobs";
    // Мониторинг занимает всю ширину и рисует свою шапку (чип среды, переключатель вида).
    ViewData["WideMain"] = true;
    ViewData["OwnHeader"] = true;
}

@* Мониторинг фоновых служб — справка docs/admin-pages/jobs.md («Как устроена страница»).
   Разметка здесь — только каркас: всё рисуют скрипты wwwroot/js/admin/jobs/*.js из
   GET /api/admin/jobs/monitor (опрос раз в 30 с). Новая фоновая служба = карточка в
   Services/BackgroundJobsStatusService.cs (docs/pre-push-rules.md №14) — страница её покажет сама. *@

<header class="mb-4 flex flex-wrap items-center gap-x-3.5 gap-y-2 border-b border-admin-border pb-3">
    <h1 class="m-0 text-lg font-bold text-white">Jobs</h1>
    <span id="jobs-env" hidden class="inline-flex h-6 items-center gap-1.5 rounded-full bg-admin-env-local/15 px-2.5 text-xs font-semibold text-admin-env-local"></span>
    <span id="jobs-journal" class="text-xs text-admin-text-muted">загрузка…</span>
    <div class="ml-auto flex flex-wrap items-center gap-x-3.5 gap-y-2">
        <div role="group" aria-label="Вид страницы" class="flex overflow-hidden rounded-md border border-admin-border text-xs">
            <button type="button" data-view="timeline" aria-pressed="true" class="jobs-seg">Таймлайн</button>
            <button type="button" data-view="wall" aria-pressed="false" class="jobs-seg border-l border-admin-border">Стена</button>
        </div>
        <span id="jobs-updated" class="font-mono text-xs text-admin-text-muted" aria-live="off"></span>
        <button type="button" id="jobs-refresh" class="admin-btn admin-btn-ghost px-3 py-1.5">Обновить</button>
    </div>
</header>

<div id="jobs-error" role="alert" hidden
     class="mb-3 flex items-start gap-2 rounded-md border border-admin-warning/60 bg-admin-warning/10 px-3 py-2 text-xs text-admin-warning"></div>

<div id="jobs-counters" class="mb-3"></div>

<div id="jobs-view" class="min-w-0">
    <p class="text-sm text-admin-text-muted">Загрузка…</p>
</div>

@* Панель деталей службы — справа поверх страницы; на узком экране во всю ширину. *@
<aside id="job-detail" role="dialog" aria-modal="false" hidden
       class="fixed inset-y-0 right-0 z-40 w-full border-l border-admin-border bg-admin-surface shadow-2xl shadow-black/60 sm:w-[560px]">
    <div id="job-detail-body" class="h-full overflow-y-auto"></div>
</aside>

@* «Что изменилось» за прогон discovery / подробности прогона (GET /api/admin/jobs/runs/{id}). *@
<dialog id="run-changes" aria-labelledby="run-changes-title"
        class="m-auto w-[min(48rem,calc(100vw-2rem))] max-h-[calc(100vh-4rem)] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="sticky top-0 flex items-center gap-3 border-b border-admin-border bg-admin-surface px-5 py-3">
        <h2 id="run-changes-title" class="m-0 flex-1 text-base font-semibold text-white"></h2>
        <button type="button" data-close-run class="admin-btn admin-btn-ghost px-2.5 py-1" aria-label="Закрыть">✕</button>
    </div>
    <div id="run-changes-body"></div>
</dialog>

@section Scripts {
<script src="~/js/admin/jobs/jobs-ui.js" asp-append-version="true"></script>
<script src="~/js/admin/jobs/jobs-panels.js" asp-append-version="true"></script>
<script src="~/js/admin/jobs/jobs-timeline.js" asp-append-version="true"></script>
<script src="~/js/admin/jobs/jobs-wall.js" asp-append-version="true"></script>
<script src="~/js/admin/jobs/jobs-detail.js" asp-append-version="true"></script>
<script src="~/js/admin/jobs/jobs-page.js" asp-append-version="true"></script>
}
