@page
@model Swimm.API.Pages.Admin.HealthModel
@{
    ViewData["Title"] = "Health";
    ViewData["PageSubtitle"] = "Проверки целостности данных: одно место, история, статусы находок";
}

<div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-4 text-[0.85rem] text-admin-text-muted leading-relaxed">
    Реестр проверок (<code>IDataCheck</code>). Находка живёт <b>до устранения</b>, а не до
    следующего прогона: исчезла — закрывается сама, неустранимую можно
    <b>принять как есть</b>, и решение переживёт следующие прогоны.
    Проверки только ставят диагноз — лечение (переимпорт, склейка, удаление) остаётся
    отдельным осознанным действием. Подробности и журнал инцидентов —
    <code>docs/data-integrity.md</code>.
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
    <button id="btn-run" class="admin-btn admin-btn-primary cursor-pointer">Прогнать проверки</button>
    <span id="run-info" class="text-[12.5px] text-admin-text-muted"></span>
</div>

<div id="summary" class="mb-4 flex flex-wrap gap-3"></div>
<div id="groups" class="text-[13px] text-admin-text-muted">Загружаю…</div>

<details id="history-wrap" class="mt-8 max-w-[900px]">
    <summary class="cursor-pointer select-none text-sm font-semibold text-admin-text">История прогонов</summary>
    <div id="history" class="mt-3 text-[13px] text-admin-text-muted"></div>
</details>

<partial name="/Pages/Admin/Shared/_ConfirmDialog.cshtml" />

@section Scripts {
<script>
    // Данные из Razor — до скрипта страницы, он их читает (wwwroot/js/admin/health.js).
    window.__HEALTH = {
        publicBase: @Html.Raw(Json.Serialize(Model.PublicSiteBaseUrl)),
        clubRules: @Html.Raw(Json.Serialize(Model.ClubRules.Select(r => new { r.Id, r.Version, r.Description }))),
    };
</script>
<script src="~/js/admin/health.js" asp-append-version="true"></script>
}
