<!-- Фильтры -->
<form method="get" id="filters-form" class="admin-card flex flex-wrap items-end gap-3 px-4 py-3 mb-4">
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Поиск
        @* Число ищется ещё и как номер: compID федерации или Id соревнования в базе. *@
        <input name="q" value="@Model.Search" autocomplete="off" class="admin-input w-72" placeholder="Название, compID или № в базе…"
               title="Подстрока в названии или подзаголовке; число — ещё и compID федерации или номер соревнования в базе (у события — любого дня)" />
    </label>
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Стадия
        <select name="stage" class="admin-input">
            <option value="">Все</option>
            <option value="OnSite" selected="@(Model.Stage == "OnSite")">на сайте</option>
            <option value="Imported" selected="@(Model.Stage == "Imported")">импортировано</option>
            <option value="DbOnly" selected="@(Model.Stage == "DbOnly")">только в БД</option>
            <option value="Ignored" selected="@(Model.Stage == "Ignored")">скрыто</option>
        </select>
    </label>
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Категория
        <select name="cat" class="admin-input">
            <option value="">Все</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.Key" selected="@(cat.Key == Model.CategoryKey)">@(!string.IsNullOrEmpty(cat.Badge) ? cat.Badge + " " : "")@cat.Name</option>
            }
        </select>
    </label>
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Тип
        <select name="kind" class="admin-input">
            <option value="">Все</option>
            <option value="champ" selected="@(Model.Kind == "champ")">чемпионат Израиля</option>
        </select>
    </label>
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Дисциплина
        @* Федерация проводит не только плавание: артистическое (שחייה אומנותית) во
           входящих есть, а нам не нужно. Прячем ФИЛЬТРОМ с дефолтом, не удаляя строки —
           понадобится, переключат на «все». *@
        <select name="discipline" class="admin-input">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Discipline))">плавание</option>
            <option value="artistic" selected="@(Model.Discipline == "artistic")">артистическое</option>
            <option value="other" selected="@(Model.Discipline == "other")">прочее</option>
            <option value="all" selected="@(Model.Discipline == "all")">все</option>
        </select>
    </label>
    @* Сезон выбирается чипами над списком (там же счётчики «затянуто из всего»), а не селектом —
       здесь только скрытое поле, чтобы «Найти» не сбрасывало выбранный сезон. *@
    @* Решение Влада 23.11.2026: дисциплина/категория/тип/стадия держат выбранный месяц, а поиск —
       ВСЕГДА по всем сезонам. Сезон и месяц форма шлёт как fseason/fmonth (не season/month):
       сервер (CompetitionListUrl.FormRedirect) переадресует на чистый адрес и при непустом q
       их выбрасывает. Готовые ссылки с q и season (Jobs «Что изменилось») этих имён не несут —
       их выборка прежняя. Работает и без JS. *@
    <input type="hidden" name="@Swimm.Application.Mapping.CompetitionListUrl.FormSeasonKey" value="@Model.SeasonParam" />
    <input type="hidden" name="@Swimm.Application.Mapping.CompetitionListUrl.FormMonthKey" value="@Model.Month" />
    <input type="hidden" name="state" value="@Model.State" />
    @if (!string.IsNullOrEmpty(Model.QualityFilter))
    {
        <input type="hidden" name="filter" value="@Model.QualityFilter" />
    }
    <label class="flex items-center gap-2 text-[13px] text-admin-text-muted self-center mt-3.5">
        <input type="checkbox" name="synth" value="true" checked="@Model.ShowSynthetic" class="cursor-pointer" />
        показать синтетику (SYNTH)
    </label>
    <button type="submit" class="admin-btn admin-btn-primary">Найти</button>
    @if (hasFilters)
    {
        <a href="@Url.Page("Index")" class="admin-btn admin-btn-ghost">Сброс</a>
    }
</form>

@{
    // Расшифровка чисел для title ячеек полос (затянуто / тянуть нечего / ждёт затягивания).
    // «Тянуть нечего» — строка не в базе, но сделать с ней нечего (пустой протокол, скрыта, «не опубликованы»).
    string PullHint(int imported, int nothingToPull, int total)
    {
        var pending = Math.Max(0, total - imported - nothingToPull);
        var hint = $"затянуто {imported} из {total}";
        if (nothingToPull > 0) hint += $", тянуть нечего у {nothingToPull} (пустой протокол или результаты не опубликованы)";
        hint += pending > 0 ? $", ждёт затягивания {pending}" : " — всё, что можно, затянуто";
        return hint;
    }

    // Ячейка полос сезонов и месяцев (вариант E, этап 2): подпись + число строк, полоска из трёх
    // сегментов (закрыто / долг / впереди, ширина — доля от числа строк), под ней ОДНА пометка
    // по приоритету: долг → впереди → закрыт → нет стартов. Подпись — константа, title — HtmlEncode.
    string StripCell(string href, string label, Swimm.Application.Mapping.CompetitionStateCounts st, bool active, string title)
    {
        string Seg(int n, string bg) => n > 0
            ? $"<span class=\"{bg}\" style=\"width:{(n * 100.0 / st.Total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%\"></span>"
            : "";
        var bar = st.Total > 0 ? Seg(st.Closed, "bg-admin-success") + Seg(st.Debt, "bg-admin-warning") + Seg(st.AheadTotal, "bg-admin-accent") : "";
        var note = st.Total == 0 ? "<span class=\"text-admin-text-muted\">нет стартов</span>"
            : st.Debt > 0 ? $"<span class=\"font-bold text-admin-warning\">долг {st.Debt}</span>"
            : st.AheadTotal > 0 ? $"<span class=\"text-admin-accent\">впереди {st.AheadTotal}</span>"
            : "<span class=\"text-admin-success\">закрыт</span>";
        var box = active ? "border-admin-accent bg-admin-accent/10" : "border-admin-border bg-admin-surface hover:bg-admin-surface-hover";
        // Ячейка без стартов затемнена, как прежние чипы (решение Влада 23.11.2026); выбранная — нет.
        if (st.Total == 0 && !active) box += " opacity-40";
        var enc = System.Net.WebUtility.HtmlEncode(title).Replace("\n", "&#10;");
        return $"<a href=\"{System.Net.WebUtility.HtmlEncode(href)}\" title=\"{enc}\" class=\"block min-w-0 rounded-md border px-1.5 py-1.5 no-underline {box}\">"
             + $"<span class=\"flex items-baseline justify-between gap-1 text-xs\"><span class=\"font-bold text-admin-text\">{label}</span><span class=\"tabular-nums text-admin-text-muted\">{st.Total}</span></span>"
             + $"<span class=\"mt-1 flex h-1 overflow-hidden rounded-full bg-admin-border\">{bar}</span>"
             + $"<span class=\"mt-1 block truncate text-[11px] leading-none\">{note}</span></a>";
    }
    string StatesHint(Swimm.Application.Mapping.CompetitionStateCounts st) =>
        $"закрыто {st.Closed} из {st.Total} · долг {st.Debt} (ждёт затягивания {st.ReadyToPull}, ждём протокол {st.WaitingProtocol})"
        + $" · впереди {st.AheadTotal} (из них идёт {st.Running})";
}

@* Полоса сезонов (вариант E, этап 2): ячейка на сезон, справа — «Все» (season=all) и итог выбранного
   сезона. Считается по тем же фильтрам, что список, но без сезона/месяца. *@
@{
    var allStates = Model.SeasonCounts.Aggregate(Swimm.Application.Mapping.CompetitionStateCounts.Zero,
        (acc, s) => acc + s.States);
    var selSeason = Model.SeasonCounts.FirstOrDefault(s => s.Season == Model.Season);
    var selStates = Model.Season == null ? allStates : selSeason?.States ?? Swimm.Application.Mapping.CompetitionStateCounts.Zero;
    var selName = Model.Season is int sy ? $"Сезон {(sy - 1) % 100:00}-{sy % 100:00}" : "Все сезоны";
}
<div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex gap-1.5">
        @foreach (var s in Model.SeasonCounts)
        {
            var active = Model.Season == s.Season;
            var nm = $"{(s.Season - 1) % 100:00}-{s.Season % 100:00}";
            <div class="w-[92px]">@Html.Raw(StripCell(SeasonUrl(active ? (int?)null : s.Season), nm, s.States, active,
                (active ? $"Снять фильтр по сезону ({PullHint(s.Imported, s.NothingToPull, s.Total)})" : $"Сезон {s.Season - 1}/{s.Season % 100:00}: {PullHint(s.Imported, s.NothingToPull, s.Total)}")
                + "\n" + StatesHint(s.States)))</div>
        }
        <div class="w-[92px]">@Html.Raw(StripCell(SeasonUrl(null), "Все", allStates, Model.Season == null,
            $"Все сезоны: {PullHint(Model.SeasonCounts.Sum(s => s.Imported), Model.SeasonCounts.Sum(s => s.NothingToPull), allStates.Total)}\n{StatesHint(allStates)}"))</div>
    </div>
    <div class="text-xs text-admin-text-muted">
        <span class="font-bold text-admin-text">@selName</span> ·
        закрыто <span class="font-bold text-admin-success">@selStates.Closed</span> из @selStates.Total
        @if (selStates.Debt > 0) { <text>· <span class="font-bold text-admin-warning">долг @selStates.Debt</span></text> }
        @if (selStates.AheadTotal > 0) { <text>· <span class="text-admin-accent">впереди @selStates.AheadTotal</span></text> }
    </div>
</div>

<!-- Полоса месяцев: порядок сезона сентябрь → август; под текущими фильтрами; клик по выбранному снимает -->
<div class="mb-3 grid grid-cols-12 gap-1.5">
    @foreach (var mo in Swimm.Application.Mapping.CompetitionRowStateRules.SeasonMonthOrder)
    {
        var i = mo - 1;
        var active = Model.Month == mo;
        var count = Model.MonthCounts.Count > i ? Model.MonthCounts[i] : 0;
        var imported = Model.MonthImported.Count > i ? Model.MonthImported[i] : 0;
        var nothing = Model.MonthNothingToPull.Count > i ? Model.MonthNothingToPull[i] : 0;
        var ms = Model.MonthStates.Count > i ? Model.MonthStates[i] : Swimm.Application.Mapping.CompetitionStateCounts.Zero;
        @Html.Raw(StripCell(MonthUrl(active ? (int?)null : mo), monthNamesRu[i], ms, active,
            (active ? $"Снять фильтр по месяцу ({PullHint(imported, nothing, count)})" : $"{monthNames[i]}: {PullHint(imported, nothing, count)}")
            + "\n" + StatesHint(ms)))
    }
</div>

@{
    // Пакетное затягивание (docs/plans/bulk-pull-plan.md): кандидаты — строки, которых нет
    // в БД и по которым есть что тянуть. Те же правила, что у счётчика долга на чипах:
    // скрытые (Ignored) и с пустым протоколом (EmptySourceAt) — не долг.
    // С этапа 1 «варианта E» — только состояние «ждёт затягивания»: месяц теперь виден целиком,
    // и будущие, идущие и «ждём протокол» иначе уезжали бы в пачку (хэндофф, раздел 4).
    // Число на кнопке = сколько строк реально уйдёт: сервис сам отбрасывает чемпионаты (пока
    // не отмечено «включая чемпионаты») и берёт не больше BulkPullLimits.MaxBatchSize, по дате
    // от ранней. Поэтому здесь два готовых списка с тем же отбором, а чекбокс переключает их.
    var bulkRows = Model.Result.Items
        .Where(u => u.Db == null && u.Site != null
                    && u.Status?.State == Swimm.Application.Mapping.CompetitionRowState.ReadyToPull)
        .OrderBy(u => u.Site!.DateStart)
        .ToList();
    var bulkIdsAll = bulkRows.Take(Swimm.Application.Abstractions.BulkPullLimits.MaxBatchSize)
        .Select(u => u.Site!.DiscoveredId).ToList();
    var bulkIdsNoChamp = bulkRows.Where(u => !u.IsChampionship).Take(Swimm.Application.Abstractions.BulkPullLimits.MaxBatchSize)
        .Select(u => u.Site!.DiscoveredId).ToList();

    // ── Список слева (вариант E, этап 3; хэндофф 3.4) ──────────────────────────────────────
    // Группы: «Ждут затягивания» (блоками дней) → «Ждём протокол» → «Впереди» («идёт» первыми)
    // → «Закрыто». Строки — те же Result.Items, что раньше шли в таблицу; без месяца — та же «p».
    var items = Model.Result.Items;
    // Явный sel — главнее; без него справа первая «ждёт затягивания» (AutoSelectedRow), адрес голый.
    var selRow = Model.SelectedRow ?? Model.AutoSelectedRow;
    var selKey = selRow == null ? null : Swimm.Application.Mapping.CompetitionRowKey.Of(selRow);
    var waitingRows = items.Where(u => u.Status?.State == Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol).ToList();
    var aheadRows = items
        .Where(u => u.Status?.State is Swimm.Application.Mapping.CompetitionRowState.Running or Swimm.Application.Mapping.CompetitionRowState.Ahead)
        .OrderBy(u => u.Status!.State == Swimm.Application.Mapping.CompetitionRowState.Running ? 0 : 1)
        .ThenBy(u => u.Status!.FirstDay ?? DateOnly.MaxValue)
        .ToList();
    var closedRows = items.Where(u => u.Status?.State == Swimm.Application.Mapping.CompetitionRowState.Closed).ToList();
    var readyCount = Model.ReadyToPullByDay.Sum(d => d.Rows.Count);

    // Шапка списка: «Ноябрь 2026» у месяца; без месяца — что выбрано (сезон / все сезоны / поиск).
    var monthFull = new[] { "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь" };
    string ListTitle()
    {
        var scope = Model.Season is int ys
            ? (Model.Month is int ms ? $"{monthFull[ms - 1]} {(ms >= 9 ? ys - 1 : ys)}" : $"Сезон {(ys - 1) % 100:00}-{ys % 100:00}")
            : (Model.Month is int ma ? $"{monthFull[ma - 1]} · все сезоны" : "Все сезоны");
        return string.IsNullOrWhiteSpace(Model.Search) ? scope : $"Поиск «{Model.Search!.Trim()}» · {scope}";
    }
}

@* Панель пачки: не модал — забор идёт минутами, из него надо уметь уйти и вернуться
   (batchId переживает перезагрузку страницы в sessionStorage). Этап 5 перенесёт её в правую область. *@
<div id="bulk-card" class="admin-card mb-4 hidden p-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <div class="text-sm font-semibold text-admin-text">Пакетное затягивание</div>
        <button type="button" id="bulk-close" class="cursor-pointer text-[13px] text-admin-text-muted hover:underline">Закрыть</button>
    </div>
    <div id="bulk-progress" class="mb-2 text-[13px] text-admin-text-muted"></div>
    <div id="bulk-skipped" class="mb-2 hidden text-[12.5px] text-admin-text-muted"></div>
    <div id="bulk-rows" class="mb-3 overflow-x-auto"></div>
    <div class="flex flex-wrap items-center gap-2">
        <button type="button" id="bulk-import-btn" class="admin-btn admin-btn-primary py-1 px-3" disabled>
            Импортировать отмеченные
        </button>
        <button type="button" id="bulk-uncheck-noreg" class="admin-btn admin-btn-ghost py-1 px-3">
            Снять все без регламента
        </button>
        <span class="text-[12px] text-admin-text-muted">
            Категория всем — <strong class="text-admin-text">Age 8-99</strong>;
            перезапись существующего и удаление лишнего не применяются.
        </span>
    </div>
    <div id="bulk-import-result" class="mt-2 text-[12.5px]"></div>
</div>

@{
    // Кубок чемпионата — та же иконка trophy, что в сайдбаре (_Icon). Рендерится один раз в строку:
    // в синхронной локальной функции строки <partial> (tag helper) недоступен.
    var trophyWriter = new System.IO.StringWriter();
    (await Html.PartialAsync("/Pages/Admin/Shared/_Icon.cshtml", "trophy")).WriteTo(trophyWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    var trophyHtml = trophyWriter.ToString();

    // ── Строка списка ───────────────────────────────────────────────────────────────────
    const string chip = "inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold";
    var weekdays = new[] { "вс", "пн", "вт", "ср", "чт", "пт", "сб" };
    // Без месяца в списке строки разных лет — к дате добавляется год (две цифры).
    string Yr(DateOnly d) => Model.Unpaged ? "" : $".{d.Year % 100:00}";

    // «26–28.11» у многодневного, «27.11 пт» у однодневного (хэндофф 3.4).
    string RowDate(Swimm.Application.Mapping.CompetitionRowStatus? st)
    {
        if (st?.FirstDay is not { } f) return "—";
        var l = st.LastDay ?? f;
        if (l == f) return $"{f:dd.MM}{Yr(f)} {weekdays[(int)f.DayOfWeek]}";
        return f.Month == l.Month && f.Year == l.Year
            ? $"{f:dd}–{l:dd.MM}{Yr(l)}"
            : $"{f:dd.MM}–{l:dd.MM}{Yr(l)}";
    }

    // Дата в шапке правой области — полная, с годом и «N дней назад / через N дн.».
    string PanelDate(Swimm.Application.Mapping.CompetitionRowStatus? st)
    {
        if (st?.FirstDay is not { } f) return "дата не читается";
        var l = st.LastDay ?? f;
        var date = l == f
            ? $"{weekdays[(int)f.DayOfWeek]} {f:dd.MM.yyyy}"
            : f.Year == l.Year && f.Month == l.Month ? $"{f:dd}–{l:dd.MM.yyyy}" : $"{f:dd.MM}–{l:dd.MM.yyyy}";
        var toStart = f.DayNumber - Model.Today.DayNumber;
        var sinceEnd = Model.Today.DayNumber - l.DayNumber;
        var rel = toStart > 0 ? $"через {toStart} {DaysWord(toStart)}"
            : sinceEnd > 0 ? (sinceEnd == 1 ? "вчера" : $"{sinceEnd} {DaysWord(sinceEnd)} назад")
            : "сегодня";
        return $"{date} · {rel}";
    }

    // Точка состояния: голубая — впереди/идёт, оранжевая — долг (ждём протокол приглушённо),
    // зелёная — закрыто, серая — закрыто без импорта (∅, скрыто, ✓ имп.).
    string DotCls(Swimm.Application.Mapping.CompetitionRowStatus? st) => st switch
    {
        { State: Swimm.Application.Mapping.CompetitionRowState.Ahead or Swimm.Application.Mapping.CompetitionRowState.Running } => "bg-admin-accent",
        { State: Swimm.Application.Mapping.CompetitionRowState.ReadyToPull } => "bg-admin-warning",
        { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol } => "bg-admin-warning/50",
        { NothingToPull: true } => "bg-admin-text-muted",
        _ => "bg-admin-success",
    };

    string StateText(Swimm.Application.Mapping.CompetitionRowStatus? st) => st switch
    {
        null => "",
        { State: Swimm.Application.Mapping.CompetitionRowState.Ahead } => "впереди",
        { State: Swimm.Application.Mapping.CompetitionRowState.Running, DayCount: > 1 } => $"идёт · день {st.RunningDay} из {st.DayCount}",
        { State: Swimm.Application.Mapping.CompetitionRowState.Running } => "идёт",
        { State: Swimm.Application.Mapping.CompetitionRowState.ReadyToPull } => "ждёт затягивания",
        { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol } => "ждём протокол · " + ReasonText(st.Reason),
        { NothingToPull: true } => "закрыто · тянуть нечего",
        _ => "закрыто",
    };

    string ReasonText(Swimm.Application.Mapping.WaitingProtocolReason? r) => r switch
    {
        Swimm.Application.Mapping.WaitingProtocolReason.NoProtocol => "протокола нет",
        Swimm.Application.Mapping.WaitingProtocolReason.ParseFailed => "сбой разбора",
        _ => "неполный",
    };

    string StateChipCls(Swimm.Application.Mapping.CompetitionRowStatus? st) => st switch
    {
        { State: Swimm.Application.Mapping.CompetitionRowState.Ahead or Swimm.Application.Mapping.CompetitionRowState.Running } => "bg-admin-accent/15 text-admin-accent",
        { State: Swimm.Application.Mapping.CompetitionRowState.ReadyToPull } => "bg-admin-warning/15 text-admin-warning",
        { ParseFailed: true } => "bg-admin-danger/15 text-admin-danger",
        { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol } => "bg-admin-warning/10 text-admin-warning",
        { NothingToPull: true } => "bg-white/[.08] text-admin-text-muted",
        _ => "bg-admin-success/15 text-admin-success",
    };

    int SuspectOf(Swimm.Application.Dtos.UnifiedCompetitionRowDto u) =>
        u.Db?.Single?.SuspectCount ?? u.Db?.SuspectCount ?? 0;

    // Пометки строки списка — короткие, существующими бейджами; полный текст в title.
    string RowMarksHtml(Swimm.Application.Dtos.UnifiedCompetitionRowDto u)
    {
        var st = u.Status;
        var s = u.Site;
        var sb = new System.Text.StringBuilder();
        void Add(string cls, string text, string? title = null) =>
            sb.Append($"<span class=\"{chip} {cls}\"{(title == null ? "" : $" title=\"{System.Net.WebUtility.HtmlEncode(title)}\"")}>{System.Net.WebUtility.HtmlEncode(text)}</span>");

        if (st?.State == Swimm.Application.Mapping.CompetitionRowState.Running)
            Add("bg-admin-accent/15 text-admin-accent", StateText(st));
        // У пропавшей с сайта причину «ждём протокол» не печатаем: «пропал …» объясняет больше,
        // а две пометки в колонке 360 px сжимали название до одной буквы (причина — в подсказке строки).
        if (st?.State == Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol && s?.MissingSince == null)
            Add(st.ParseFailed ? "bg-admin-danger/15 text-admin-danger"
                : st.Reason == Swimm.Application.Mapping.WaitingProtocolReason.NoProtocol ? "bg-white/[.08] text-admin-text-muted"
                : "bg-admin-warning/15 text-admin-warning",
                ReasonText(st.Reason), s?.LastError ?? s?.AutoPullBlockedReason);
        if (st?.NeedsYou == true)
            Add("bg-admin-warning/15 text-admin-warning", "ждёт тебя", "results-auto не взяла сама: " + (s?.AutoPullBlockedReason ?? "причина не записана"));
        if (s?.PreviousDateStart is { } was)
            Add("bg-admin-warning/15 text-admin-warning", $"перенесён с {was:dd.MM}", $"Федерация перенесла старт: было {was:dd.MM.yyyy}, стало {s.DateStart:dd.MM.yyyy}");
        if (s?.MissingSince is { } gone)
            Add("bg-admin-danger/15 text-admin-danger",
                st?.SuggestHide == true ? $"пропал {st.MissingDays} дн. — скрыть?" : "пропал",
                $"Старт пропал из списка isr.org.il {Swimm.Application.Constants.IsraelTime.ToLocal(gone):dd.MM.yyyy} — вероятно, отменён (день по Израилю, от него считается «пропал N дн.»)."
                + (st?.SuggestHide == true ? " Скрыть — кнопкой «✕» в панели справа; само ничего не закрывается." : ""));
        if (s?.StartList is { Stale: true } && st?.State is Swimm.Application.Mapping.CompetitionRowState.Ahead or Swimm.Application.Mapping.CompetitionRowState.Running)
            Add("bg-admin-warning/15 text-admin-warning", "обновить", "Стартовый протокол устарел: до старта мало дней, а забору больше суток");
        if (SuspectOf(u) is > 0 and var n)
            Add("bg-admin-warning/15 text-admin-warning", $"⚑ {n}", $"Помеченных недостоверными строк: {n}");
        if (s?.EmptySourceAt != null)
            Add("bg-white/[.08] text-admin-text-muted", "∅", "Протокола нет: PDF пустой — тянуть нечего");
        if (u.Stage == CompetitionStage.Ignored)
            Add("bg-white/[.08] text-admin-text-muted", "скрыто");
        return sb.ToString();
    }

    string RowName(Swimm.Application.Dtos.UnifiedCompetitionRowDto u) =>
        u.Db?.Single?.Name ?? u.Db?.EventName ?? u.Site?.Name ?? "—";

    // Ссылка строки ставит sel= (с той же страницей «p»): перезагрузка и «назад» возвращают выбор.
    // JS перехватывает клик и показывает панель без перезагрузки (pushState).
    string SelUrl(string key) => ListUrl(d => d["sel"] = key, withPage: true);
}

@* Строка списка. showDate=false — в блоке дня «ждут затягивания» (дата в шапке блока). *@
@{
    void ListRow(Swimm.Application.Dtos.UnifiedCompetitionRowDto u, bool showDate)
    {
        var key = Swimm.Application.Mapping.CompetitionRowKey.Of(u);
        var name = RowName(u);
        <a href="@SelUrl(key)" data-key="@key" data-disc-id="@(u.Site?.DiscoveredId)"
           aria-current="@(key == selKey ? "true" : null)"
           title="@name&#10;@StateText(u.Status)"
           class="comp-row flex min-w-0 items-center gap-2 border-t border-admin-border/60 px-3 py-1.5 text-[13px] text-admin-text no-underline first:border-t-0 hover:bg-admin-surface-hover aria-[current=true]:bg-admin-accent/10 aria-[current=true]:hover:bg-admin-accent/15">
            <span class="size-2 shrink-0 rounded-full @DotCls(u.Status)"></span>
            @if (showDate)
            {
                <span class="@(Model.Unpaged ? "w-[4.25rem]" : "w-[5.75rem]") shrink-0 whitespace-nowrap text-xs tabular-nums text-admin-text-muted">@RowDate(u.Status)</span>
            }
            @if (u.IsChampionship)
            {
                <span class="shrink-0 text-admin-warning" title="Чемпионат Израиля">@Html.Raw(trophyHtml)</span>
            }
            <span class="min-w-0 flex-1 truncate" dir="rtl" style="text-align:left">@name</span>
            <span class="row-marks flex shrink-0 items-center gap-1">@Html.Raw(RowMarksHtml(u))</span>
        </a>
    }

    void GroupHead(string title, int count, string countCls)
    {
        <div class="flex items-center justify-between border-t border-admin-border px-3 pb-1.5 pt-3 text-[11px] font-semibold uppercase tracking-wide text-admin-text-muted">
            <span>@title</span><span class="tabular-nums @countCls">@count</span>
        </div>
    }

    string DaysAgo(DateOnly day)
    {
        if (day == DateOnly.MinValue) return "дата не читается";
        var n = Model.Today.DayNumber - day.DayNumber;
        // Старый долг (сезон 23-24 и т.п.) — без «815 дней назад»: шапка с датой и так говорит всё.
        return n switch { 0 => "сегодня", 1 => "вчера", < 0 or > 60 => "", _ => $"{n} {DaysWord(n)} назад" };
    }
}

@{
    // Формы и Edit из панели строки: те же параметры, что у адреса, но sel — СВОЕЙ строки
    // (выбор переключается без перезагрузки, общий formRoute был бы чужим).
    Dictionary<string, string> RowRoute(string key)
    {
        var d = Model.ListRoute(withPage: true, withSelected: false);
        d["sel"] = key;
        return d;
    }
    string RowEditUrl(int id, string key) =>
        $"/Admin/Competitions/Edit?id={id}&back={Uri.EscapeDataString(SelUrl(key))}";
}

<div class="grid grid-cols-[clamp(360px,34%,420px)_minmax(0,1fr)] items-start gap-4">
    @* ── Левая колонка: список ── *@
    <section class="admin-card min-w-0 overflow-hidden p-0" aria-label="Список соревнований">
        @* Шапка месяца (рамка): заголовок + пачка. Этап 5 подставит сюда «Затянуть за месяц (N)»,
           в шапки блоков дней — «за день (N)»; пока — прежняя кнопка пачки и её чекбокс. *@
        <div class="m-3 rounded-md border border-admin-border px-3 py-2.5">
            <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
                <div class="min-w-0">
                    <div class="truncate text-base font-semibold text-admin-text" title="@ListTitle()">@ListTitle()</div>
                    <div class="text-[11px] text-admin-text-muted">
                        @Model.Result.TotalCount @(Model.Result.TotalCount % 10 == 1 && Model.Result.TotalCount % 100 != 11 ? "строка" : "строк")@(Model.Unpaged || Model.Result.TotalPages <= 1 ? "" : $" · стр. {Model.Result.Page} из {Model.Result.TotalPages}")
                    </div>
                </div>
                @if (bulkIdsAll.Count > 0)
                {
                    <div id="list-bulk" class="flex flex-col items-end gap-1">
                        <button type="button" id="bulk-pull-btn"
                                class="admin-btn admin-btn-primary py-1 px-2.5 @(bulkIdsNoChamp.Count == 0 ? "hidden" : "")"
                                data-ids="@string.Join(",", bulkIdsNoChamp)"
                                data-ids-no-champ="@string.Join(",", bulkIdsNoChamp)"
                                data-ids-all="@string.Join(",", bulkIdsAll)"
                                title="Только «ждёт затягивания» этой страницы списка; не больше @Swimm.Application.Abstractions.BulkPullLimits.MaxBatchSize за раз">
                            @* Подпись одним span: у admin-btn есть gap, и число в своём span иначе отъезжало «( 5 )». *@
                            <span>⏬ Затянуть все незатянутые (<span id="bulk-pull-count">@bulkIdsNoChamp.Count</span>)</span>
                        </button>
                        <label class="flex cursor-pointer items-center gap-1.5 text-xs text-admin-text-muted"
                               title="Чемпионаты Израиля разбираются штучно: медали, зачёт и категории у них свои">
                            <input type="checkbox" id="bulk-include-champ" class="cursor-pointer" />
                            включая чемпионаты
                        </label>
                    </div>
                }
            </div>
        </div>

        @* Переключатель состояний (?state=): числа — под всеми фильтрами, кроме самого state. *@
        @{
            var ls = Model.ListStates;
            var stateTabs = new (string? Value, string Label, int Count)[]
            {
                (null, "Все", ls.Total),
                (Swimm.Application.Mapping.CompetitionStateFilters.Waiting, "Ждут", ls.Debt),
                (Swimm.Application.Mapping.CompetitionStateFilters.Ahead, "Впереди", ls.AheadTotal),
                (Swimm.Application.Mapping.CompetitionStateFilters.Closed, "Закрыто", ls.Closed),
            };
        }
        <nav class="mx-3 mb-3 flex gap-1 rounded-md border border-admin-border p-1 text-xs" title="@StatesHint(ls)" aria-label="Фильтр по состоянию">
            @foreach (var (value, label, n) in stateTabs)
            {
                var on = Model.State == value;
                <a href="@StateUrl(value)" aria-current="@(on ? "page" : null)"
                   class="flex-1 whitespace-nowrap rounded px-2 py-1 text-center no-underline @(on ? "bg-admin-accent/15 font-semibold text-admin-accent" : "text-admin-text-muted hover:bg-admin-surface-hover hover:text-admin-text")">@label <span class="tabular-nums">@n</span></a>
            }
        </nav>

        @if (items.Count == 0)
        {
            <div class="border-t border-admin-border px-3 py-8 text-center italic text-admin-text-muted">Ничего не найдено.</div>
        }

        @if (readyCount > 0)
        {
            GroupHead("Ждут затягивания", readyCount, "text-admin-warning");
            <div class="flex flex-col gap-2 px-3 pb-3">
                @foreach (var day in Model.ReadyToPullByDay)
                {
                    <div class="overflow-hidden rounded-md border border-admin-warning/30" data-ready-day="@(day.Day == DateOnly.MinValue ? "" : day.Day.ToString("yyyy-MM-dd"))">
                        <div class="flex items-center gap-2 bg-admin-warning/10 px-3 py-1.5">
                            <span class="text-[13px] font-semibold text-admin-text">
                                @(day.Day == DateOnly.MinValue ? "Без даты" : $"{char.ToUpper(weekdays[(int)day.Day.DayOfWeek][0])}{weekdays[(int)day.Day.DayOfWeek][1..]} {day.Day:dd.MM}{Yr(day.Day)}")
                            </span>
                            <span class="text-[11px] text-admin-text-muted">@DaysAgo(day.Day)</span>
                            @* Этап 5: справа — «Затянуть за день (N)» / «чемпионат — отдельно». *@
                            <span class="day-actions ml-auto"></span>
                        </div>
                        <div>
                            @foreach (var u in day.Rows) { ListRow(u, showDate: false); }
                        </div>
                    </div>
                }
            </div>
        }

        @if (waitingRows.Count > 0)
        {
            GroupHead("Ждём протокол", waitingRows.Count, "text-admin-warning/70");
            <div class="pb-1">@foreach (var u in waitingRows) { ListRow(u, showDate: true); }</div>
        }

        @if (aheadRows.Count > 0)
        {
            GroupHead("Впереди", aheadRows.Count, "text-admin-accent");
            <div class="pb-1">@foreach (var u in aheadRows) { ListRow(u, showDate: true); }</div>
        }

        @if (closedRows.Count > 0)
        {
            GroupHead("Закрыто", closedRows.Count, "text-admin-success");
            <div class="pb-1">@foreach (var u in closedRows) { ListRow(u, showDate: true); }</div>
        }

        @if (!Model.Unpaged && Model.Result.TotalPages > 1)
        {
            <div class="border-t border-admin-border px-3">
                <partial name="/Pages/Admin/Shared/_Pagination.cshtml"
                         model='new Swimm.API.Pages.Admin.Shared.PaginationModel(Model.Result.Page, Model.Result.TotalPages,
                                    Model.Result.HasPrev ? PageUrl(Model.Result.Page - 1) : null,
                                    Model.Result.HasNext ? PageUrl(Model.Result.Page + 1) : null)' />
            </div>
        }
    </section>

    @* ── Правая колонка: выбранное соревнование. До этапа 4 здесь — прежняя панель строки
       целиком (все действия, дни события, быстрая правка, «Изменить», «Удалить»); панели
       отрисованы у всех строк страницы, видна одна (sel), JS переключает без перезагрузки.
       Этап 4 заменит содержимое чек-листом. *@
    <div id="comp-detail" data-auto-key="@(Model.AutoSelectedRow == null ? null : Swimm.Application.Mapping.CompetitionRowKey.Of(Model.AutoSelectedRow))" class="sticky top-4 max-h-[calc(100vh-2rem)] min-w-0 overflow-y-auto">
        <div id="panel-none" class="admin-card text-[13px] text-admin-text-muted @(selRow != null ? "hidden" : "")">
            @if (!string.IsNullOrEmpty(Model.Selected) && selRow == null)
            {
                <text>Выбранное соревнование (<code>@Model.Selected</code>) не видно при текущих фильтрах@(Model.Unpaged ? "" : " или на этой странице списка").</text>
            }
            else
            {
                <text>Выбери соревнование в списке слева — здесь откроются его данные и действия.</text>
            }
        </div>

        @foreach (var u in items)
        {
            var rowKey = Swimm.Application.Mapping.CompetitionRowKey.Of(u);
            var formRoute = RowRoute(rowKey);
            var head = u.Db?.Single ?? (u.Db?.Days.Count > 0 ? u.Db.Days[0] : null);
            var rowTitle = RowName(u);
            var rowResults = u.Db?.Single?.ResultCount ?? u.Db?.TotalResultCount ?? 0;
            var badge = StageBadge(u.Stage);
            var st = u.Status;
            var org = u.Db?.Single?.OrgCompId ?? u.Site?.OrgCompId ?? u.Db?.Days.Select(d => d.OrgCompId).FirstOrDefault(x => x != null);
            var pool = u.Db?.Single?.PoolType ?? u.Db?.PoolType;
            <div id="panel-@rowKey" class="row-panel admin-card p-4 @(rowKey == selKey ? "" : "hidden")" data-key="@rowKey">
                @* Шапка: название, дата, состояние; колонки прежней таблицы (стадия, ID федерации,
                   площадка/языки, бассейн, строк) — строкой под ним. *@
                <div class="mb-3 border-b border-admin-border pb-3">
                    <div class="flex items-start gap-2">
                        @if (u.IsChampionship)
                        {
                            <span class="mt-1 shrink-0 text-admin-warning" title="Чемпионат Израиля"><partial name="/Pages/Admin/Shared/_Icon.cshtml" model='"trophy"' /></span>
                        }
                        <h2 class="min-w-0 flex-1 text-base font-semibold text-white" dir="rtl" style="text-align:left">
                            @if (u.Db?.Single is { } hc)
                            {
                                <a href="@RowEditUrl(hc.Id, rowKey)" class="hover:underline" title="Изменить">@rowTitle</a>
                            }
                            else
                            {
                                @rowTitle
                            }
                        </h2>
                    </div>
                    <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-admin-text-muted">
                        <span class="tabular-nums">@PanelDate(st)</span>
                        <span class="@chip @StateChipCls(st)">@StateText(st)</span>
                        @Html.Raw(StageBadgeHtml(badge))
                        @if (u.Db is { IsEvent: true } evh)
                        {
                            <span class="@chip bg-admin-success/15 text-admin-success">@evh.DayCount @DaysWord(evh.DayCount)</span>
                        }
                        @if (u.Db is { IsEvent: true } evp0 && evp0.PartialDayCount > 0)
                        {
                            @Html.Raw(PartialBadge(
                                string.Join("\n", evp0.Days.Where(d => d.PartialResults != null).Select(d => $"День {d.DayNumber?.ToString() ?? "?"}: {d.PartialResults}")),
                                $"неполные: {evp0.PartialDayCount} {DaysWord(evp0.PartialDayCount)}"))
                        }
                        else if (u.Db?.Single is { } cp)
                        {
                            @Html.Raw(PartialBadge(cp.PartialResults))
                        }
                        @if (u.Site?.EmptySourceAt is { } emptyAt)
                        {
                            <span class="@chip bg-white/[.08] text-admin-text-muted"
                                  title="Протокола нет: PDF пустой (@emptyAt.ToLocalTime().ToString("dd.MM.yyyy"))">∅ нет протокола</span>
                        }
                        @Html.Raw(StartListBadgeHtml(u.Site))
                        @Html.Raw(DateChangeChipsHtml(u.Site))
                        @if (st?.SuggestHide == true)
                        {
                            <span class="@chip bg-admin-danger/15 text-admin-danger" title="Пропал с сайта @Swimm.Application.Mapping.CompetitionRowStateRules.MissingSuggestHideDays+ дн. назад, старт прошёл. Скрыть — «✕» ниже; само не закрывается.">пропал @st.MissingDays дн. — скрыть?</span>
                        }
                        @Html.Raw(AutoPullChipHtml(u.Site))
                        @if (rowResults > 0)
                        {
                            @Html.Raw(QualityBadge(u.Db?.Single?.QualityScannedAt ?? u.Db?.QualityScannedAt, u.Db?.Single?.SuspectCount ?? u.Db?.SuspectCount ?? 0))
                        }
                    </div>
                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-admin-text-muted">
                        <span title="ID соревнования на isr.org.il (OrgCompId)">
                            ID федерации:
                            @if (org is int oc)
                            {
                                <a href="https://isr.org.il/comp.asp?compID=@oc" target="_blank" rel="noopener" class="text-admin-accent hover:underline">@oc ↗</a>
                            }
                            else { <text>—</text> }
                        </span>
                        @if (u.Db is { IsEvent: true } evl)
                        {
                            @Html.Raw(PublicEventLink(evl.EventId))
                        }
                        else if (u.Db?.Single is { } cl)
                        {
                            @Html.Raw(PublicCompetitionLink(cl.Id))
                        }
                        <span>бассейн: <span class="text-admin-text">@(string.IsNullOrEmpty(pool) ? "—" : pool)</span></span>
                        <span>строк: <span class="tabular-nums text-admin-text">@(u.Db == null ? "—" : rowResults.ToString())</span></span>
                        @if (u.Site != null)
                        {
                            <span dir="rtl" title="Площадка и языки загруженных PDF">@(u.Site.Venue ?? "—")@Html.Raw(LangBadges(u.Site.Languages))</span>
                        }
                        @if (u.Site != null && u.Db == null && Model.SeriesFor(u.Site.Name) is { } series)
                        {
                            @* Выпуск серии турнира: при затягивании день привяжется к её части сам (§5.8). *@
                            <a href="/Admin/Series/Edit?id=@series.Id"
                               class="admin-badge border-admin-accent/30 bg-admin-accent/15 text-admin-accent"
                               title="Название содержит ключевую фразу серии — при затягивании дни привяжутся к её частям">Series: @series.Name</a>
                        }
                    </div>
                    @if (st is { PulledDays: int pd, SiteDays: int sd })
                    {
                        @* Недотянутая многодневка (решение Влада 23.11.2026): ложный долг снимает «Принять как есть» на Edit. *@
                        <div class="missing-days-note mt-1.5 text-[11px] text-admin-warning">
                            Затянуто @pd из @sd дней по сайту федерации — если остальных дней не будет, «Принять как есть» на странице «Изменить».
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(u.Site?.LastError))
                    {
                        <div class="mt-1.5 text-[11px] text-[#ef9a9a]" dir="ltr">@u.Site!.LastError</div>
                    }
                    @* Причина results-auto (П5): «ждёт тебя» читается прямо здесь, а не только в подсказке чипа. *@
                    @if (u.Site?.AutoPullVerdict == Swimm.Application.Mapping.ResultsAutoVerdicts.Blocked && !string.IsNullOrEmpty(u.Site.AutoPullBlockedReason))
                    {
                        <div class="mt-1 text-[11px] text-admin-warning" dir="auto">auto: @u.Site.AutoPullBlockedReason</div>
                    }
                    @if (u.Db is { IsEvent: true } evc)
                    {
                        <div class="mt-1.5">@await Html.PartialAsync("/Pages/Admin/Competitions/_CompCategories.cshtml", evc.Categories)</div>
                    }
                    else if (u.Db?.Single is { } cc)
                    {
                        @if (!string.IsNullOrEmpty(cc.SubName))
                        {
                            <div class="mt-1 truncate text-[11px] text-admin-text-muted" title="@cc.SubName">@cc.SubName</div>
                        }
                        <div class="mt-1.5">@await Html.PartialAsync("/Pages/Admin/Competitions/_CompCategories.cshtml", cc.Categories)</div>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    @if (head != null)
                    {
                        <a href="@RowEditUrl(head.Id, rowKey)" class="admin-btn admin-btn-ghost py-1 px-2.5">Изменить</a>
                    }
                    @if (rowResults > 0 && u.Db is { } dbq)
                    {
                        <button type="button" class="admin-btn admin-btn-primary py-1 px-2.5 quality-btn"
                                data-event-id="@(dbq.IsEvent ? dbq.EventId?.ToString() : null)"
                                data-competition-id="@(dbq.IsEvent ? null : dbq.Single?.Id.ToString())"
                                data-title="@rowTitle"
                                title="Проверить достоверность результатов">⚑ Качество</button>
                    }
                    @* Источники стартового протокола: у окружных чемпионатов их
                       несколько на один наш старт, и собрать их может только человек
                       (docs/plans/start-list-plan.md, решение от 2026-08-28). *@
                    @if (head != null)
                    {
                        <button type="button" class="admin-btn admin-btn-ghost py-1 px-2.5 sources-btn"
                                data-competition-id="@head.Id"
                                data-title="@rowTitle"
                                title="Из каких compID федерации собирается стартовый протокол">⇄ Источники</button>
                    }
                    @* Доклейка промежуточных (Д5): пишет два поля к строкам, которые
                       УЖЕ в базе, — поэтому нужна только там, где строки есть.
                       Переимпорт ради промежуточных задваивал соревнование (И-28). *@
                    @if (head != null && rowResults > 0)
                    {
                        <button type="button" class="admin-btn admin-btn-ghost py-1 px-2.5 splits-btn"
                                data-competition-id="@head.Id"
                                data-title="@rowTitle"
                                title="Скачать промежуточные с loglig и дописать их к строкам, которые уже в базе (сперва сухой прогон)">⏱ Промежуточные</button>
                    }
                    @Html.Raw(u.Site != null ? SiteActions(u.Site, imported: u.Db != null) : "")
                    @* «Удалить» уходит из списка на этапе 6 (останется только на Edit). *@
                    @if (u.Db is { IsEvent: true } evd)
                    {
                        <form method="post" asp-page-handler="DeleteEvent" asp-all-route-data="formRoute"
                              class="inline comp-delete-form" data-kind="event" data-name="@evd.EventName" data-days="@evd.DayCount" data-rows="@evd.TotalResultCount">
                            <input type="hidden" name="eventId" value="@evd.EventId" />
                            <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                        </form>
                    }
                    else if (u.Db?.Single is { } cd)
                    {
                        <form method="post" asp-page-handler="Delete" asp-all-route-data="formRoute"
                              class="inline comp-delete-form" data-kind="single" data-name="@cd.Name" data-rows="@cd.ResultCount">
                            <input type="hidden" name="id" value="@cd.Id" />
                            <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                        </form>
                    }
                </div>

                @if (head != null && rowResults > 0)
                {
                    @* Отчёт доклейки. Без «Сверки с файлом» он ЕДИНСТВЕННЫЙ контроль
                       (план, Д3) — поэтому печатается целиком, с разбивкой по дням. *@
                    <div class="splits-box mt-3 hidden rounded-md border border-admin-border bg-admin-surface/60 p-3 text-[12.5px]"
                         data-comp="@head.Id"></div>
                }

                @if (u.Db is { IsEvent: true } evp)
                {
                    <div class="mt-3 overflow-x-auto rounded-md border border-admin-border">
                        <table class="admin-table m-0">
                            <tbody>
                                @foreach (var d in evp.Days)
                                {
                                    <tr>
                                        <td class="w-32">
                                            <a href="@RowEditUrl(d.Id, rowKey)" class="text-admin-accent hover:underline">День @(d.DayNumber?.ToString() ?? "?")</a>@Html.Raw(PartialBadge(d.PartialResults))
                                            @if (!string.IsNullOrEmpty(d.SubName))
                                            {
                                                <div class="max-w-[220px] truncate text-[11px] text-admin-text-muted" title="@d.SubName">@d.SubName</div>
                                            }
                                        </td>
                                        <td class="whitespace-nowrap text-admin-text-muted">@(string.IsNullOrEmpty(d.Date) ? "—" : d.Date)</td>
                                        <td>@(string.IsNullOrEmpty(d.PoolType) ? "—" : d.PoolType)</td>
                                        <td class="text-admin-text-muted">
                                            <div class="flex flex-col gap-0.5">
                                                @if (d.OrgCompId is int doc)
                                                {
                                                    <a href="https://isr.org.il/comp.asp?compID=@doc" target="_blank" rel="noopener" class="text-admin-accent hover:underline">@doc ↗</a>
                                                }
                                                else { <span>—</span> }
                                                @Html.Raw(PublicCompetitionLink(d.Id))
                                            </div>
                                        </td>
                                        <td>@await Html.PartialAsync("/Pages/Admin/Competitions/_CompFlags.cshtml", d)</td>
                                        <td class="text-right tabular-nums">@d.ResultCount</td>
                                        <td class="col-actions text-right whitespace-nowrap">
                                            <a href="@RowEditUrl(d.Id, rowKey)" class="admin-btn admin-btn-ghost py-1 px-2.5">Изменить</a>
                                            <form method="post" asp-page-handler="Delete"
                                                  asp-all-route-data="formRoute"
                                                  class="inline comp-delete-form" data-kind="day" data-name="День @(d.DayNumber?.ToString() ?? "?")" data-rows="@d.ResultCount">
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (head != null)
                {
                    @* Быстрая правка: только поля, общие для всех дней события. Имя/дата/страна — на Edit. *@
                    <form method="post" asp-page-handler="QuickSave"
                          asp-all-route-data="formRoute"
                          class="mt-3 border-t border-admin-border pt-3">
                        <input type="hidden" name="id" value="@head.Id" />
                        @{
                            var selectedKeys = (u.Db!.IsEvent ? u.Db.Categories : head.Categories).Select(x => x.Key).ToHashSet();
                            var poolType = (u.Db.IsEvent ? u.Db.PoolType : head.PoolType) ?? "";
                        }
                        <div class="mb-2 text-xs text-admin-text-muted">
                            Категории
                            @if (u.Db.IsEvent)
                            {
                                <span class="text-admin-warning">· сохранение применится ко всем дням события (@u.Db.DayCount)</span>
                            }
                        </div>
                        <div class="flex flex-wrap gap-x-5 gap-y-2">
                            @foreach (var cat in Model.Categories)
                            {
                                <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none">
                                    <input type="checkbox" name="categoryKeys" value="@cat.Key"
                                           checked="@selectedKeys.Contains(cat.Key)" class="w-4 h-4 cursor-pointer" />
                                    <span class="text-admin-text">@(!string.IsNullOrEmpty(cat.Badge) ? cat.Badge + " " : "")@cat.Name</span>
                                </label>
                            }
                        </div>
                        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
                            <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none">
                                <input type="checkbox" name="isAward" value="true" checked="@(u.Db.IsEvent ? u.Db.IsAward : head.IsAward)" class="w-4 h-4 cursor-pointer" />
                                <span class="text-admin-text">Awards</span>
                            </label>
                            <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none">
                                <input type="checkbox" name="isChampionship" value="true" checked="@(u.Db.IsEvent ? u.Db.IsChampionship : head.IsChampionship)" class="w-4 h-4 cursor-pointer" />
                                <span class="text-admin-text">🏆 Чемпионат Израиля</span>
                            </label>
                            <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none">
                                <input type="checkbox" name="showCombineAllResults" value="true" checked="@(u.Db.IsEvent ? u.Db.ShowCombineAllResults : head.ShowCombineAllResults)" class="w-4 h-4 cursor-pointer" />
                                <span class="text-admin-text">Combine all results</span>
                            </label>
                            <label class="inline-flex items-center gap-2 text-sm cursor-pointer select-none"
                                   title="Лига, товарищеский старт — очки клубам тут никто не считает. Реестр перестаёт требовать правило очков.">
                                <input type="checkbox" name="clubPointsDisabled" value="true" checked="@(u.Db.IsEvent ? u.Db.ClubPointsDisabled : head.ClubPointsDisabled)" class="w-4 h-4 cursor-pointer" />
                                <span class="text-admin-text">Клубный зачёт не ведётся</span>
                            </label>
                        </div>
                        <div class="mt-3 flex flex-wrap items-end gap-3">
                            <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
                                Тип бассейна
                                <select name="poolType" class="admin-input">
                                    @foreach (var pt in Model.PoolTypeOptions)
                                    {
                                        <option value="@pt" selected="@(pt == poolType)">@pt</option>
                                    }
                                </select>
                            </label>
                            <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
                                Клубные очки
                                <select name="pointRuleClubsId" class="admin-input max-w-[16rem]">
                                    <option value="">Авто (по дате и типу)</option>
                                    @foreach (var r in Model.ClubRules)
                                    {
                                        <option value="@r.Id" selected="@(r.Id == head.PointRuleClubsId)">@r.Version</option>
                                    }
                                </select>
                            </label>
                            <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
                                High Point
                                <select name="pointRuleSwimmersId" class="admin-input max-w-[16rem]">
                                    <option value="">Авто (по дате и типу)</option>
                                    @foreach (var r in Model.SwimmerRules)
                                    {
                                        <option value="@r.Id" selected="@(r.Id == head.PointRuleSwimmersId)">@r.Version</option>
                                    }
                                </select>
                            </label>
                            <button type="submit" class="admin-btn admin-btn-primary">Сохранить</button>
                        </div>

                        @* Регламент (תקנון): по нему проставляются те же галочки, что выше.
                           Файл никуда не сохраняется — только читается ради подсказки. *@
                        <div class="mt-3 pt-3 border-t border-admin-border/60">
                            <div class="text-xs text-admin-text-muted mb-1.5">
                                Регламент (תקנון) — проверю медали, клубный зачёт и чемпионат, галочки поставлю сам.
                                Без файла возьму его с loglig сам; файл нужен, только если ссылки там нет.
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <input type="file" accept=".pdf" class="admin-input text-xs regulation-file" data-comp="@head.Id" />
                                <button type="button" class="admin-btn admin-btn-ghost text-xs regulation-check"
                                        data-comp="@head.Id" data-org="@((head.OrgCompId ?? u.Site?.OrgCompId)?.ToString() ?? "")">
                                    Проверить регламент
                                </button>
                            </div>
                            <div class="regulation-result text-[11px] mt-1.5" data-comp="@head.Id"></div>
                        </div>
                    </form>
                }
            </div>
        }

        <!-- Превью «затянутого» PDF перед импортом (перенос из /Admin/Discovery) -->
        <div id="preview-card" class="admin-card mt-4 hidden p-4">
            <div class="mb-2 text-sm font-semibold text-admin-text" id="preview-title"></div>
            <div id="preview-summary" class="mb-3 text-[13px] text-admin-text-muted"></div>
            <div id="preview-warnings" class="mb-3 hidden rounded-md border border-admin-danger/40 bg-admin-danger/10 p-3 text-[12.5px]"></div>
            @* Сколько рекордов побьёт файл (Б2) — подсказка перед «Применить», не запрет. *@
            <div id="preview-records" class="hidden"></div>
        
            @* Флаги соревнования: заполняются сами (регламент, название, файл, проба зачёта) и
               правятся руками. До этого их ставили ПОСЛЕ импорта, в панели строки, и забывали. *@
            <div class="mb-3 rounded-md border border-admin-border bg-admin-surface/60 p-3">
                <div class="mb-1.5 text-[13px] text-admin-text-muted">
                    Флаги соревнования — проставлены по регламенту, названию и файлу; проверьте:
                </div>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px]">
                    <label class="flex cursor-pointer items-center gap-1.5" title="Вручают медали">
                        <input type="checkbox" id="flag-award" class="cursor-pointer" /> Awards (медали)
                    </label>
                    <label class="flex cursor-pointer items-center gap-1.5" title="Чемпионат Израиля">
                        <input type="checkbox" id="flag-championship" class="cursor-pointer" /> 🏆 Чемпионат Израиля
                    </label>
                    <label class="flex cursor-pointer items-center gap-1.5" title="Мастерс">
                        <input type="checkbox" id="flag-masters" class="cursor-pointer" /> Masters
                    </label>
                    <label class="flex cursor-pointer items-center gap-1.5" title="Клубный зачёт на этом старте не ведётся">
                        <input type="checkbox" id="flag-club-off" class="cursor-pointer" /> клубный зачёт не ведётся
                    </label>
                    <label class="flex items-center gap-1.5">
                        бассейн:
                        <select id="flag-pool" class="admin-input w-auto py-0.5 px-1.5 text-[12.5px]">
                            <option value="">— не задан —</option>
                            <option value="25m">25 м</option>
                            <option value="50m">50 м</option>
                        </select>
                    </label>
                </div>
                <div id="flag-reasons" class="mt-1.5 space-y-0.5 text-[11.5px] text-admin-text-muted"></div>
            </div>
        
            <div class="mb-3">
                <div class="mb-1 text-[12px] font-semibold uppercase tracking-wide text-admin-text-muted">Категории</div>
                <div id="preview-categories" class="flex flex-wrap gap-3 text-[13px]"></div>
            </div>
        
            @* Официальный клубный зачёт (דירוג מועדונים) на loglig: есть ли он и по какой шкале.
               Кнопка зачёта есть у ВСЕХ соревнований — признак только непустая таблица, поэтому
               проверку делает сервер. Если шкала опознана, правило подставляется в селект ниже. *@
            <div class="mb-3">
                <div class="mb-1 text-[12px] font-semibold uppercase tracking-wide text-admin-text-muted">Клубные очки</div>
                <div id="preview-standing" class="mb-2 rounded-md border border-admin-border px-3 py-2 text-[13px] text-admin-text-muted">
                    Проверяю официальный зачёт…
                </div>
                <select id="preview-rule-clubs" class="admin-input w-full max-w-md rounded-md px-3 py-2 text-[13px]">
                    <option value="">Авто (по дате и типу)</option>
                    @foreach (var r in Model.ClubRules)
                    {
                        <option value="@r.Id">@r.Version@(r.ManualOnly ? " · manual" : "")</option>
                    }
                </select>
        
                @* Зачёт есть, а правила под его шкалу нет: заводим прямо отсюда, иначе цикл
                   «уйти на /Admin/PointsRules → завести → вернуться → перезатянуть». Кнопка, а не
                   галочка «создать автоматически»: шкала снята эвристикой, и админ должен увидеть,
                   что именно заводит (у גביע האביב 2026 регламент вдобавок содержал условие сверх
                   шкалы — машине его не видно). *@
                <div id="preview-rule-create" class="mt-2 hidden rounded-md border border-[rgba(255,213,79,0.4)] bg-[rgba(255,213,79,0.08)] p-3">
                    <div class="mb-2 text-[12.5px] text-admin-text">
                        Шкалы этого зачёта нет ни в одном правиле. Завести новое по снятой шкале?
                    </div>
                    <div id="preview-rule-scale" class="mb-2 font-mono text-[12px] text-admin-text-muted"></div>
                    <div class="flex flex-wrap items-center gap-2">
                        <input type="text" id="preview-rule-version" class="admin-input min-w-[220px] rounded-md px-3 py-2 text-[13px]"
                               placeholder="Версия правила" />
                        <button type="button" id="btn-create-rule" class="admin-btn admin-btn-ghost">Завести правило по этой шкале</button>
                        <span class="text-[12px] text-admin-text-muted">manual · эстафеты ×2</span>
                    </div>
                </div>
            </div>
        
            <div class="mb-3 hidden" id="overwrite-block">
                <label class="inline-flex items-center gap-2 text-[13px] text-admin-text bg-[rgba(255,213,79,0.08)] border border-[rgba(255,213,79,0.3)] rounded-md py-2 px-3 cursor-pointer">
                    <input type="checkbox" id="overwrite-existing-cb">
                    Обновить существующее соревнование <span id="overwrite-comp-name" class="text-admin-text-muted"></span> (upsert: сматченные результаты обновятся на месте, медиа сохранится)
                </label>
                <label id="delete-missing-block" class="hidden mt-2 inline-flex items-center gap-2 text-[13px] text-admin-text bg-admin-danger/5 border border-admin-danger/30 rounded-md py-2 px-3 cursor-pointer">
                    <input type="checkbox" id="delete-missing-cb">
                    Удалять результаты, которых нет в файле
                </label>
                <div id="overwrite-delete-warning" class="hidden mt-2 text-[13px] text-admin-danger border-l-[3px] border-l-admin-danger bg-admin-danger/5 rounded-md py-2 px-3"></div>
            </div>
        
            <div class="mb-4" id="event-block">
                <div class="mb-1 text-[12px] font-semibold uppercase tracking-wide text-admin-text-muted">
                    Многодневное событие (второй день того же турнира — выбери существующее)
                </div>
                <select id="event-select" class="admin-input w-full max-w-md rounded-md px-3 py-2 text-[13px]">
                    <option value="">Без события (однодневное)</option>
                    <option value="__new__">➕ Создать новое событие…</option>
                </select>
                <input type="text" id="event-name" class="admin-input mt-2 hidden w-full max-w-md rounded-md px-3 py-2 text-[13px]" placeholder="Название события" />
            </div>
        
            <div class="flex gap-3">
                <button id="btn-import" class="admin-btn admin-btn-primary cursor-pointer">Импортировать</button>
                <button id="btn-cancel-preview" class="cursor-pointer rounded-md border border-admin-border px-4 py-2 text-[13px] text-admin-text-muted">Отмена</button>
            </div>
        </div>
    </div>
</div>

@* Ход затягивания: закреплённая панель справа внизу. Раньше шаги уходили в тост, который
   гаснет через несколько секунд — а затягивание идёт минуты (скачивание PDF, парсинг,
   фоновый job), и админ терял из виду, чем всё кончилось. Панель живёт до закрытия,
   переживает перезагрузку страницы (sessionStorage) и сама показывает итог. *@
<div id="pull-panel"
     class="fixed bottom-4 right-4 z-50 hidden w-[min(24rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-4 text-admin-text shadow-xl shadow-black/50">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <h2 class="text-sm font-semibold text-white">Затягивание</h2>
            <div id="pull-name" class="mt-0.5 truncate text-[12px] text-admin-text-muted" dir="rtl" style="text-align:left"></div>
        </div>
        <button type="button" id="pull-close" class="admin-btn admin-btn-ghost py-1 px-2.5" title="Закрыть">✕</button>
    </div>
    <ol id="pull-steps" class="mt-3 space-y-1.5 text-[12.5px]"></ol>
    <div id="pull-footer" class="mt-3 hidden text-[12px] text-admin-text-muted"></div>
</div>

@* Качество результатов: список помеченных строк + прогон проверок. Пометка НЕ скрывает
   и НЕ удаляет заплыв — он остаётся в протоколе, но выпадает из детекции рекордов. *@
<dialog id="quality-modal"
        class="m-auto w-[min(56rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Качество результатов</h2>
                <div id="quality-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="quality-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>

        <p class="mt-3 text-[12px] text-admin-text-muted">
            Проверка ищет ошибки самого протокола — то, что не лечится переимпортом.
            Помеченный заплыв остаётся в результатах, но не участвует в рекордах.
            Ручные решения переживают переимпорт, автоматические пересчитываются заново.
        </p>

        <div class="mt-3 flex items-center gap-3">
            <button type="button" id="quality-scan" class="admin-btn admin-btn-primary py-1 px-3">Проверить</button>
            <span id="quality-stats" class="text-[12px] text-admin-text-muted"></span>
        </div>

        @* Ручная пометка. Нужна потому, что правила ловят не всё: ошибка протокола бывает
           медленнее рекорда и не нарушает ни одного порога — её видит только человек,
           знающий пловца (200 вольным за 1:53 при стольнике 1:05). *@
        <div class="mt-3 flex flex-wrap items-center gap-2">
            <input type="search" id="quality-search" placeholder="Пометить вручную: имя, клуб, время или дистанция"
                   class="admin-input py-1 px-2 text-[13px] w-[22rem] max-w-full" />
            <button type="button" id="quality-search-btn" class="admin-btn admin-btn-ghost py-1 px-3">Найти</button>
            <span id="quality-search-hint" class="text-[11px] text-admin-text-muted"></span>
        </div>

        <div id="quality-found" class="mt-3"></div>
        <div id="quality-body" class="mt-4 max-h-[60vh] overflow-y-auto"></div>
    </div>
</dialog>
@* Стартовый протокол (С5): забор идёт минутами, а раньше отчёт писался в «sync-info»
   в шапке страницы — прокрученному вниз пользователю казалось, что кнопка мертва.
   Модалка не закрывается сама: по ней и снимают диагностику при ошибке. *@
<dialog id="startlist-modal"
        class="m-auto w-[min(48rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Стартовый протокол</h2>
                <div id="startlist-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="startlist-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>
        <div id="startlist-status" class="mt-3 text-[13px]"></div>
        <pre id="startlist-log"
             class="mt-3 max-h-[50vh] overflow-auto whitespace-pre-wrap break-words rounded border border-admin-border bg-admin-bg p-3 text-[12px] leading-relaxed text-admin-text-muted"></pre>
        <div class="mt-3 flex items-center gap-2">
            <button type="button" id="startlist-copy" class="admin-btn admin-btn-ghost py-1 px-3">Скопировать отчёт</button>
            <span id="startlist-copy-hint" class="text-[11px] text-admin-text-muted"></span>
        </div>
    </div>
</dialog>

@* Справка о старте (Т1, docs/plans/start-list-ticket-plan.md): разминка по дням и флаг
   «чемпионат». Разминка вводится РУКАМИ из регламента — автоматического источника у неё
   нет; флаг ставит забор, здесь его можно только переопределить. *@
<dialog id="meetinfo-modal"
        class="m-auto w-[min(40rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Разминка и тип старта</h2>
                <div id="meetinfo-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="meetinfo-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>

        <div id="meetinfo-body" class="mt-4 text-[13px]"></div>

        <div class="mt-4 flex items-center gap-2">
            <button type="button" id="meetinfo-save" class="admin-btn admin-btn-primary py-1 px-3">Сохранить</button>
            <span id="meetinfo-hint" class="text-[11px] text-admin-text-muted"></span>
        </div>
        <p class="mt-3 text-[11px] leading-relaxed text-admin-text-muted">
            Время — местное, из регламента (תקנון). Витрина показывает «приезжать к» за
            30 минут до разминки, и только на чемпионате — залогиненному, отметившему
            «I'm coming». Пустое поле стирает время дня.
        </p>
    </div>
</dialog>



@* Источники стартового протокола соревнования: какие compID федерации в него входят.
   Один наш старт бывает собран из нескольких протоколов (окружные чемпионаты), поэтому
   привязка — список, а не поле. *@
<dialog id="sources-modal"
        class="m-auto w-[min(52rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Источники стартового протокола</h2>
                <div id="sources-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="sources-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>

        <p class="mt-3 text-[12px] text-admin-text-muted">
            Из каких compID федерации собирается таб «Start list». Импорт привязывает свой
            compID сам; руками добавляют остальные — например четыре окружных протокола одного
            чемпионата. Привязка ничего не тянет: после неё нажмите «Стартовый протокол»
            на строке источника во «Входящих».
        </p>

        <div id="sources-status" class="mt-3 text-[13px]"></div>
        <div id="sources-body" class="mt-3 max-h-[60vh] overflow-y-auto"></div>
    </div>
</dialog>

@section Scripts {
<script>
    // Данные из Razor — до скрипта страницы, он их читает (wwwroot/js/admin/competitions-index.js).
    // Словарь discovery-строк на странице: id → { name, languages } — чтобы действия не
    // тащили имя через onclick (проблемы экранирования иврита/кавычек).
    window.__DISC = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Result.Items.Where(u => u.Site != null)
            .GroupBy(u => u.Site!.DiscoveredId).Select(g => g.First())
            .ToDictionary(u => u.Site!.DiscoveredId.ToString(),
                u => new { name = u.Site!.Name, languages = u.Site!.Languages })));
</script>
<script src="~/js/admin/competitions-index.js" asp-append-version="true"></script>
}
