@page
@using Swimm.Application.Dtos
@model Swimm.API.Pages.Admin.Competitions.IndexModel
@{
    ViewData["Title"] = "Competitions";
    ViewData["PageSubtitle"] = "Соревнования: справочник БД + входящие isr.org.il одним списком";

    // Все ссылки списка собираются из ОДНОГО набора параметров (Model.ListRoute) — правкой поверх него.
    string ListUrl(Action<Dictionary<string, string>> change, bool withPage = false, bool withSelected = false)
    {
        var d = Model.ListRoute(withPage, withSelected);
        change(d);
        return Url.Page("Index", new Microsoft.AspNetCore.Routing.RouteValueDictionary(
            d.ToDictionary(kv => kv.Key, kv => (object?)kv.Value)))!;
    }
    void Set(Dictionary<string, string> d, string key, string? value)
    {
        if (string.IsNullOrEmpty(value)) d.Remove(key); else d[key] = value;
    }

    // ВНИМАНИЕ: параметр пагинации — «p», НЕ «page» (page зарезервирован Razor Pages, ломает переходы).
    string PageUrl(int pg) => ListUrl(d => Set(d, "p", Model.Unpaged ? null : pg.ToString()), withSelected: true);

    // Ссылка на месяц (сброс страницы на 1; повторный клик по активному — снять фильтр).
    string MonthUrl(int? m) => ListUrl(d => Set(d, "month", m?.ToString()));

    // Ссылка на сезон (чипы над месяцами; смена сезона сбрасывает месяц и страницу).
    // «Все» — явное season=all: голый адрес открыл бы текущий месяц (CompetitionListUrl.AllSeasons).
    string SeasonUrl(int? sn) => ListUrl(d =>
    {
        Set(d, "season", sn?.ToString() ?? Swimm.Application.Mapping.CompetitionListUrl.AllSeasons);
        d.Remove("month");
    });

    // Переключатель «Все / Ждут / Впереди / Закрыто» (?state=); выбор строки (sel) сбрасывается.
    string StateUrl(string? st) => ListUrl(d => Set(d, "state", st));

    var monthNames = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    var monthNamesRu = new[] { "Янв", "Фев", "Мар", "Апр", "Май", "Июн", "Июл", "Авг", "Сен", "Окт", "Ноя", "Дек" };

    // Подставленные по умолчанию сезон и месяц — не «фильтр»: «Сброс» привёл бы туда же.
    var hasFilters = !string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.CategoryKey)
        || (!Model.OpenedOnCurrentMonth && (!string.IsNullOrEmpty(Model.SeasonParam) || Model.Month != null))
        || !string.IsNullOrEmpty(Model.Stage) || !string.IsNullOrEmpty(Model.State)
        || !string.IsNullOrEmpty(Model.Kind);

    // Short — подпись для экранов уже 1920: таблица широкая (стадия, категории, площадка,
    // действия), и «импортировано» съедает колонку, из-за которой переносится всё остальное.
    (string Text, string Short, string Cls) StageBadge(CompetitionStage s) => s switch
    {
        CompetitionStage.OnSite => ("на сайте", "сайт", "bg-[rgba(79,195,247,0.15)] text-[#4fc3f7]"),
        CompetitionStage.Imported => ("импортировано", "имп", "bg-[rgba(102,187,106,0.2)] text-[#66bb6a]"),
        CompetitionStage.DbOnly => ("только в БД", "БД", "bg-white/[.08] text-admin-text-muted"),
        _ => ("скрыто", "скрыто", "bg-white/[.05] text-admin-text-muted/70"),
    };

    // Ссылка «посмотреть соревнование на сайте» — вторая строка в колонке OrgCompId.
    // Есть только у строк, которые уже в справочнике: у site-строк соревнования в БД ещё нет,
    // и вести там некуда. У многодневки ведёт на первый день — публичная страница открывает
    // событие целиком по любому его дню.
    string PublicCompetitionLink(int? competitionId) =>
        competitionId is int id
            ? $"<a href=\"{Model.PublicSiteBaseUrl}/competitions/{id}\" target=\"_blank\" rel=\"noopener\" "
              + "class=\"text-admin-accent hover:underline\">swimhub ↗</a>"
            : "";

    // Многодневное событие на сайте открывается ЦЕЛИКОМ, через ?eventId= — это контракт
    // клиента (client/src/utils/routes.ts: идентичность соревнования идёт в путь, а событие
    // остаётся фасетом вида на /results). Ссылка на первый день показывала бы один день из
    // пяти, и «swimhub ↗» у пятидневного чемпионата открывал 23 декабря вместо турнира.
    string PublicEventLink(int? eventId) =>
        eventId is int id
            ? $"<a href=\"{Model.PublicSiteBaseUrl}/results?eventId={id}\" target=\"_blank\" rel=\"noopener\" "
              + "class=\"text-admin-accent hover:underline\">swimhub ↗</a>"
            : "";

    // Бейдж стадии: короткий текст по умолчанию, полный — только на широком экране.
    // Полная подпись остаётся в title, чтобы сокращение не пришлось разгадывать.
    string StageBadgeHtml((string Text, string Short, string Cls) b) =>
        $"<span class=\"inline-block py-0.5 px-2 rounded text-xs font-semibold {b.Cls}\" title=\"{b.Text}\">" +
        $"<span class=\"min-[1920px]:hidden\">{b.Short}</span>" +
        $"<span class=\"hidden min-[1920px]:inline\">{b.Text}</span></span>";

    // Бейдж «стартовый протокол затянут» (решение Влада 18.10.2026): исход последнего забора
    // из журнала Sys_StartListPulls, правило — StartListBadgeRules. Ни разу не тянули — пусто.
    // В подсказке — последние заборы: видно, что протокол менялся (+добавились / −снялись / пересев).
    string StartListBadgeHtml(Swimm.Application.Dtos.UnifiedSiteInfo? site)
    {
        if (site?.StartList is not { } b) return "";

        static string When(DateTime utc) => utc.ToLocalTime().ToString("dd.MM HH:mm");
        var (label, cls) = b.Kind switch
        {
            Swimm.Application.Mapping.StartListBadgeKind.Ok => ($"SL {b.Last.Entries}", "bg-admin-success/15 text-admin-success"),
            Swimm.Application.Mapping.StartListBadgeKind.Partial => ("SL частично", "bg-admin-warning/15 text-admin-warning"),
            Swimm.Application.Mapping.StartListBadgeKind.Empty => ("SL пусто", "bg-white/[.08] text-admin-text-muted"),
            _ => ("SL ошибка", "bg-admin-danger/15 text-admin-danger"),
        };
        // «Пора обновить» перекрашивает в жёлтый всё, кроме ошибки — та и так красная.
        if (b.Stale && b.Kind != Swimm.Application.Mapping.StartListBadgeKind.Error)
            cls = "bg-admin-warning/15 text-admin-warning";

        var lines = new List<string>
        {
            $"Стартовый протокол: последний забор {When(b.Last.PulledAt)}, заявок {b.Last.Entries}, заплывов {b.Last.Events}",
        };
        if (b.Stale)
            lines.Add($"До старта ≤ {Swimm.Application.Mapping.StartListBadgeRules.StaleWindowDays} дн., а забору больше суток — нажми «Стартовый протокол» ещё раз");
        lines.Add("Последние заборы:");
        lines.AddRange(b.History.Select(p =>
            $"{When(p.PulledAt)} · {p.Status} · заявок {p.Entries} (+{p.Added} −{p.Removed} пересев {p.Moved})"));
        var title = System.Net.WebUtility.HtmlEncode(string.Join("\n", lines));

        var text = $"{label} · {When(b.Last.PulledAt)}" + (b.Stale ? " · обновить" : "");
        return $"<span class=\"ml-1 inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold {cls}\" title=\"{title}\">{System.Net.WebUtility.HtmlEncode(text)}</span>";
    }

    // Перенос и пропажа старта (решение Влада 22.11.2026): их ставит суточный забор «Входящих»
    // (DiscoverySyncRules), а видно их было только в календаре сайта. Перенос — дата старта
    // сдвинута федерацией (в подсказке «было → стало»); пропал — старта нет в списке isr.org.il,
    // скорее всего отменён. Оба бывают только у будущих стартов текущего сезона.
    string DateChangeChipsHtml(Swimm.Application.Dtos.UnifiedSiteInfo? site)
    {
        if (site == null) return "";
        var sb = new System.Text.StringBuilder();
        const string chip = "ml-1 inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold";
        if (site.PreviousDateStart is { } was)
        {
            var title = System.Net.WebUtility.HtmlEncode(
                $"Федерация перенесла старт: было {was:dd.MM.yyyy}, стало {site.DateStart:dd.MM.yyyy}");
            sb.Append($"<span class=\"{chip} bg-admin-warning/15 text-admin-warning\" title=\"{title}\">⇄ перенесён с {was:dd.MM}</span>");
        }
        if (site.MissingSince is { } gone)
        {
            // День пропажи — по Израилю, той же функцией, что и MissingSinceDay в правиле состояний
            // (CompetitionAdminRepository.StateInput): иначе на Azure (UTC) дата здесь и «пропал N дн.» расходились.
            var local = Swimm.Application.Constants.IsraelTime.ToLocal(gone);
            var title = System.Net.WebUtility.HtmlEncode(
                $"Старт пропал из списка isr.org.il {local:dd.MM.yyyy HH:mm} — вероятно, отменён. Появится снова — пометка снимется сама.");
            sb.Append($"<span class=\"{chip} bg-admin-danger/15 text-admin-danger\" title=\"{title}\">✕ пропал с сайта · {local:dd.MM}</span>");
        }
        return sb.ToString();
    }

    // Чип results-auto (П5, prod-auto-pull-plan §4.5): вердикт последней проверки задачи, в
    // подсказке — причина и когда смотрела. Не смотрела — пусто.
    string AutoPullChipHtml(Swimm.Application.Dtos.UnifiedSiteInfo? site)
    {
        if (site?.AutoPullVerdict is not { } verdict) return "";
        var cls = verdict switch
        {
            Swimm.Application.Mapping.ResultsAutoVerdicts.WouldTake => "bg-admin-success/15 text-admin-success",
            Swimm.Application.Mapping.ResultsAutoVerdicts.Blocked => "bg-admin-warning/15 text-admin-warning",
            Swimm.Application.Mapping.ResultsAutoVerdicts.Failed => "bg-admin-danger/15 text-admin-danger",
            _ => "bg-white/[.08] text-admin-text-muted",
        };
        var label = "auto: " + Swimm.Application.Mapping.ResultsAutoVerdicts.Label(verdict)
            + (verdict == Swimm.Application.Mapping.ResultsAutoVerdicts.WouldTake && site.AutoPullPoolType is { } pool ? $" · {pool}" : "");
        var when = site.AutoPullCheckedAt is { } at ? at.ToLocalTime().ToString("dd.MM HH:mm") : "?";
        var title = System.Net.WebUtility.HtmlEncode(
            $"results-auto (режим report — сама не импортирует), проверила {when}" +
            (site.AutoPullBlockedReason is { } r ? $"\n{r}" : ""));
        return $"<span class=\"ml-1 inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold {cls}\" title=\"{title}\">{System.Net.WebUtility.HtmlEncode(label)}</span>";
    }

}

@functions {
    static string DaysWord(int n)
    {
        var t = n % 100;
        if (t is >= 11 and <= 14) return "дней";
        return (n % 10) switch { 1 => "день", >= 2 and <= 4 => "дня", _ => "дней" };
    }

    // Состояние проверки качества у строки. Три состояния, и «не проверялось» — отдельное:
    // пустой список без отметки о прогоне читался бы как «всё чисто», хотя никто не смотрел.
    //   есть помеченные  → оранжевый бейдж с числом (работа);
    //   проверено, пусто → зелёная галочка с датой прогона;
    //   не проверялось   → ничего, чтобы не создавать ложного успокоения.
    // «Результаты неполные» (Р114): импорт нашёл непроплытые события, и их не приняли как есть.
    // Текст — в title; снять — «Принять как есть» на Edit или повторный импорт полного протокола.
    static string PartialBadge(string? note, string? label = null) => note == null ? "" :
        $"<span class=\"inline-block ml-1.5 py-0.5 px-1.5 rounded text-[10px] font-bold bg-admin-warning/15 text-admin-warning\" " +
        $"title=\"{System.Net.WebUtility.HtmlEncode(note)}\">⏳ {label ?? "неполные"}</span>";

    static string QualityBadge(DateTime? scannedAt, int suspectCount)
    {
        if (suspectCount > 0)
            return $"<span class=\"inline-block mr-1 py-0.5 px-1.5 rounded text-[10px] font-bold bg-admin-warning/15 text-admin-warning\" " +
                   $"title=\"Помеченных недостоверными строк: {suspectCount}\">⚑ {suspectCount}</span>";

        if (scannedAt is { } at)
            return $"<span class=\"inline-block mr-1 py-0.5 px-1.5 rounded text-[10px] font-bold bg-admin-success/15 text-admin-success\" " +
                   $"title=\"Проверено {at.ToLocalTime():dd.MM.yyyy HH:mm} — подозрительных строк нет\">✓</span>";

        return "";
    }

    // Бейджи языков загруженных PDF (he — синий, en — фиолетовый).
    static string LangBadges(string? languages)
    {
        if (string.IsNullOrEmpty(languages)) return "";
        return string.Join("", languages.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(l =>
            $"<span class=\"inline-block ml-1 py-0.5 px-1.5 rounded text-[10px] font-bold uppercase {(l == "he" ? "bg-[rgba(79,195,247,0.15)] text-[#4fc3f7]" : "bg-[rgba(186,104,200,0.2)] text-[#ce93d8]")}\">{l}</span>"));
    }

    // Кнопки действий Discovery для site-стороны строки (imported=true — только синхр.языки + PDF;
    // site-only — Затянуть/✓имп./синхр.языки/PDF/скрыть). Имена не через onclick (экранирование) —
    // discPreview читает имя из window.__DISC по id.
    static string SiteActions(Swimm.Application.Dtos.UnifiedSiteInfo s, bool imported)
    {
        const string api = "/api/admin/discovery";
        const string btn = "admin-btn admin-btn-ghost py-1 px-2.5";
        var finished = s.DateStart <= DateTime.UtcNow;
        var sb = new System.Text.StringBuilder();
        if (!imported && s.Status != "ignored" && finished)
        {
            sb.Append($"<button onclick=\"discPreview({s.DiscoveredId})\" class=\"{btn}\">Затянуть</button> ");
            sb.Append($"<button onclick=\"discStatus({s.DiscoveredId},'imported')\" class=\"{btn}\" title=\"Пометить импортированным вручную\">✓ имп.</button> ");
        }
        // Уже импортированное тоже нужно уметь тянуть заново: протокол на сайте правят
        // (дисквалификации, опечатки), да и наш парсер чинится — старым разбором остаются
        // испорченные строки. Открывает то же превью, но с заранее взведённой перезаписью.
        if (imported && finished)
            sb.Append($"<button onclick=\"discPreview({s.DiscoveredId}, true)\" class=\"{btn}\" title=\"Скачать протокол заново и перезаписать результаты\">Перезатянуть</button> ");
        if (finished && string.IsNullOrEmpty(s.Languages))
            sb.Append($"<button onclick=\"discSyncLangs({s.DiscoveredId}, this)\" class=\"{btn}\" title=\"Скачать HE+EN пару и дозаполнить англ. имена пловцов\">Синхр. языки</button> ");
        else if (s.Languages == "he")
            sb.Append("<span class=\"text-[11px] text-admin-text-muted\" title=\"Второй язык на loglig не найден\">только HE</span> ");
        // Loglig-id пловцам из протокола: на импорте делается само, кнопка — для тех стартов,
        // что импортированы раньше (их сотня, а привязок в базе почти нет).
        if (imported)
            sb.Append($"<button onclick=\"discStampLoglig({s.OrgCompId}, this)\" class=\"{btn}\" title=\"Проставить пловцам loglig-id по протоколу соревнования\">Loglig-id</button> ");
        // Стартовый протокол (docs/plans/start-list-plan.md, С5): нужен в первую очередь
        // будущим стартам (у прошедших уже есть результаты, но на них удобно проверять
        // забор), поэтому рисуется всем не скрытым строкам, не только imported/finished.
        if (s.Status != "ignored")
            sb.Append($"<button onclick=\"discStartList({s.DiscoveredId}, this)\" class=\"{btn}\" title=\"Затянуть стартовый протокол (программа + заявки) с loglig\">Стартовый протокол</button> ");
        // Справка о старте (Т1): время разминки руками + переопределение флага «чемпионат».
        // Из неё таб Start list считает «во сколько приезжать», и нужна она тем же будущим
        // стартам, что и кнопка выше, — поэтому стоит рядом и по тому же условию.
        if (s.Status != "ignored")
            sb.Append($"<button onclick=\"discMeetInfo({s.DiscoveredId})\" class=\"{btn}\" title=\"Разминка по дням (из регламента, руками) и флаг «чемпионат»\">Разминка</button> ");
        sb.Append($"<a href=\"{api}/{s.DiscoveredId}/pdf\" class=\"{btn}\">PDF</a> ");
        // Ручная пометка «нет протокола»: PDF на сайте бывает пустым (страница без единой
        // строки), и без пометки строка выглядит обычной «новой» — её пробуют затянуть снова.
        sb.Append(s.EmptySourceAt is null
            ? $"<button onclick=\"discEmptySource({s.DiscoveredId}, true)\" class=\"{btn}\" title=\"Протокола нет: PDF пустой\">∅ нет протокола</button> "
            : $"<button onclick=\"discEmptySource({s.DiscoveredId}, false)\" class=\"{btn}\" title=\"Снять пометку — протокол появился\">↺ протокол есть</button> ");
        if (!imported)
            sb.Append(s.Status == "ignored"
                ? $"<button onclick=\"discStatus({s.DiscoveredId},'new')\" class=\"{btn}\">вернуть</button>"
                : $"<button onclick=\"discStatus({s.DiscoveredId},'ignored')\" class=\"{btn}\" title=\"Скрыть\">✕</button>");

        // Вид спорта — селектом прямо в строке: эвристика по названию иногда промахивается,
        // и поправить её должно быть дешевле, чем разбираться, почему строка пропала.
        var sel = "text-[11px] bg-transparent border border-admin-border rounded px-1 py-0.5 ml-1";
        sb.Append($"<select onchange=\"discDiscipline({s.DiscoveredId}, this.value)\" class=\"{sel}\" title=\"Вид спорта\">");
        foreach (var (value, label) in new[] { ("swimming", "плавание"), ("artistic", "артистич."), ("other", "прочее") })
            sb.Append($"<option value=\"{value}\"{(s.Discipline == value ? " selected" : "")}>{label}</option>");
        sb.Append("</select>");
        return sb.ToString();
    }
}

<div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-4 text-[0.85rem] text-admin-text-muted leading-relaxed">
    Одно соревнование — одна строка со стадией (<b>на сайте</b> / <b>импортировано</b> /
    <b>только в БД</b> / <b>скрыто</b>). Справочник БД и входящие с
    <a class="text-admin-accent" href="https://isr.org.il/competitions.asp" target="_blank" rel="noopener">isr.org.il</a>
    объединены. Действия входящих (Проверить/Затянуть/импорт, синхр. языки, скрыть) и CRUD
    справочника (изменить/удалить/создать) — здесь же.
</div>

@if (!string.IsNullOrEmpty(Model.QualityFilter))
{
    var label = Model.QualityFilter switch
    {
        "discovery-error" => "ошибка автозабора (discovery)",
        "no-org-comp-id" => "без OrgCompId",
        "no-results" => "без результатов",
        Swimm.Application.Mapping.AutoPullFilters.Blocked => "results-auto: ждут тебя",
        Swimm.Application.Mapping.AutoPullFilters.WouldTake => "results-auto: взяла бы сама",
        _ => Model.QualityFilter
    };
    <div class="admin-card border-l-[3px] border-l-admin-warning bg-admin-warning/5 mb-4 flex items-center justify-between px-4 py-2 text-[13px]">
        <span>Активный фильтр «здоровья данных»: <strong class="text-admin-text">@label</strong></span>
        @* Снимает фильтр «здоровья» вместе со stage (алиасы ignored / discovery-new — это stage). *@
        <a href="@ListUrl(d => { d.Remove("filter"); d.Remove("stage"); })" class="admin-btn admin-btn-ghost py-1 px-2.5">сбросить ✕</a>
    </div>
}

@* Скрытые фильтром дисциплины показываем счётчиком: молча пропавшие строки читаются
   как потеря данных, а так видно и сколько их, и куда нажать. *@
@if (Model.HiddenByDiscipline > 0)
{
    <div class="mb-3 text-[12px] text-admin-text-muted">
        Скрыто фильтром дисциплины: <strong class="text-admin-text">@Model.HiddenByDiscipline</strong>
        <a class="text-admin-accent hover:underline ml-1"
           href="@ListUrl(d => d["discipline"] = "all")">показать все ↗</a>
    </div>
}

@* Фильтр results-auto (П5): те же ссылки, что в блоке дашборда; сезон и месяц сбрасываются —
   окно задачи (7 дней) короче любого из них. *@
<div class="mb-3 text-[12px] text-admin-text-muted">
    results-auto:
    <a class="text-admin-accent hover:underline ml-1" href="@Url.Page("Index", new { filter = Swimm.Application.Mapping.AutoPullFilters.Blocked })">ждут тебя</a>
    ·
    <a class="text-admin-accent hover:underline" href="@Url.Page("Index", new { filter = Swimm.Application.Mapping.AutoPullFilters.WouldTake })">взяла бы сама</a>
</div>

@{ var flash = TempData["Flash"] as string; }
