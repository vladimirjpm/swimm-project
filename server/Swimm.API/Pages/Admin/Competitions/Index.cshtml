@page
@model Swimm.API.Pages.Admin.Competitions.IndexModel
@{
    ViewData["Title"] = "Competitions";
    ViewData["PageSubtitle"] = "Справочник соревнований — эталонный CRUD";

    string PageUrl(int p) =>
        Url.Page("Index", new { q = Model.Search, cat = Model.CategoryKey, year = Model.Year, page = p })!;

    var flash = TempData["Flash"] as string;
    var hasFilters = !string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.CategoryKey) || Model.Year != null;
}

@functions {
    // Русское склонение: 1 день, 2–4 дня, 5–20 дней, 21 день, …
    static string DaysWord(int n)
    {
        var t = n % 100;
        if (t is >= 11 and <= 14) return "дней";
        return (n % 10) switch { 1 => "день", >= 2 and <= 4 => "дня", _ => "дней" };
    }
}

@if (!string.IsNullOrEmpty(flash))
{
    <script>
        document.addEventListener('DOMContentLoaded', () => toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(flash)), 3000));
    </script>
}

<!-- Search + create -->
<form method="get" class="admin-card flex flex-wrap items-end gap-3 px-4 py-3 mb-4">
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Поиск по названию
        <input name="q" value="@Model.Search" autocomplete="off"
               class="admin-input w-72" placeholder="Название или подзаголовок дня…" />
    </label>
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Категория
        <select name="cat" class="admin-input">
            <option value="">Все</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.Key" selected="@(cat.Key == Model.CategoryKey)">@(!string.IsNullOrEmpty(cat.Badge) ? cat.Badge + " " : "")@cat.Name</option>
            }
        </select>
    </label>
    <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
        Сезон
        <select name="year" class="admin-input">
            <option value="">Все</option>
            @foreach (var y in Model.Years)
            {
                <option value="@y" selected="@(y == Model.Year)">@y</option>
            }
        </select>
    </label>
    <button type="submit" class="admin-btn admin-btn-primary">Найти</button>
    @if (hasFilters)
    {
        <a href="@Url.Page("Index")" class="admin-btn admin-btn-ghost">Сброс</a>
    }
    <a href="@Url.Page("Edit")" class="admin-btn admin-btn-primary ml-auto">+ Новое соревнование</a>
</form>

<div class="mb-3 text-xs text-admin-text-muted">
    Всего: <strong class="text-admin-text">@Model.Result.TotalCount</strong>
    @if (hasFilters)
    {
        <text> · фильтры:</text>
        @if (!string.IsNullOrEmpty(Model.Search))
        {
            <text> название «@Model.Search»</text>
        }
        @if (!string.IsNullOrEmpty(Model.CategoryKey))
        {
            var selectedCat = Model.Categories.FirstOrDefault(c => c.Key == Model.CategoryKey);
            <text> · категория «@(!string.IsNullOrEmpty(selectedCat?.Badge) ? selectedCat.Badge + " " : "")@(selectedCat?.Name ?? Model.CategoryKey)»</text>
        }
        @if (Model.Year != null)
        {
            <text> · сезон @Model.Year</text>
        }
    }
</div>

@if (Model.Result.Items.Count == 0)
{
    <div class="admin-card text-center text-admin-text-muted italic py-10">
        Соревнований не найдено.
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Дата</th>
                    <th>Бассейн</th>
                    <th>Страна</th>
                    <th>OrgCompId</th>
                    <th>Флаги</th>
                    <th class="text-right">Строк</th>
                    <th class="text-right">URL</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Result.Items)
                {
                    if (row.IsEvent)
                    {
                        <!-- Заголовок многодневного события: клик по строке или шеврону разворачивает дни -->
                        <tr id="evhead-@row.EventId"
                            class="cursor-pointer hover:bg-admin-surface-hover select-none"
                            onclick="toggleEvent(@row.EventId)">
                            <td class="text-admin-text-muted">
                                <svg id="chev-@row.EventId" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     class="w-3.5 h-3.5 inline-block transition-transform text-admin-text-muted">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                </svg>
                            </td>
                            <td>
                                <span class="font-medium text-admin-text">@row.EventName</span>
                                <span class="ml-1.5 inline-block py-0.5 px-1.5 rounded text-[10px] font-semibold bg-admin-success/15 text-admin-success">
                                    @row.DayCount @DaysWord(row.DayCount)
                                </span>
                                @await Html.PartialAsync("/Pages/Admin/Competitions/_CompCategories.cshtml", row.Categories)
                            </td>
                            <td class="whitespace-nowrap text-admin-text-muted">@(string.IsNullOrEmpty(row.DateRange) ? "—" : row.DateRange)</td>
                            <td>@(string.IsNullOrEmpty(row.PoolType) ? "—" : row.PoolType)</td>
                            <td>@(string.IsNullOrEmpty(row.Country) ? "—" : row.Country)</td>
                            <td class="text-admin-text-muted">—</td>
                            <td>@await Html.PartialAsync("/Pages/Admin/Competitions/_CompFlags.cshtml", row)</td>
                            <td class="text-right tabular-nums">@row.TotalResultCount</td>
                            <td class="text-right text-admin-text-muted">—</td>
                            <td class="text-right" onclick="event.stopPropagation()">
                                <form method="post" asp-page-handler="DeleteEvent"
                                      asp-route-q="@Model.Search" asp-route-cat="@Model.CategoryKey"
                                      asp-route-year="@Model.Year" asp-route-page="@Model.Result.Page"
                                      class="inline comp-delete-form"
                                      data-kind="event" data-name="@row.EventName" data-days="@row.DayCount" data-rows="@row.TotalResultCount">
                                    <input type="hidden" name="eventId" value="@row.EventId" />
                                    <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                                </form>
                            </td>
                        </tr>
                        @foreach (var d in row.Days)
                        {
                            <tr class="event-day-@row.EventId hidden event-group">
                                <td class="text-admin-text-muted pl-6">@d.Id</td>
                                <td>
                                    <span class="text-admin-text-muted/60 mr-1">↳</span>
                                    <a href="@Url.Page("Edit", new { id = d.Id })"
                                       class="text-admin-accent hover:underline">День @(d.DayNumber?.ToString() ?? "?")</a>
                                    @if (!string.IsNullOrEmpty(d.SubName))
                                    {
                                        <div class="pl-4 text-[11px] text-admin-text-muted truncate max-w-[280px]" title="@d.SubName">@d.SubName</div>
                                    }
                                </td>
                                <td class="whitespace-nowrap text-admin-text-muted">@(string.IsNullOrEmpty(d.Date) ? "—" : d.Date)</td>
                                <td>@(string.IsNullOrEmpty(d.PoolType) ? "—" : d.PoolType)</td>
                                <td>@(string.IsNullOrEmpty(d.Country) ? "—" : d.Country)</td>
                                <td class="text-admin-text-muted">@(d.OrgCompId?.ToString() ?? "—")</td>
                                <td>@await Html.PartialAsync("/Pages/Admin/Competitions/_CompFlags.cshtml", d)</td>
                                <td class="text-right tabular-nums">@d.ResultCount</td>
                                <td class="text-right tabular-nums">@(d.ResultUrlCount > 0 ? d.ResultUrlCount.ToString() : "—")</td>
                                <td class="text-right whitespace-nowrap">
                                    <a href="@Url.Page("Edit", new { id = d.Id })"
                                       class="admin-btn admin-btn-ghost py-1 px-2.5">Изменить</a>
                                    <form method="post" asp-page-handler="Delete"
                                          asp-route-q="@Model.Search" asp-route-cat="@Model.CategoryKey"
                                          asp-route-year="@Model.Year" asp-route-page="@Model.Result.Page"
                                          class="inline comp-delete-form"
                                          data-kind="day" data-name="День @(d.DayNumber?.ToString() ?? "?")" data-rows="@d.ResultCount">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        var c = row.Single!;
                        <tr>
                            <td class="text-admin-text-muted">@c.Id</td>
                            <td>
                                <a href="@Url.Page("Edit", new { id = c.Id })"
                                   class="text-admin-accent hover:underline font-medium">@c.Name</a>
                                @if (!string.IsNullOrEmpty(c.SubName))
                                {
                                    <div class="text-[11px] text-admin-text-muted truncate max-w-[280px]" title="@c.SubName">@c.SubName</div>
                                }
                                @await Html.PartialAsync("/Pages/Admin/Competitions/_CompCategories.cshtml", c.Categories)
                            </td>
                            <td class="whitespace-nowrap text-admin-text-muted">@(string.IsNullOrEmpty(c.Date) ? "—" : c.Date)</td>
                            <td>@(string.IsNullOrEmpty(c.PoolType) ? "—" : c.PoolType)</td>
                            <td>@(string.IsNullOrEmpty(c.Country) ? "—" : c.Country)</td>
                            <td class="text-admin-text-muted">@(c.OrgCompId?.ToString() ?? "—")</td>
                            <td>@await Html.PartialAsync("/Pages/Admin/Competitions/_CompFlags.cshtml", c)</td>
                            <td class="text-right tabular-nums">@c.ResultCount</td>
                            <td class="text-right tabular-nums">@(c.ResultUrlCount > 0 ? c.ResultUrlCount.ToString() : "—")</td>
                            <td class="text-right whitespace-nowrap">
                                <a href="@Url.Page("Edit", new { id = c.Id })"
                                   class="admin-btn admin-btn-ghost py-1 px-2.5">Изменить</a>
                                <form method="post" asp-page-handler="Delete"
                                      asp-route-q="@Model.Search" asp-route-cat="@Model.CategoryKey"
                                      asp-route-year="@Model.Year" asp-route-page="@Model.Result.Page"
                                      class="inline comp-delete-form"
                                      data-kind="single" data-name="@c.Name" data-rows="@c.ResultCount">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Result.TotalPages > 1)
    {
        <div class="flex items-center gap-3 mt-4">
            @if (Model.Result.HasPrev)
            {
                <a href="@PageUrl(Model.Result.Page - 1)" class="admin-btn admin-btn-ghost">← Назад</a>
            }
            else
            {
                <span class="admin-btn admin-btn-ghost opacity-40 cursor-not-allowed">← Назад</span>
            }
            <span class="text-xs text-admin-text-muted">
                Страница @Model.Result.Page из @Model.Result.TotalPages
            </span>
            @if (Model.Result.HasNext)
            {
                <a href="@PageUrl(Model.Result.Page + 1)" class="admin-btn admin-btn-ghost">Вперёд →</a>
            }
            else
            {
                <span class="admin-btn admin-btn-ghost opacity-40 cursor-not-allowed">Вперёд →</span>
            }
        </div>
    }
}

@section Scripts {
    <script>
        // Разворачивание/сворачивание дней многодневного события.
        function toggleEvent(eventId) {
            document.querySelectorAll('.event-day-' + eventId)
                .forEach(tr => tr.classList.toggle('hidden'));
            const chev = document.getElementById('chev-' + eventId);
            if (chev) chev.classList.toggle('rotate-90');
            // Заголовок раскрытого события подсвечиваем той же зелёной группой, что и дни.
            const head = document.getElementById('evhead-' + eventId);
            if (head) head.classList.toggle('event-group');
        }

        // Подтверждение каскадного удаления (одиночное / день / всё событие).
        document.querySelectorAll('.comp-delete-form').forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                e.stopPropagation();
                const kind = form.dataset.kind;
                const name = form.dataset.name || 'соревнование';
                const rows = form.dataset.rows || '0';

                let title, message;
                if (kind === 'event') {
                    const days = form.dataset.days || '?';
                    title = 'Удалить всё событие?';
                    message = `«${name}» — будут удалены ВСЕ ${days} дн. вместе с результатами ` +
                              `(${rows} строк), эстафетами и галереями. Действие необратимо.`;
                } else if (kind === 'day') {
                    title = 'Удалить день?';
                    message = `«${name}» — будут удалены его результаты (${rows} строк). Действие необратимо.`;
                } else {
                    title = 'Удалить соревнование?';
                    message = `«${name}» — будут удалены его результаты (${rows} строк), эстафеты и галереи. ` +
                              `Действие необратимо.`;
                }

                const ok = await adminConfirm({ title, message, confirmText: 'Удалить', danger: true });
                if (ok) form.submit();
            });
        });
    </script>
}
