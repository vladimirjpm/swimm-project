@page
@using Swimm.Application.Dtos
@model Swimm.API.Pages.Admin.Competitions.IndexModel
@{
    ViewData["Title"] = "Competitions";
    // Своя шапка (хэндофф 3.1): заголовок в одной строке с поиском и кнопками — как у /Admin/Jobs.
    ViewData["OwnHeader"] = true;

    // Все ссылки списка собираются из ОДНОГО набора параметров (Model.ListRoute) — правкой поверх него.
    string ListUrl(Action<Dictionary<string, string>> change, bool withPage = false, bool withSelected = false)
    {
        var d = Model.ListRoute(withPage, withSelected);
        change(d);
        return Url.Page("Index", new Microsoft.AspNetCore.Routing.RouteValueDictionary(
            d.ToDictionary(kv => kv.Key, kv => (object?)kv.Value)))!;
    }
    void Set(Dictionary<string, string> d, string key, string? value)
    {
        if (string.IsNullOrEmpty(value)) d.Remove(key); else d[key] = value;
    }

    // ВНИМАНИЕ: параметр пагинации — «p», НЕ «page» (page зарезервирован Razor Pages, ломает переходы).
    string PageUrl(int pg) => ListUrl(d => Set(d, "p", Model.Unpaged ? null : pg.ToString()), withSelected: true);

    // Ссылка на месяц (сброс страницы на 1; повторный клик по активному — снять фильтр).
    string MonthUrl(int? m) => ListUrl(d => Set(d, "month", m?.ToString()));

    // Ссылка на сезон (чипы над месяцами; смена сезона сбрасывает месяц и страницу).
    // «Все» — явное season=all: голый адрес открыл бы текущий месяц (CompetitionListUrl.AllSeasons).
    string SeasonUrl(int? sn) => ListUrl(d =>
    {
        Set(d, "season", sn?.ToString() ?? Swimm.Application.Mapping.CompetitionListUrl.AllSeasons);
        d.Remove("month");
    });

    // Переключатель «Все / Ждут / Впереди / Закрыто» (?state=); выбор строки (sel) сбрасывается.
    string StateUrl(string? st) => ListUrl(d => Set(d, "state", st));

    var monthNames = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    var monthNamesRu = new[] { "Янв", "Фев", "Мар", "Апр", "Май", "Июн", "Июл", "Авг", "Сен", "Окт", "Ноя", "Дек" };

    // Подставленные по умолчанию сезон и месяц — не «фильтр»: «Сброс» привёл бы туда же.
    var hasFilters = !string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.CategoryKey)
        || (!Model.OpenedOnCurrentMonth && (!string.IsNullOrEmpty(Model.SeasonParam) || Model.Month != null))
        || !string.IsNullOrEmpty(Model.Stage) || !string.IsNullOrEmpty(Model.State)
        || !string.IsNullOrEmpty(Model.Kind);

    // Ссылка «посмотреть соревнование на сайте» — вторая строка в колонке OrgCompId.
    // Есть только у строк, которые уже в справочнике: у site-строк соревнования в БД ещё нет,
    // и вести там некуда. У многодневки ведёт на первый день — публичная страница открывает
    // событие целиком по любому его дню.
    string PublicCompetitionLink(int? competitionId) =>
        competitionId is int id
            ? $"<a href=\"{Model.PublicSiteBaseUrl}/competitions/{id}\" target=\"_blank\" rel=\"noopener\" "
              + "class=\"text-admin-accent hover:underline\">swimhub ↗</a>"
            : "";

    // Многодневное событие на сайте открывается ЦЕЛИКОМ, через ?eventId= — это контракт
    // клиента (client/src/utils/routes.ts: идентичность соревнования идёт в путь, а событие
    // остаётся фасетом вида на /results). Ссылка на первый день показывала бы один день из
    // пяти, и «swimhub ↗» у пятидневного чемпионата открывал 23 декабря вместо турнира.
    string PublicEventLink(int? eventId) =>
        eventId is int id
            ? $"<a href=\"{Model.PublicSiteBaseUrl}/results?eventId={id}\" target=\"_blank\" rel=\"noopener\" "
              + "class=\"text-admin-accent hover:underline\">swimhub ↗</a>"
            : "";

    // Перенос и пропажа старта (решение Влада 22.11.2026): их ставит суточный забор «Входящих»
    // (DiscoverySyncRules), а видно их было только в календаре сайта. Перенос — дата старта
    // сдвинута федерацией (в подсказке «было → стало»); пропал — старта нет в списке isr.org.il,
    // скорее всего отменён. Оба бывают только у будущих стартов текущего сезона.
    string DateChangeChipsHtml(Swimm.Application.Dtos.UnifiedSiteInfo? site)
    {
        if (site == null) return "";
        var sb = new System.Text.StringBuilder();
        const string chip = "ml-1 inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold";
        if (site.PreviousDateStart is { } was)
        {
            var title = System.Net.WebUtility.HtmlEncode(
                $"Федерация перенесла старт: было {was:dd.MM.yyyy}, стало {site.DateStart:dd.MM.yyyy}");
            sb.Append($"<span class=\"{chip} bg-admin-warning/15 text-admin-warning\" title=\"{title}\">⇄ перенесён с {was:dd.MM}</span>");
        }
        if (site.MissingSince is { } gone)
        {
            // День пропажи — по Израилю, той же функцией, что и MissingSinceDay в правиле состояний
            // (CompetitionAdminRepository.StateInput): иначе на Azure (UTC) дата здесь и «пропал N дн.» расходились.
            var local = Swimm.Application.Constants.IsraelTime.ToLocal(gone);
            var title = System.Net.WebUtility.HtmlEncode(
                $"Старт пропал из списка isr.org.il {local:dd.MM.yyyy HH:mm} — вероятно, отменён. Появится снова — пометка снимется сама.");
            sb.Append($"<span class=\"{chip} bg-admin-danger/15 text-admin-danger\" title=\"{title}\">✕ пропал с сайта · {local:dd.MM}</span>");
        }
        return sb.ToString();
    }

    // Чип results-auto (П5, prod-auto-pull-plan §4.5): вердикт последней проверки задачи, в
    // подсказке — причина и когда смотрела. Не смотрела — пусто.
    string AutoPullChipHtml(Swimm.Application.Dtos.UnifiedSiteInfo? site)
    {
        if (site?.AutoPullVerdict is not { } verdict) return "";
        var cls = verdict switch
        {
            Swimm.Application.Mapping.ResultsAutoVerdicts.WouldTake => "bg-admin-success/15 text-admin-success",
            Swimm.Application.Mapping.ResultsAutoVerdicts.Blocked => "bg-admin-warning/15 text-admin-warning",
            Swimm.Application.Mapping.ResultsAutoVerdicts.Failed => "bg-admin-danger/15 text-admin-danger",
            _ => "bg-white/[.08] text-admin-text-muted",
        };
        var label = "auto: " + Swimm.Application.Mapping.ResultsAutoVerdicts.Label(verdict)
            + (verdict == Swimm.Application.Mapping.ResultsAutoVerdicts.WouldTake && site.AutoPullPoolType is { } pool ? $" · {pool}" : "");
        var when = site.AutoPullCheckedAt is { } at ? at.ToLocalTime().ToString("dd.MM HH:mm") : "?";
        var title = System.Net.WebUtility.HtmlEncode(
            $"results-auto (режим report — сама не импортирует), проверила {when}" +
            (site.AutoPullBlockedReason is { } r ? $"\n{r}" : ""));
        return $"<span class=\"ml-1 inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold {cls}\" title=\"{title}\">{System.Net.WebUtility.HtmlEncode(label)}</span>";
    }

}

@functions {
    static string DaysWord(int n)
    {
        var t = n % 100;
        if (t is >= 11 and <= 14) return "дней";
        return (n % 10) switch { 1 => "день", >= 2 and <= 4 => "дня", _ => "дней" };
    }

    // «Результаты неполные» (Р114): импорт нашёл непроплытые события, и их не приняли как есть.
    // Текст — в title; снять — «Принять как есть» на Edit или повторный импорт полного протокола.
    static string PartialBadge(string? note, string? label = null) => note == null ? "" :
        $"<span class=\"inline-block ml-1.5 py-0.5 px-1.5 rounded text-[10px] font-bold bg-admin-warning/15 text-admin-warning\" " +
        $"title=\"{System.Net.WebUtility.HtmlEncode(note)}\">⏳ {label ?? "неполные"}</span>";

    // Бейджи языков загруженных PDF (he — синий, en — фиолетовый).
    static string LangBadges(string? languages)
    {
        if (string.IsNullOrEmpty(languages)) return "";
        return string.Join("", languages.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(l =>
            $"<span class=\"inline-block ml-1 py-0.5 px-1.5 rounded text-[10px] font-bold uppercase {(l == "he" ? "bg-[rgba(79,195,247,0.15)] text-[#4fc3f7]" : "bg-[rgba(186,104,200,0.2)] text-[#ce93d8]")}\">{l}</span>"));
    }

}

@{
    // «Фильтры» (вариант E, этап 6; хэндофф 3.1 и 5): стадия, категория, тип, дисциплина, синтетика —
    // одной кнопкой рядом с поиском, поля внутри прежние. Заданный фильтр виден на кнопке числом.
    var activeFilters = new[]
    {
        !string.IsNullOrEmpty(Model.Stage), !string.IsNullOrEmpty(Model.CategoryKey), !string.IsNullOrEmpty(Model.Kind),
        !string.IsNullOrEmpty(Model.Discipline), Model.ShowSynthetic,
    }.Count(x => x);
    var thisYear = DateTime.UtcNow.Year;
    const string popItem = "block rounded px-2.5 py-1.5 text-[13px] text-admin-text no-underline hover:bg-admin-surface-hover";
}

@* ── Шапка страницы (хэндофф 3.1): заголовок, поиск + «Фильтры», «Проверить сайт федерации»,
   «Ещё ▾» (Правила очков, Перенос результатов, Сезон на сайте), «+ Новое соревнование».
   Выпадающие — <details> с классами админки: готового выпадающего меню в админке нет. *@
<header class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
    <h1 class="mr-2 text-xl font-semibold text-white">Competitions</h1>

    @* Одна форма на поиск и фильтры: «Найти» не сбрасывает фильтры, а выбор фильтра — поиск. *@
    <form method="get" id="filters-form" class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
        @* Число ищется ещё и как номер: compID федерации или Id соревнования в базе. *@
        <input name="q" value="@Model.Search" autocomplete="off" class="admin-input w-full min-w-[14rem] max-w-[22rem] flex-1"
               placeholder="Название, ID федерации или № в базе" aria-label="Поиск"
               title="Подстрока в названии или подзаголовке; число — ещё и ID федерации (compID) или номер соревнования в базе (у события — любого дня). Поиск идёт по всем сезонам." />

        <details class="page-pop relative">
            <summary class="admin-btn list-none [&::-webkit-details-marker]:hidden @(activeFilters > 0 ? "border-admin-accent/40 text-admin-accent" : "admin-btn-ghost")"
                     title="Стадия, категория, тип, дисциплина, синтетика@(activeFilters > 0 ? $" — задано: {activeFilters}" : "")">
                Фильтры@(activeFilters > 0 ? $" · {activeFilters}" : "") ▾
            </summary>
            <div class="admin-card absolute left-0 z-30 mt-1 flex w-[22rem] flex-col gap-3 p-4 shadow-xl shadow-black/50">
                <label class="flex flex-col gap-0.5 text-xs text-admin-text-muted">
                    Стадия
                    <select name="stage" class="admin-input">
                        <option value="">Все</option>
                        <option value="OnSite" selected="@(Model.Stage == "OnSite")">на сайте</option>
                        <option value="Imported" selected="@(Model.Stage == "Imported")">импортировано</option>
                        <option value="DbOnly" selected="@(Model.Stage == "DbOnly")">только в БД</option>
                        <option value="Ignored" selected="@(Model.Stage == "Ignored")">скрыто</option>
                    </select>
                </label>
                <label class="flex flex-col gap-0.5 text-xs text-admin-text-muted">
                    Категория
                    <select name="cat" class="admin-input">
                        <option value="">Все</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Key" selected="@(cat.Key == Model.CategoryKey)">@(!string.IsNullOrEmpty(cat.Badge) ? cat.Badge + " " : "")@cat.Name</option>
                        }
                    </select>
                </label>
                <label class="flex flex-col gap-0.5 text-xs text-admin-text-muted">
                    Тип
                    <select name="kind" class="admin-input">
                        <option value="">Все</option>
                        <option value="champ" selected="@(Model.Kind == "champ")">чемпионат Израиля</option>
                    </select>
                </label>
                <label class="flex flex-col gap-0.5 text-xs text-admin-text-muted">
                    Дисциплина
                    @* Федерация проводит не только плавание: артистическое (שחייה אומנותית) во
                       входящих есть, а нам не нужно. Прячем ФИЛЬТРОМ с дефолтом, не удаляя строки —
                       понадобится, переключат на «все». *@
                    <select name="discipline" class="admin-input">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Discipline))">плавание</option>
                        <option value="artistic" selected="@(Model.Discipline == "artistic")">артистическое</option>
                        <option value="other" selected="@(Model.Discipline == "other")">прочее</option>
                        <option value="all" selected="@(Model.Discipline == "all")">все</option>
                    </select>
                </label>
                <label class="flex items-center gap-2 text-[13px] text-admin-text-muted">
                    <input type="checkbox" name="synth" value="true" checked="@Model.ShowSynthetic" class="cursor-pointer" />
                    показать синтетику (SYNTH)
                </label>
                @* Скрытые фильтром дисциплины — счётчиком: молча пропавшие строки читаются как потеря данных. *@
                @if (Model.HiddenByDiscipline > 0)
                {
                    <div class="text-[12px] text-admin-text-muted">
                        Скрыто фильтром дисциплины: <strong class="text-admin-text">@Model.HiddenByDiscipline</strong>
                        <a class="ml-1 text-admin-accent hover:underline" href="@ListUrl(d => d["discipline"] = "all")">показать все ↗</a>
                    </div>
                }
                @* «С ошибками» (решение Влада 23.11: фильтры — одной кнопкой): старты с открытой находкой
                   Health, «⚑», «неполный» или несклеенными промежуточными — CompetitionProblemRules.
                   Как поиск — по всем сезонам (сезон и месяц сбрасываются), с пагинацией. *@
                <a href="@Url.Page("Index", new { filter = Swimm.Application.Mapping.CompetitionProblemRules.Filter })"
                   class="flex items-center gap-1.5 rounded-md border px-2.5 py-1.5 text-[13px] no-underline @(Model.QualityFilter == Swimm.Application.Mapping.CompetitionProblemRules.Filter ? "border-admin-danger/40 bg-admin-danger/10 text-admin-danger" : "border-admin-border text-admin-text hover:bg-admin-surface-hover")"
                   title="Старты, у которых есть хоть одно: ошибка или предупреждение Health (по старту и его строкам, без находок по пловцу), сомнительные строки ⚑, «неполный» (Р114/Р115), промежуточные не доклеились. По всем сезонам.">
                    <span class="font-bold text-admin-danger">✕</span> С ошибками
                    <span class="ml-auto text-[11px] text-admin-text-muted">все сезоны</span>
                </a>
                @* Фильтр results-auto (П5): те же ссылки, что в блоке дашборда; сезон и месяц сбрасываются —
                   окно задачи (7 дней) короче любого из них. *@
                <div class="text-[12px] text-admin-text-muted">
                    results-auto:
                    <a class="ml-1 text-admin-accent hover:underline" href="@Url.Page("Index", new { filter = Swimm.Application.Mapping.AutoPullFilters.Blocked })">ждут тебя</a>
                    ·
                    <a class="text-admin-accent hover:underline" href="@Url.Page("Index", new { filter = Swimm.Application.Mapping.AutoPullFilters.WouldTake })">взяла бы сама</a>
                </div>
                <div class="flex items-center gap-2 border-t border-admin-border pt-3">
                    <button type="submit" class="admin-btn admin-btn-primary">Найти</button>
                    @if (hasFilters)
                    {
                        <a href="@Url.Page("Index")" class="admin-btn admin-btn-ghost">Сброс</a>
                    }
                </div>
            </div>
        </details>
        @* Скрытые фильтром дисциплины — ещё и рядом с кнопкой: без раскрытия меню их не видно. *@
        @if (Model.HiddenByDiscipline > 0)
        {
            <a class="whitespace-nowrap text-[12px] text-admin-text-muted hover:text-admin-text" href="@ListUrl(d => d["discipline"] = "all")"
               title="Скрыто фильтром дисциплины — показать все ↗">скрыто дисциплиной: @Model.HiddenByDiscipline ↗</a>
        }

        @* Решение Влада 23.11.2026: дисциплина/категория/тип/стадия держат выбранный месяц, а поиск —
           ВСЕГДА по всем сезонам. Сезон и месяц форма шлёт как fseason/fmonth (не season/month):
           сервер (CompetitionListUrl.FormRedirect) переадресует на чистый адрес и при непустом q
           их выбрасывает. Готовые ссылки с q и season (Jobs «Что изменилось») этих имён не несут —
           их выборка прежняя. Работает и без JS. *@
        <input type="hidden" name="@Swimm.Application.Mapping.CompetitionListUrl.FormSeasonKey" value="@Model.SeasonParam" />
        <input type="hidden" name="@Swimm.Application.Mapping.CompetitionListUrl.FormMonthKey" value="@Model.Month" />
        <input type="hidden" name="state" value="@Model.State" />
        @if (!string.IsNullOrEmpty(Model.QualityFilter))
        {
            <input type="hidden" name="filter" value="@Model.QualityFilter" />
        }
    </form>

    <div class="flex items-center gap-2">
        @* Бывшая «Проверить сейчас»: тот же забор текущего сезона, те же сообщения (#sync-info). *@
        <button id="btn-sync" type="button" class="admin-btn admin-btn-ghost cursor-pointer">Проверить сайт федерации</button>
        <details class="page-pop relative">
            <summary class="admin-btn admin-btn-ghost list-none [&::-webkit-details-marker]:hidden">Ещё ▾</summary>
            <div class="admin-card absolute right-0 z-30 mt-1 flex w-72 flex-col gap-0.5 p-1.5 shadow-xl shadow-black/50">
                <a href="/Admin/Competitions/AssignRules" class="@popItem">Правила очков</a>
                <a href="/Admin/Competitions/MoveResults" class="@popItem">Перенос результатов</a>
                @* «Сезон на сайте»: забрать прошлый сезон у федерации (cYear) — после забора страница
                   откроется на этом сезоне. Текущий — кнопкой «Проверить сайт федерации». *@
                <div class="mt-1 border-t border-admin-border px-2.5 pb-1 pt-2">
                    <div class="mb-1.5 text-xs text-admin-text-muted">Сезон на сайте — забрать прошлый сезон у федерации</div>
                    <div class="flex items-center gap-2">
                        <select id="sync-year" class="admin-input py-1">
                            @for (var y = thisYear; y >= 2010; y--)
                            {
                                <option value="@y">@($"{y - 1}/{y % 100:00}")</option>
                            }
                        </select>
                        <button id="btn-sync-year" type="button" class="admin-btn admin-btn-ghost py-1 px-2.5 cursor-pointer">Забрать</button>
                    </div>
                </div>
            </div>
        </details>
        <a href="/Admin/Competitions/Edit" class="admin-btn admin-btn-ghost">+ Новое соревнование</a>
    </div>
    <span id="sync-info" class="w-full text-[12.5px] text-admin-text-muted empty:hidden"></span>
</header>

@{ var flash = TempData["Flash"] as string; }
@if (!string.IsNullOrEmpty(flash))
{
    <script>
        document.addEventListener('DOMContentLoaded', () => toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(flash)), 3000));
    </script>
}

@* Жёлтая плашка фильтра «здоровья данных» (?filter=) — обязательна, над списком (хэндофф 5). *@
@if (!string.IsNullOrEmpty(Model.QualityFilter))
{
    var label = Model.QualityFilter switch
    {
        "discovery-error" => "ошибка автозабора (discovery)",
        "no-org-comp-id" => "без OrgCompId",
        "no-results" => "без результатов",
        Swimm.Application.Mapping.AutoPullFilters.Blocked => "results-auto: ждут тебя",
        Swimm.Application.Mapping.AutoPullFilters.WouldTake => "results-auto: взяла бы сама",
        Swimm.Application.Mapping.CompetitionProblemRules.Filter => "с ошибками (Health, ⚑, неполный, промежуточные) — все сезоны",
        _ => Model.QualityFilter
    };
    <div class="admin-card border-l-[3px] border-l-admin-warning bg-admin-warning/5 mb-4 flex items-center justify-between px-4 py-2 text-[13px]">
        <span>Активный фильтр «здоровья данных»: <strong class="text-admin-text">@label</strong></span>
        @* Снимает фильтр «здоровья» вместе со stage (алиасы ignored / discovery-new — это stage). *@
        <a href="@ListUrl(d => { d.Remove("filter"); d.Remove("stage"); })" class="admin-btn admin-btn-ghost py-1 px-2.5">сбросить ✕</a>
    </div>
    @* Проверки со срезом (пишут не больше 50 находок): «С ошибками» видит только записанное. *@
    @foreach (var tc in Model.TruncatedChecks)
    {
        var tcTitle = Model.CheckTitles.TryGetValue(tc.CheckId, out var tct) ? tct : tc.CheckId;
        <div class="-mt-2 mb-3 px-1 text-[12px] text-admin-warning">
            ⚠ проверка «@tcTitle» усечена: записано @tc.Shown из @tc.Total — список может быть неполным.
            <a href="/Admin/Health#check-@tc.CheckId" class="text-admin-accent hover:underline">в Health ↗</a>
        </div>
    }
}

@{
    // Расшифровка чисел для title ячеек полос (затянуто / тянуть нечего / ждёт затягивания).
    // «Тянуть нечего» — строка не в базе, но сделать с ней нечего (пустой протокол, скрыта, «не опубликованы»).
    string PullHint(int imported, int nothingToPull, int total)
    {
        var pending = Math.Max(0, total - imported - nothingToPull);
        var hint = $"затянуто {imported} из {total}";
        if (nothingToPull > 0) hint += $", тянуть нечего у {nothingToPull} (пустой протокол или результаты не опубликованы)";
        hint += pending > 0 ? $", ждёт затягивания {pending}" : " — всё, что можно, затянуто";
        return hint;
    }

    // Ячейка полос сезонов и месяцев (вариант E, этап 2): подпись + число строк, полоска из трёх
    // сегментов (закрыто / долг / впереди, ширина — доля от числа строк), под ней ОДНА пометка
    // по приоритету: долг → впереди → закрыт → нет стартов. Подпись — константа, title — HtmlEncode.
    string StripCell(string href, string label, Swimm.Application.Mapping.CompetitionStateCounts st, bool active, string title)
    {
        string Seg(int n, string bg) => n > 0
            ? $"<span class=\"{bg}\" style=\"width:{(n * 100.0 / st.Total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%\"></span>"
            : "";
        var bar = st.Total > 0 ? Seg(st.Closed, "bg-admin-success") + Seg(st.Debt, "bg-admin-warning") + Seg(st.AheadTotal, "bg-admin-accent") : "";
        var note = st.Total == 0 ? "<span class=\"text-admin-text-muted\">нет стартов</span>"
            : st.Debt > 0 ? $"<span class=\"font-bold text-admin-warning\">долг {st.Debt}</span>"
            : st.AheadTotal > 0 ? $"<span class=\"text-admin-accent\">впереди {st.AheadTotal}</span>"
            : "<span class=\"text-admin-success\">закрыт</span>";
        var box = active ? "border-admin-accent bg-admin-accent/10" : "border-admin-border bg-admin-surface hover:bg-admin-surface-hover";
        // Ячейка без стартов затемнена, как прежние чипы (решение Влада 23.11.2026); выбранная — нет.
        if (st.Total == 0 && !active) box += " opacity-40";
        var enc = System.Net.WebUtility.HtmlEncode(title).Replace("\n", "&#10;");
        return $"<a href=\"{System.Net.WebUtility.HtmlEncode(href)}\" title=\"{enc}\" class=\"block min-w-0 rounded-md border px-1.5 py-1.5 no-underline {box}\">"
             + $"<span class=\"flex items-baseline justify-between gap-1 text-xs\"><span class=\"font-bold text-admin-text\">{label}</span><span class=\"tabular-nums text-admin-text-muted\">{st.Total}</span></span>"
             + $"<span class=\"mt-1 flex h-1 overflow-hidden rounded-full bg-admin-border\">{bar}</span>"
             + $"<span class=\"mt-1 block truncate text-[11px] leading-none\">{note}</span></a>";
    }
    string StatesHint(Swimm.Application.Mapping.CompetitionStateCounts st) =>
        $"закрыто {st.Closed} из {st.Total} · долг {st.Debt} (ждёт затягивания {st.ReadyToPull}, ждём протокол {st.WaitingProtocol})"
        + $" · впереди {st.AheadTotal} (из них идёт {st.Running})";
}

@* Полоса сезонов (вариант E, этап 2): ячейка на сезон, справа — «Все» (season=all) и итог выбранного
   сезона. Считается по тем же фильтрам, что список, но без сезона/месяца. *@
@{
    var allStates = Model.SeasonCounts.Aggregate(Swimm.Application.Mapping.CompetitionStateCounts.Zero,
        (acc, s) => acc + s.States);
    var selSeason = Model.SeasonCounts.FirstOrDefault(s => s.Season == Model.Season);
    var selStates = Model.Season == null ? allStates : selSeason?.States ?? Swimm.Application.Mapping.CompetitionStateCounts.Zero;
    var selName = Model.Season is int sy ? $"Сезон {(sy - 1) % 100:00}-{sy % 100:00}" : "Все сезоны";
}
<div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex gap-1.5">
        @foreach (var s in Model.SeasonCounts)
        {
            var active = Model.Season == s.Season;
            var nm = $"{(s.Season - 1) % 100:00}-{s.Season % 100:00}";
            <div class="w-[92px]">@Html.Raw(StripCell(SeasonUrl(active ? (int?)null : s.Season), nm, s.States, active,
                (active ? $"Снять фильтр по сезону ({PullHint(s.Imported, s.NothingToPull, s.Total)})" : $"Сезон {s.Season - 1}/{s.Season % 100:00}: {PullHint(s.Imported, s.NothingToPull, s.Total)}")
                + "\n" + StatesHint(s.States)))</div>
        }
        <div class="w-[92px]">@Html.Raw(StripCell(SeasonUrl(null), "Все", allStates, Model.Season == null,
            $"Все сезоны: {PullHint(Model.SeasonCounts.Sum(s => s.Imported), Model.SeasonCounts.Sum(s => s.NothingToPull), allStates.Total)}\n{StatesHint(allStates)}"))</div>
    </div>
    <div class="text-xs text-admin-text-muted">
        <span class="font-bold text-admin-text">@selName</span> ·
        закрыто <span class="font-bold text-admin-success">@selStates.Closed</span> из @selStates.Total
        @if (selStates.Debt > 0) { <text>· <span class="font-bold text-admin-warning">долг @selStates.Debt</span></text> }
        @if (selStates.AheadTotal > 0) { <text>· <span class="text-admin-accent">впереди @selStates.AheadTotal</span></text> }
    </div>
</div>

<!-- Полоса месяцев: порядок сезона сентябрь → август; под текущими фильтрами; клик по выбранному снимает -->
<div class="mb-3 grid grid-cols-12 gap-1.5">
    @foreach (var mo in Swimm.Application.Mapping.CompetitionRowStateRules.SeasonMonthOrder)
    {
        var i = mo - 1;
        var active = Model.Month == mo;
        var count = Model.MonthCounts.Count > i ? Model.MonthCounts[i] : 0;
        var imported = Model.MonthImported.Count > i ? Model.MonthImported[i] : 0;
        var nothing = Model.MonthNothingToPull.Count > i ? Model.MonthNothingToPull[i] : 0;
        var ms = Model.MonthStates.Count > i ? Model.MonthStates[i] : Swimm.Application.Mapping.CompetitionStateCounts.Zero;
        @Html.Raw(StripCell(MonthUrl(active ? (int?)null : mo), monthNamesRu[i], ms, active,
            (active ? $"Снять фильтр по месяцу ({PullHint(imported, nothing, count)})" : $"{monthNames[i]}: {PullHint(imported, nothing, count)}")
            + "\n" + StatesHint(ms)))
    }
</div>

@{
    // Пачки «за день» / «за месяц» (вариант E, этап 5; хэндофф 4). Кто попадает в пачку и число
    // на кнопке — ОДНО правило на сервере (BulkPullSelection → Model.MonthBulk / Model.DayBulk):
    // кнопка несёт готовые id для обоих положений чекбокса «включая чемпионаты», JS только
    // выбирает один набор и отправляет его как есть. Видимые строки JS не перебирает.
    var maxBatch = Swimm.Application.Abstractions.BulkPullLimits.MaxBatchSize;
    // Разметка одной кнопки пачки. Подпись и число переключает JS по чекбоксу; без JS видно
    // положение «без чемпионатов» (чекбокс по умолчанию снят).
    Microsoft.AspNetCore.Html.IHtmlContent BulkOffer(Swimm.Application.Mapping.BulkPullOffer offer, string scope, string label, string btnCls, string? dayTitle)
    {
        var off = offer.WithoutChampionships;
        var on = offer.WithChampionships;
        string Ids(Swimm.Application.Mapping.BulkPullPick p) => string.Join(",", p.Ids);
        var title = (scope == "month"
                ? "Все «ждёт затягивания» выбранного месяца под текущими фильтрами"
                : $"Все «ждёт затягивания» дня {dayTitle} под текущими фильтрами")
            + $". Не попадают: ждём протокол, идёт, впереди, закрытые, уже в базе; чемпионаты — только с «включая чемпионаты». Не больше {maxBatch} за раз.";
        var sb = new System.Text.StringBuilder();
        sb.Append($"<span class=\"bulk-offer flex flex-col items-end gap-0.5\" data-scope=\"{scope}\" data-label=\"{label}\" data-ids=\"{Ids(off)}\" data-ids-all=\"{Ids(on)}\" data-left=\"{off.Left}\" data-left-all=\"{on.Left}\">");
        sb.Append($"<button type=\"button\" class=\"bulk-btn {btnCls} {(off.Count == 0 ? "hidden" : "")}\" title=\"{System.Net.WebUtility.HtmlEncode(title)}\">");
        sb.Append($"<span>{label} (<span class=\"bulk-n\">{off.Count}</span>)</span></button>");
        sb.Append($"<span class=\"bulk-champ-only whitespace-nowrap text-[11px] text-admin-text-muted {(offer.OnlyChampionships ? "" : "hidden")}\" title=\"Чемпионаты Израиля разбираются штучно; отметь «включая чемпионаты», чтобы взять в пачку\">чемпионат — отдельно</span>");
        sb.Append($"<span class=\"bulk-left whitespace-nowrap text-[11px] text-admin-text-muted {(off.Left > 0 ? "" : "hidden")}\" title=\"Потолок пачки — {maxBatch} строк за раз\">ещё <span class=\"bulk-left-n\">{off.Left}</span> — следующим заходом</span>");
        sb.Append("</span>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    // ── Список слева (вариант E, этап 3; хэндофф 3.4) ──────────────────────────────────────
    // Группы: «Ждут затягивания» (блоками дней) → «Ждём протокол» → «Впереди» («идёт» первыми)
    // → «Закрыто». Строки — те же Result.Items, что раньше шли в таблицу; без месяца — та же «p».
    var items = Model.Result.Items;
    // Явный sel — главнее; без него справа первая «ждёт затягивания» (AutoSelectedRow), адрес голый.
    var selRow = Model.SelectedRow ?? Model.AutoSelectedRow;
    var selKey = selRow == null ? null : Swimm.Application.Mapping.CompetitionRowKey.Of(selRow);
    var waitingRows = items.Where(u => u.Status?.State == Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol).ToList();
    var aheadRows = items
        .Where(u => u.Status?.State is Swimm.Application.Mapping.CompetitionRowState.Running or Swimm.Application.Mapping.CompetitionRowState.Ahead)
        .OrderBy(u => u.Status!.State == Swimm.Application.Mapping.CompetitionRowState.Running ? 0 : 1)
        .ThenBy(u => u.Status!.FirstDay ?? DateOnly.MaxValue)
        .ToList();
    var closedRows = items.Where(u => u.Status?.State == Swimm.Application.Mapping.CompetitionRowState.Closed).ToList();
    var readyCount = Model.ReadyToPullByDay.Sum(d => d.Rows.Count);

    // Шапка списка: «Ноябрь 2026» у месяца; без месяца — что выбрано (сезон / все сезоны / поиск).
    var monthFull = new[] { "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь" };
    string ListTitle()
    {
        var scope = Model.Season is int ys
            ? (Model.Month is int ms ? $"{monthFull[ms - 1]} {(ms >= 9 ? ys - 1 : ys)}" : $"Сезон {(ys - 1) % 100:00}-{ys % 100:00}")
            : (Model.Month is int ma ? $"{monthFull[ma - 1]} · все сезоны" : "Все сезоны");
        return string.IsNullOrWhiteSpace(Model.Search) ? scope : $"Поиск «{Model.Search!.Trim()}» · {scope}";
    }
}

@{
    // Кубок чемпионата — та же иконка trophy, что в сайдбаре (_Icon). Рендерится один раз в строку:
    // в синхронной локальной функции строки <partial> (tag helper) недоступен.
    var trophyWriter = new System.IO.StringWriter();
    (await Html.PartialAsync("/Pages/Admin/Shared/_Icon.cshtml", "trophy")).WriteTo(trophyWriter, System.Text.Encodings.Web.HtmlEncoder.Default);
    var trophyHtml = trophyWriter.ToString();

    // ── Строка списка ───────────────────────────────────────────────────────────────────
    const string chip = "inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold";
    var weekdays = new[] { "вс", "пн", "вт", "ср", "чт", "пт", "сб" };
    // Без месяца в списке строки разных лет — к дате добавляется год (две цифры).
    string Yr(DateOnly d) => Model.Unpaged ? "" : $".{d.Year % 100:00}";

    // «26–28.11» у многодневного, «27.11 пт» у однодневного (хэндофф 3.4).
    string RowDate(Swimm.Application.Mapping.CompetitionRowStatus? st)
    {
        if (st?.FirstDay is not { } f) return "—";
        var l = st.LastDay ?? f;
        if (l == f) return $"{f:dd.MM}{Yr(f)} {weekdays[(int)f.DayOfWeek]}";
        return f.Month == l.Month && f.Year == l.Year
            ? $"{f:dd}–{l:dd.MM}{Yr(l)}"
            : $"{f:dd.MM}–{l:dd.MM}{Yr(l)}";
    }

    // Дата в шапке правой области — полная, с годом и «N дней назад / через N дн.».
    string PanelDate(Swimm.Application.Mapping.CompetitionRowStatus? st)
    {
        if (st?.FirstDay is not { } f) return "дата не читается";
        var l = st.LastDay ?? f;
        var date = l == f
            ? $"{weekdays[(int)f.DayOfWeek]} {f:dd.MM.yyyy}"
            : f.Year == l.Year && f.Month == l.Month ? $"{f:dd}–{l:dd.MM.yyyy}" : $"{f:dd.MM}–{l:dd.MM.yyyy}";
        var toStart = f.DayNumber - Model.Today.DayNumber;
        var sinceEnd = Model.Today.DayNumber - l.DayNumber;
        var rel = toStart > 0 ? $"через {toStart} {DaysWord(toStart)}"
            : sinceEnd > 0 ? (sinceEnd == 1 ? "вчера" : $"{sinceEnd} {DaysWord(sinceEnd)} назад")
            : "сегодня";
        return $"{date} · {rel}";
    }

    // Точка состояния: голубая — впереди/идёт, оранжевая — долг (ждём протокол приглушённо),
    // зелёная — закрыто, серая — закрыто без импорта (∅, скрыто, ✓ имп.).
    string DotCls(Swimm.Application.Mapping.CompetitionRowStatus? st) => st switch
    {
        { State: Swimm.Application.Mapping.CompetitionRowState.Ahead or Swimm.Application.Mapping.CompetitionRowState.Running } => "bg-admin-accent",
        { State: Swimm.Application.Mapping.CompetitionRowState.ReadyToPull } => "bg-admin-warning",
        { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol } => "bg-admin-warning/50",
        { NothingToPull: true } => "bg-admin-text-muted",
        _ => "bg-admin-success",
    };

    string StateText(Swimm.Application.Mapping.CompetitionRowStatus? st) => st switch
    {
        null => "",
        { State: Swimm.Application.Mapping.CompetitionRowState.Ahead } => "впереди",
        { State: Swimm.Application.Mapping.CompetitionRowState.Running, DayCount: > 1 } => $"идёт · день {st.RunningDay} из {st.DayCount}",
        { State: Swimm.Application.Mapping.CompetitionRowState.Running } => "идёт",
        { State: Swimm.Application.Mapping.CompetitionRowState.ReadyToPull } => "ждёт затягивания",
        { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol } => "ждём протокол · " + ReasonText(st.Reason),
        { NothingToPull: true } => "закрыто · тянуть нечего",
        _ => "закрыто",
    };

    string ReasonText(Swimm.Application.Mapping.WaitingProtocolReason? r) => r switch
    {
        Swimm.Application.Mapping.WaitingProtocolReason.NoProtocol => "протокола нет",
        Swimm.Application.Mapping.WaitingProtocolReason.ParseFailed => "сбой разбора",
        _ => "неполный",
    };

    string StateChipCls(Swimm.Application.Mapping.CompetitionRowStatus? st) => st switch
    {
        { State: Swimm.Application.Mapping.CompetitionRowState.Ahead or Swimm.Application.Mapping.CompetitionRowState.Running } => "bg-admin-accent/15 text-admin-accent",
        { State: Swimm.Application.Mapping.CompetitionRowState.ReadyToPull } => "bg-admin-warning/15 text-admin-warning",
        { ParseFailed: true } => "bg-admin-danger/15 text-admin-danger",
        { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol } => "bg-admin-warning/10 text-admin-warning",
        { NothingToPull: true } => "bg-white/[.08] text-admin-text-muted",
        _ => "bg-admin-success/15 text-admin-success",
    };

    int SuspectOf(Swimm.Application.Dtos.UnifiedCompetitionRowDto u) =>
        u.Db?.Single?.SuspectCount ?? u.Db?.SuspectCount ?? 0;

    // Пометки строки списка — короткие, существующими бейджами; полный текст в title.
    string RowMarksHtml(Swimm.Application.Dtos.UnifiedCompetitionRowDto u)
    {
        var st = u.Status;
        var s = u.Site;
        var sb = new System.Text.StringBuilder();
        void Add(string cls, string text, string? title = null) =>
            sb.Append($"<span class=\"{chip} {cls}\"{(title == null ? "" : $" title=\"{System.Net.WebUtility.HtmlEncode(title)}\"")}>{System.Net.WebUtility.HtmlEncode(text)}</span>");

        if (st?.State == Swimm.Application.Mapping.CompetitionRowState.Running)
            Add("bg-admin-accent/15 text-admin-accent", StateText(st));
        // У пропавшей с сайта причину «ждём протокол» не печатаем: «пропал …» объясняет больше,
        // а две пометки в колонке 360 px сжимали название до одной буквы (причина — в подсказке строки).
        if (st?.State == Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol && s?.MissingSince == null)
            Add(st.ParseFailed ? "bg-admin-danger/15 text-admin-danger"
                : st.Reason == Swimm.Application.Mapping.WaitingProtocolReason.NoProtocol ? "bg-white/[.08] text-admin-text-muted"
                : "bg-admin-warning/15 text-admin-warning",
                ReasonText(st.Reason), s?.LastError ?? s?.AutoPullBlockedReason);
        if (st?.NeedsYou == true)
            Add("bg-admin-warning/15 text-admin-warning", "ждёт тебя", "results-auto не взяла сама: " + (s?.AutoPullBlockedReason ?? "причина не записана"));
        if (s?.PreviousDateStart is { } was)
            Add("bg-admin-warning/15 text-admin-warning", $"перенесён с {was:dd.MM}", $"Федерация перенесла старт: было {was:dd.MM.yyyy}, стало {s.DateStart:dd.MM.yyyy}");
        if (s?.MissingSince is { } gone)
            Add("bg-admin-danger/15 text-admin-danger",
                st?.SuggestHide == true ? $"пропал {st.MissingDays} дн. — скрыть?" : "пропал",
                $"Старт пропал из списка isr.org.il {Swimm.Application.Constants.IsraelTime.ToLocal(gone):dd.MM.yyyy} — вероятно, отменён (день по Израилю, от него считается «пропал N дн.»)."
                + (st?.SuggestHide == true ? " Скрыть — кнопкой «Скрыть» в шапке панели справа; само ничего не закрывается." : ""));
        if (s?.StartList is { Stale: true } && st?.State is Swimm.Application.Mapping.CompetitionRowState.Ahead or Swimm.Application.Mapping.CompetitionRowState.Running)
            Add("bg-admin-warning/15 text-admin-warning", "обновить", "Стартовый протокол устарел: до старта мало дней, а забору больше суток");
        // Открытые находки Health по старту, его строкам, эстафетам и событию (без находок по пловцу) —
        // CompetitionProblemRules. Только записанные находки: проверки со срезом пишут не все.
        var (healthErr, healthWarn) = Swimm.Application.Mapping.CompetitionProblemRules.Totals(u.Health);
        if (healthErr > 0)
            Add("bg-admin-danger/15 text-admin-danger", $"✕ {healthErr}", "Открытые ошибки Health (по записанным находкам):\n"
                + Swimm.Application.Mapping.CompetitionProblemRules.Hint(u.Health, Swimm.Application.Mapping.CompetitionProblemRules.ErrorSeverity, Model.CheckTitles));
        if (healthWarn > 0)
            Add("bg-admin-warning/15 text-admin-warning", $"⚠ {healthWarn}", "Открытые предупреждения Health (по записанным находкам):\n"
                + Swimm.Application.Mapping.CompetitionProblemRules.Hint(u.Health, Swimm.Application.Mapping.CompetitionProblemRules.WarningSeverity, Model.CheckTitles));
        if (SuspectOf(u) is > 0 and var n)
            Add("bg-admin-warning/15 text-admin-warning", $"⚑ {n}", $"Помеченных недостоверными строк: {n}");
        // Причины «С ошибками», у которых своей пометки нет: «неполный» вне «ждём протокол · неполный»
        // (Р114 у идущего старта) и несклеенные промежуточные — иначе строка в фильтре без метки.
        var problem = Swimm.Application.Mapping.CompetitionProblemRules.From(u);
        var incompleteShown = st is { State: Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol, Reason: Swimm.Application.Mapping.WaitingProtocolReason.Incomplete }
            && s?.MissingSince == null;
        if (problem.Incomplete && !incompleteShown)
            Add("bg-admin-warning/15 text-admin-warning", "⏳", "Результаты неполные (Р114/Р115) — подробности в карточке, «Принять как есть» на «Изменить»");
        if (problem.SplitsNeedRetry)
            Add("bg-admin-warning/15 text-admin-warning", "⏱", "Промежуточные не доклеились — повторите кнопкой «Промежуточные» (шаг 9 в карточке)");
        if (s?.EmptySourceAt != null)
            Add("bg-white/[.08] text-admin-text-muted", "∅", "Протокола нет: PDF пустой или в нём одни неявки (NS) — тянуть нечего");
        if (u.Stage == CompetitionStage.Ignored)
            Add("bg-white/[.08] text-admin-text-muted", "скрыто");
        return sb.ToString();
    }

    string RowName(Swimm.Application.Dtos.UnifiedCompetitionRowDto u) =>
        u.Db?.Single?.Name ?? u.Db?.EventName ?? u.Site?.Name ?? "—";

    // Ссылка строки ставит sel= (с той же страницей «p»): перезагрузка и «назад» возвращают выбор.
    // JS перехватывает клик и показывает панель без перезагрузки (pushState).
    string SelUrl(string key) => ListUrl(d => d["sel"] = key, withPage: true);
}

@* Строка списка. showDate=false — в блоке дня «ждут затягивания» (дата в шапке блока). *@
@{
    void ListRow(Swimm.Application.Dtos.UnifiedCompetitionRowDto u, bool showDate)
    {
        var key = Swimm.Application.Mapping.CompetitionRowKey.Of(u);
        var name = RowName(u);
        <a href="@SelUrl(key)" data-key="@key" data-disc-id="@(u.Site?.DiscoveredId)"
           aria-current="@(key == selKey ? "true" : null)"
           title="@name&#10;@StateText(u.Status)"
           class="comp-row flex min-w-0 items-center gap-2 border-t border-admin-border/60 px-3 py-1.5 text-[13px] text-admin-text no-underline first:border-t-0 hover:bg-admin-surface-hover aria-[current=true]:bg-admin-accent/10 aria-[current=true]:hover:bg-admin-accent/15">
            <span class="size-2 shrink-0 rounded-full @DotCls(u.Status)"></span>
            @if (showDate)
            {
                <span class="@(Model.Unpaged ? "w-[4.25rem]" : "w-[5.75rem]") shrink-0 whitespace-nowrap text-xs tabular-nums text-admin-text-muted">@RowDate(u.Status)</span>
            }
            @if (u.IsChampionship)
            {
                <span class="shrink-0 text-admin-warning" title="Чемпионат Израиля">@Html.Raw(trophyHtml)</span>
            }
            <span class="min-w-0 flex-1 truncate" dir="rtl" style="text-align:left">@name</span>
            <span class="row-marks flex shrink-0 items-center gap-1">@Html.Raw(RowMarksHtml(u))</span>
        </a>
    }

    void GroupHead(string title, int count, string countCls)
    {
        <div class="flex items-center justify-between border-t border-admin-border px-3 pb-1.5 pt-3 text-[11px] font-semibold uppercase tracking-wide text-admin-text-muted">
            <span>@title</span><span class="tabular-nums @countCls">@count</span>
        </div>
    }

    string DaysAgo(DateOnly day)
    {
        if (day == DateOnly.MinValue) return "дата не читается";
        var n = Model.Today.DayNumber - day.DayNumber;
        // Старый долг (сезон 23-24 и т.п.) — без «815 дней назад»: шапка с датой и так говорит всё.
        return n switch { 0 => "сегодня", 1 => "вчера", < 0 or > 60 => "", _ => $"{n} {DaysWord(n)} назад" };
    }
}

@{
    // Формы и Edit из панели строки: те же параметры, что у адреса, но sel — СВОЕЙ строки
    // (выбор переключается без перезагрузки, общий formRoute был бы чужим).
    Dictionary<string, string> RowRoute(string key)
    {
        var d = Model.ListRoute(withPage: true, withSelected: false);
        d["sel"] = key;
        return d;
    }
    string RowEditUrl(int id, string key) =>
        $"/Admin/Competitions/Edit?id={id}&back={Uri.EscapeDataString(SelUrl(key))}";

    // ── Правая панель-чек-лист (вариант E, этапы 4 и 6; хэндофф 3.5) ────────────────────────
    // С этапа 6 — у строк ВСЕХ состояний. Прежней панели строки больше нет.

    (string Text, string? Title) StartListCaption(Swimm.Application.Dtos.UnifiedSiteInfo s)
    {
        if (s.StartList is not { } b) return ("не забирали", "Стартовый протокол с loglig ещё не затягивали");
        var at = b.Last.PulledAt.ToLocalTime().ToString("dd.MM");
        var text = b.Kind switch
        {
            Swimm.Application.Mapping.StartListBadgeKind.Ok => $"забран {at} · заявок {b.Last.Entries}",
            Swimm.Application.Mapping.StartListBadgeKind.Partial => $"забран частично {at} · заявок {b.Last.Entries}",
            Swimm.Application.Mapping.StartListBadgeKind.Empty => $"забирали {at} — пусто (посева на loglig нет)",
            _ => $"забор {at} сорвался",
        };
        // «Пора обновить» (бывший жёлтый SL-бейдж): до старта мало дней, а забору больше суток.
        if (b.Stale) text += " · обновить";
        var title = (b.Stale ? $"До старта ≤ {Swimm.Application.Mapping.StartListBadgeRules.StaleWindowDays} дн., а забору больше суток — нажми «Обновить»\n" : "")
            + "Последние заборы:\n" + string.Join("\n", b.History.Select(p =>
            $"{p.PulledAt.ToLocalTime():dd.MM HH:mm} · {p.Status} · заявок {p.Entries} (+{p.Added} −{p.Removed} пересев {p.Moved})"));
        return (text, title);
    }

    string Plural(int n, string one, string few, string many)
    {
        var t = n % 100;
        if (t is >= 11 and <= 14) return many;
        return (n % 10) switch { 1 => one, >= 2 and <= 4 => few, _ => many };
    }

    // «День 1 · 28.07» — дата дня хранится текстом «дд/ММ/гггг».
    string DayLabel(Swimm.Application.Dtos.CompetitionListItemDto d, int index)
    {
        var no = d.DayNumber ?? index + 1;
        return DateTime.TryParseExact(d.Date, "dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var dt)
            ? $"День {no} · {dt:dd.MM}"
            : $"День {no}";
    }

    async Task<Swimm.API.Pages.Admin.Competitions.CompChecklistView> ChecklistView(Swimm.Application.Dtos.UnifiedCompetitionRowDto u, string key)
    {
        var s = u.Site;
        var db = u.Db;
        var st = u.Status ?? new Swimm.Application.Mapping.CompetitionRowStatus(Swimm.Application.Mapping.CompetitionRowState.Closed);
        var head = db?.Single ?? (db?.Days.Count > 0 ? db.Days[0] : null);
        var days = st.FirstDay is { } f && st.LastDay is { } l ? l.DayNumber - f.DayNumber + 1 : 1;
        var hidden = s?.Status == "ignored" && db == null;
        var markedImported = s?.Status == "imported" && db == null;
        // Шаг 5 у недотянутой — с датами, каких дней нет (полное объяснение — блок «Что не так»).
        var r115 = st is { PulledDays: int pd, SiteDays: int sd }
            ? $"Затянуто {pd} из {sd} {DaysWord(sd)} по сайту федерации"
              + (Swimm.Application.Mapping.IncompleteExplanationRules.MissingDatesShort(u) is { } miss ? $" — {miss}" : "")
            : null;
        var baseInput = new Swimm.Application.Mapping.ChecklistInput(st.State, Imported: db != null,
            StartList: s?.StartList?.Kind, StartListStale: s?.StartList?.Stale == true,
            WarmUpDays: s?.WarmUpDays ?? 0, DayCount: days,
            OnFederationSite: s != null, Hidden: hidden);

        string Phases(Swimm.Application.Mapping.ChecklistInput input)
        {
            var map = new Dictionary<string, string[]>
            {
                ["none"] = Swimm.Application.Mapping.CompetitionChecklistRules.Build(input)
                    .Select(Swimm.Application.Mapping.CompetitionChecklistRules.Code).ToArray(),
            };
            foreach (var ph in Swimm.Application.Mapping.CompetitionChecklistRules.LivePhases)
                map[Swimm.Application.Mapping.CompetitionChecklistRules.Code(ph)] = Swimm.Application.Mapping.CompetitionChecklistRules
                    .Build(input, ph).Select(Swimm.Application.Mapping.CompetitionChecklistRules.Code).ToArray();
            return System.Text.Json.JsonSerializer.Serialize(map);
        }

        // ── Шаги 5–9 одной области (одиночная строка или день события) ──
        Swimm.API.Pages.Admin.Competitions.CompChecklistScope Scope(Swimm.Application.Dtos.CompetitionListItemDto? day, string? label)
        {
            var comp = day ?? db?.Single;
            var results = day?.ResultCount ?? db?.Single?.ResultCount ?? (db?.IsEvent == true ? db.TotalResultCount : 0);
            var scanned = comp?.QualityScannedAt ?? (day == null ? db?.QualityScannedAt : null);
            var suspects = comp?.SuspectCount ?? (day == null ? db?.SuspectCount ?? 0 : 0);
            // Р114 — текст отметки (у дня — своей); Р115 — у всей строки.
            var incomplete = db == null ? null : comp?.PartialResults ?? r115;
            // Промежуточные (шаг 9): идёт ли автодоклейка за импортом, итог последней доклейки дня
            // из аудита, флаг HasSplits — SplitAutoAttachRules.Caption.
            var splitNote = comp != null && Model.SplitNotes.TryGetValue(comp.Id, out var sn) ? sn : null;
            var splitPending = db != null && (comp?.OrgCompId ?? s?.OrgCompId) is int spOc && Model.SplitsPendingOrgCompIds.Contains(spOc);
            var splitCaption = db == null ? null
                : Swimm.Application.Mapping.SplitAutoAttachRules.Caption(splitNote, comp?.HasSplits == true, splitPending);
            var splitsRetry = Swimm.Application.Mapping.SplitAutoAttachRules.DayNeedsRetry(splitNote, splitPending);
            // Строк в базе нет — проверять нечего: шаг 8 не «текущий».
            var input = baseInput with { QualityScanned = scanned != null || (db != null && results == 0), SuspectCount = suspects, Incomplete = incomplete != null, SplitsNeedRetry = splitsRetry };
            var none = Swimm.Application.Mapping.CompetitionChecklistRules.Build(input);

            (string Text, string? Title, bool Danger) Step5()
            {
                if (db != null)
                {
                    if (incomplete != null) return (incomplete.Length > 90 ? incomplete[..90] + "…" : incomplete, incomplete, false);
                    var t = $"{results} {Plural(results, "результат", "результата", "результатов")} в базе";
                    return (s == null ? t + " · PDF-импорт без страницы федерации" : t, null, false);
                }
                if (hidden) return ("скрыто", "Строка скрыта — в долг не идёт. «Вернуть» — снова в работу", false);
                if (markedImported) return ("помечено импортированным (вручную)", "«✓ имп.»: строка закрыта без импорта", false);
                if (s?.EmptySourceAt is { } ea) return ($"протокола нет · с {Swimm.Application.Constants.IsraelTime.ToLocal(ea):dd.MM.yyyy}", "PDF пустой или в нём одни неявки (NS) — тянуть нечего", false);
                return st.State switch
                {
                    Swimm.Application.Mapping.CompetitionRowState.Ahead => ("после старта", null, false),
                    Swimm.Application.Mapping.CompetitionRowState.Running => ("старт идёт — протокол может быть неполным; тянуть можно", null, false),
                    Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol when st.Reason == Swimm.Application.Mapping.WaitingProtocolReason.Incomplete
                        && !string.IsNullOrEmpty(s?.AutoPullBlockedReason) => ($"неполный: {s!.AutoPullBlockedReason}", null, false),
                    Swimm.Application.Mapping.CompetitionRowState.WaitingProtocol => (ReasonText(st.Reason), null, st.ParseFailed),
                    _ when !string.IsNullOrEmpty(s?.LastError) => ("последний забор сорвался", null, true),
                    _ => ("PDF с isr.org.il → разбор → превью", null, false),
                };
            }

            var s5 = Step5();
            var s8 = db == null ? "запустится сама после импорта"
                : results == 0 ? "строк в базе нет"
                : suspects > 0 ? $"помечено сомнительными: {suspects}"
                : scanned is { } at ? $"проверено {at.ToLocalTime():dd.MM.yyyy}"
                : "ещё не проверялось";
            var steps = new List<Swimm.API.Pages.Admin.Competitions.CompChecklistStep>
            {
                new(5, "Протокол скачан и разобран", s5.Text, none[4], s5.Title, s5.Danger),
                new(6, "Проверь превью", day != null ? "превью проверено · быстрая правка — выше, для всего события"
                    : db != null ? "быстрая правка: категории, флаги, бассейн, очки" : "бассейн, рекорды, флаги, категории, очки, событие", none[5]),
                new(7, "Импорт", db != null ? "в базе" : "1–5 минут, в фоне", none[6]),
                new(8, "Проверка качества", s8, none[7]),
                splitCaption is { } sc9
                    ? new(9, "После импорта", sc9.Text, none[8], sc9.Title, sc9.Danger, sc9.Success)
                    : new(9, "После импорта", "Синхр. языки · Loglig-id · Промежуточные", none[8]),
            };
            return new(day, label, steps, Phases(input), incomplete, results, scanned, suspects);
        }

        var scopes = db is { IsEvent: true } ev && ev.Days.Count > 0
            ? ev.Days.Select((d, i) => Scope(d, DayLabel(d, i))).ToList()
            : new List<Swimm.API.Pages.Admin.Competitions.CompChecklistScope> { Scope(null, null) };
        var headNone = Swimm.Application.Mapping.CompetitionChecklistRules.Build(baseInput with
        {
            QualityScanned = scopes[0].QualityScannedAt != null, SuspectCount = scopes[0].SuspectCount, Incomplete = scopes[0].Incomplete != null,
        });

        var sl = s != null ? StartListCaption(s) : ("—", "Строки нет на сайте федерации (PDF-импорт)");
        var warm = s == null ? "—"
            : s.WarmUpDays == 0 ? "не задана"
            : s.WarmUpDays >= days ? (days > 1 ? $"задана на все {days} {DaysWord(days)}" : "задана")
            : $"задана на {s.WarmUpDays} из {days} {DaysWord(days)}";
        var found = s == null ? "нет на сайте федерации — PDF-импорт"
            : s.DiscoveredAt == default ? "—" : Swimm.Application.Constants.IsraelTime.ToLocal(s.DiscoveredAt).ToString("dd.MM.yyyy");
        var started = st.State switch
        {
            Swimm.Application.Mapping.CompetitionRowState.Ahead => $"старт {PanelDate(st)}",
            Swimm.Application.Mapping.CompetitionRowState.Running => $"{StateText(st)} · {PanelDate(st)}",
            _ => PanelDate(st),
        };
        var headSteps = new List<Swimm.API.Pages.Admin.Competitions.CompChecklistStep>
        {
            new(1, "Найден у федерации", found, headNone[0], "Когда забор «Входящих» впервые увидел старт на isr.org.il"),
            new(2, "Стартовый протокол", sl.Item1, headNone[1], sl.Item2),
            new(3, "Разминка", warm, headNone[2], "Время разминки по дням — руками, из регламента (תקנון)"),
            new(4, "Старт прошёл", started, headNone[3]),
        };

        var enc = (string? x) => System.Net.WebUtility.HtmlEncode(x ?? "");
        const string chipCls = "ml-1 inline-block whitespace-nowrap py-0.5 px-1.5 rounded text-[10px] font-bold";
        var chips = DateChangeChipsHtml(s) + AutoPullChipHtml(s)
            + (st.SuggestHide ? $"<span class=\"{chipCls} bg-admin-danger/15 text-admin-danger\" title=\"Пропал с сайта {Swimm.Application.Mapping.CompetitionRowStateRules.MissingSuggestHideDays}+ дн. назад, старт прошёл. Скрыть — «Скрыть» выше; само не закрывается.\">пропал {st.MissingDays} дн. — скрыть?</span>" : "")
            + (db is { IsEvent: true } evh ? $"<span class=\"{chipCls} bg-admin-success/15 text-admin-success\">{evh.DayCount} {DaysWord(evh.DayCount)}</span>" : "")
            + (db is { IsEvent: true } evp && evp.PartialDayCount > 0
                ? PartialBadge(string.Join("\n", evp.Days.Where(d => d.PartialResults != null).Select(d => $"День {d.DayNumber?.ToString() ?? "?"}: {d.PartialResults}")),
                    $"неполные: {evp.PartialDayCount} {DaysWord(evp.PartialDayCount)}")
                : PartialBadge(db?.Single?.PartialResults));

        var org = db?.Single?.OrgCompId ?? s?.OrgCompId ?? db?.Days.Select(d => d.OrgCompId).FirstOrDefault(x => x != null);
        var pool = db?.Single?.PoolType ?? db?.PoolType;
        var rows = db?.Single?.ResultCount ?? db?.TotalResultCount;
        var meta = (org is int oc
                ? $"<span title=\"ID соревнования на isr.org.il (OrgCompId)\">ID федерации <a href=\"https://isr.org.il/comp.asp?compID={oc}\" target=\"_blank\" rel=\"noopener\" class=\"text-admin-accent hover:underline\">{oc} ↗</a></span>"
                : "<span>ID федерации —</span>")
            + (db is { IsEvent: true } evl ? PublicEventLink(evl.EventId) : PublicCompetitionLink(db?.Single?.Id))
            + $"<span>бассейн <span class=\"text-admin-text\">{enc(string.IsNullOrEmpty(pool) ? "—" : pool)}</span></span>"
            + $"<span>строк <span class=\"tabular-nums text-admin-text\">{(rows?.ToString() ?? "—")}</span></span>"
            + (s != null ? $"<span dir=\"rtl\" title=\"Площадка и языки загруженных PDF\">{enc(s.Venue ?? "—")}{LangBadges(s.Languages)}</span>" : "")
            + (db?.Single?.SubName is { Length: > 0 } sub ? $"<span class=\"max-w-[260px] truncate\" dir=\"auto\" title=\"{enc(sub)}\">{enc(sub)}</span>" : "")
            + (s != null && db == null && Model.SeriesFor(s.Name) is { } series
                ? $"<a href=\"/Admin/Series/Edit?id={series.Id}\" class=\"admin-badge border-admin-accent/30 bg-admin-accent/15 text-admin-accent\" title=\"Название содержит ключевую фразу серии — при затягивании дни привяжутся к её частям\">Series: {enc(series.Name)}</a>"
                : "");
        // Причина results-auto: у «неполный: …» она уже в подписи шага 5 — тут только вердикт.
        string? auto = s?.AutoPullVerdict is { } v
            ? $"auto: {Swimm.Application.Mapping.ResultsAutoVerdicts.Label(v)}"
              + (string.IsNullOrEmpty(s.AutoPullBlockedReason) || scopes[0].Step(5).Caption.Contains(s.AutoPullBlockedReason) ? "" : $" — {s.AutoPullBlockedReason}")
            : null;

        var dayEdit = db?.Days.ToDictionary(d => d.Id, d => RowEditUrl(d.Id, key)) ?? new Dictionary<int, string>();
        var dayPublic = db?.Days.ToDictionary(d => d.Id, d => $"{Model.PublicSiteBaseUrl}/competitions/{d.Id}") ?? new Dictionary<int, string>();
        Microsoft.AspNetCore.Html.IHtmlContent? quick = head != null && db != null
            ? await Html.PartialAsync("/Pages/Admin/Competitions/_CompQuickEdit.cshtml",
                new Swimm.API.Pages.Admin.Competitions.CompQuickEditView(db, head, s?.OrgCompId, RowRoute(key),
                    Model.Categories, Model.PoolTypeOptions, Model.ClubRules, Model.SwimmerRules))
            : null;
        Microsoft.AspNetCore.Html.IHtmlContent? cats = db == null ? null
            : await Html.PartialAsync("/Pages/Admin/Competitions/_CompCategories.cshtml", db.IsEvent ? db.Categories : db.Single!.Categories);

        return new(u, key, RowName(u), PanelDate(st), StateText(st), StateChipCls(st), trophyHtml, chips, meta,
            headSteps, Phases(baseInput with { QualityScanned = scopes[0].QualityScannedAt != null, SuspectCount = scopes[0].SuspectCount, Incomplete = scopes[0].Incomplete != null }),
            scopes, auto, key == selKey,
            head != null ? RowEditUrl(head.Id, key) : null, dayEdit, dayPublic, quick, cats, Model.CheckTitles);
    }
}

<div class="grid grid-cols-[clamp(360px,34%,420px)_minmax(0,1fr)] items-start gap-4">
    @* ── Левая колонка: список ── *@
    <section class="admin-card min-w-0 overflow-hidden p-0" aria-label="Список соревнований">
        @* Пачка идёт или готова, а справа открыт чек-лист строки — вернуться к пачке отсюда.
           Текст и видимость ведёт JS пачки (решение — вопрос в PR этапа 5). *@
        <button type="button" id="bulk-strip"
                class="mx-3 mt-3 hidden w-[calc(100%-1.5rem)] cursor-pointer items-center gap-2 rounded-md border border-admin-accent/30 bg-admin-accent/10 px-3 py-1.5 text-left text-[13px] text-admin-text hover:bg-admin-accent/15">
            <span id="bulk-strip-text" class="min-w-0 flex-1"></span>
            <span class="shrink-0 font-semibold text-admin-accent">→ показать</span>
        </button>
        @* Шапка месяца (рамка): заголовок + пачка. Этап 5 подставит сюда «Затянуть за месяц (N)»,
           в шапки блоков дней — «за день (N)»; пока — прежняя кнопка пачки и её чекбокс. *@
        <div class="m-3 rounded-md border border-admin-border px-3 py-2.5">
            <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
                <div class="min-w-0">
                    <div class="truncate text-base font-semibold text-admin-text" title="@ListTitle()">@ListTitle()</div>
                    <div class="text-[11px] text-admin-text-muted">
                        @Model.Result.TotalCount @(Model.Result.TotalCount % 10 == 1 && Model.Result.TotalCount % 100 != 11 ? "строка" : "строк")@(Model.Unpaged || Model.Result.TotalPages <= 1 ? "" : $" · стр. {Model.Result.Page} из {Model.Result.TotalPages}")
                    </div>
                </div>
                @* «Затянуть за месяц (N)» — только у выбранного месяца сезона; чекбокс под ней относится
                   к ней (решение Влада) и меняет и её N, и N кнопок дней. Кнопки «за сезон» нет. *@
                @if (Model.MonthBulk is { IsEmpty: false } monthBulk)
                {
                    <div id="list-bulk" class="flex flex-col items-end gap-1">
                        @BulkOffer(monthBulk, "month", "Затянуть за месяц", "admin-btn admin-btn-primary py-1 px-2.5", null)
                        <label class="flex cursor-pointer items-center gap-1.5 text-xs text-admin-text-muted"
                               title="Чемпионаты Израиля разбираются штучно: медали, зачёт и категории у них свои">
                            <input type="checkbox" id="bulk-include-champ" class="cursor-pointer" />
                            включая чемпионаты
                        </label>
                    </div>
                }
                else if (Model.DayBulk.Values.Any(o => !o.IsEmpty))
                {
                    @* Месяца нет (поиск, весь сезон), а кнопки дней есть: чекбокс нужен им. *@
                    <label id="list-bulk" class="flex cursor-pointer items-center gap-1.5 self-end text-xs text-admin-text-muted"
                           title="Чемпионаты Израиля разбираются штучно: медали, зачёт и категории у них свои">
                        <input type="checkbox" id="bulk-include-champ" class="cursor-pointer" />
                        включая чемпионаты
                    </label>
                }
            </div>
        </div>

        @* Переключатель состояний (?state=): числа — под всеми фильтрами, кроме самого state. *@
        @{
            var ls = Model.ListStates;
            var stateTabs = new (string? Value, string Label, int Count)[]
            {
                (null, "Все", ls.Total),
                (Swimm.Application.Mapping.CompetitionStateFilters.Waiting, "Ждут", ls.Debt),
                (Swimm.Application.Mapping.CompetitionStateFilters.Ahead, "Впереди", ls.AheadTotal),
                (Swimm.Application.Mapping.CompetitionStateFilters.Closed, "Закрыто", ls.Closed),
            };
        }
        <nav class="mx-3 mb-3 flex gap-1 rounded-md border border-admin-border p-1 text-xs" title="@StatesHint(ls)" aria-label="Фильтр по состоянию">
            @foreach (var (value, label, n) in stateTabs)
            {
                var on = Model.State == value;
                <a href="@StateUrl(value)" aria-current="@(on ? "page" : null)"
                   class="flex-1 whitespace-nowrap rounded px-2 py-1 text-center no-underline @(on ? "bg-admin-accent/15 font-semibold text-admin-accent" : "text-admin-text-muted hover:bg-admin-surface-hover hover:text-admin-text")">@label <span class="tabular-nums">@n</span></a>
            }
        </nav>

        @if (items.Count == 0)
        {
            <div class="border-t border-admin-border px-3 py-8 text-center italic text-admin-text-muted">Ничего не найдено.</div>
        }

        @if (readyCount > 0)
        {
            GroupHead("Ждут затягивания", readyCount, "text-admin-warning");
            <div class="flex flex-col gap-2 px-3 pb-3">
                @foreach (var day in Model.ReadyToPullByDay)
                {
                    <div class="overflow-hidden rounded-md border border-admin-warning/30" data-ready-day="@(day.Day == DateOnly.MinValue ? "" : day.Day.ToString("yyyy-MM-dd"))">
                        <div class="flex items-center gap-2 bg-admin-warning/10 px-3 py-1.5">
                            <span class="text-[13px] font-semibold text-admin-text">
                                @(day.Day == DateOnly.MinValue ? "Без даты" : $"{char.ToUpper(weekdays[(int)day.Day.DayOfWeek][0])}{weekdays[(int)day.Day.DayOfWeek][1..]} {day.Day:dd.MM}{Yr(day.Day)}")
                            </span>
                            <span class="text-[11px] text-admin-text-muted">@DaysAgo(day.Day)</span>
                            @* «Затянуть за день (N)» / «чемпионат — отдельно» — правило BulkPullSelection. *@
                            <span class="day-actions ml-auto">
                                @if (Model.DayBulk.TryGetValue(day.Day, out var dayBulk) && !dayBulk.IsEmpty)
                                {
                                    @BulkOffer(dayBulk, "day", "Затянуть за день", "admin-btn py-0.5 px-2 border-admin-accent/40 text-admin-accent hover:bg-admin-accent/15",
                                        day.Day == DateOnly.MinValue ? "без даты" : day.Day.ToString("dd.MM"))
                                }
                            </span>
                        </div>
                        <div>
                            @foreach (var u in day.Rows) { ListRow(u, showDate: false); }
                        </div>
                    </div>
                }
            </div>
        }

        @if (waitingRows.Count > 0)
        {
            GroupHead("Ждём протокол", waitingRows.Count, "text-admin-warning/70");
            <div class="pb-1">@foreach (var u in waitingRows) { ListRow(u, showDate: true); }</div>
        }

        @if (aheadRows.Count > 0)
        {
            GroupHead("Впереди", aheadRows.Count, "text-admin-accent");
            <div class="pb-1">@foreach (var u in aheadRows) { ListRow(u, showDate: true); }</div>
        }

        @if (closedRows.Count > 0)
        {
            GroupHead("Закрыто", closedRows.Count, "text-admin-success");
            <div class="pb-1">@foreach (var u in closedRows) { ListRow(u, showDate: true); }</div>
        }

        @if (!Model.Unpaged && Model.Result.TotalPages > 1)
        {
            <div class="border-t border-admin-border px-3">
                <partial name="/Pages/Admin/Shared/_Pagination.cshtml"
                         model='new Swimm.API.Pages.Admin.Shared.PaginationModel(Model.Result.Page, Model.Result.TotalPages,
                                    Model.Result.HasPrev ? PageUrl(Model.Result.Page - 1) : null,
                                    Model.Result.HasNext ? PageUrl(Model.Result.Page + 1) : null)' />
            </div>
        }
    </section>

    @* ── Правая колонка: выбранное соревнование. Панели отрисованы у всех строк страницы, видна
       одна (sel), JS переключает без перезагрузки. У строк всех состояний — чек-лист (_CompChecklist,
       этапы 4 и 6); у многодневного события — общая часть и шаги 5–9 по дням. *@
    <div id="comp-detail" data-auto-key="@(Model.AutoSelectedRow == null ? null : Swimm.Application.Mapping.CompetitionRowKey.Of(Model.AutoSelectedRow))" class="sticky top-4 max-h-[calc(100vh-2rem)] min-w-0 overflow-y-auto">
        @* Затягивание, чья строка не на этой странице списка (другой месяц, фильтры): ход идёт, видно его здесь. *@
        <div id="pull-elsewhere" class="admin-card mb-3 hidden px-4 py-2.5 text-[13px]"></div>
        @* Пачка (вариант E, этап 5): показывается ВМЕСТО чек-листа соревнования. Не модал — забор
           идёт минутами, из него надо уметь уйти (клик по строке списка) и вернуться (строка
           #bulk-strip над списком); batchId переживает F5 в sessionStorage. Класс row-panel —
           чтобы выбор строки прятал пачку тем же show(), что и панели строк. *@
        <div id="panel-bulk" class="row-panel admin-card hidden p-4" data-key="bulk">
            <div class="mb-3 flex flex-wrap items-start justify-between gap-2 border-b border-admin-border pb-3">
                <div class="min-w-0">
                    <h2 class="text-base font-semibold text-white">Пакетное затягивание</h2>
                    <div id="bulk-scope" class="mt-0.5 text-xs text-admin-text-muted"></div>
                </div>
                <button type="button" id="bulk-close" class="cursor-pointer text-[13px] text-admin-text-muted hover:text-admin-text"
                        title="Убрать пачку со страницы. Забор и импорт на сервере это не останавливает.">Закрыть</button>
            </div>
            <div id="bulk-progress" class="mb-2 text-[13px] text-admin-text-muted"></div>
            <div id="bulk-skipped" class="mb-2 hidden text-[12.5px] text-admin-text-muted"></div>
            <div id="bulk-rows" class="mb-3 overflow-x-auto"></div>
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="bulk-import-btn" class="admin-btn admin-btn-primary py-1 px-3" disabled>
                    Импортировать отмеченные
                </button>
                <button type="button" id="bulk-uncheck-noreg" class="admin-btn admin-btn-ghost py-1 px-3">
                    Снять все без регламента
                </button>
                <span class="text-[12px] text-admin-text-muted">
                    Категория всем — <strong class="text-admin-text">Age 8-99</strong>;
                    перезапись существующего и удаление лишнего не применяются.
                </span>
            </div>
            <div id="bulk-import-result" class="mt-2 text-[12.5px]"></div>
        </div>
        <div id="panel-none" class="admin-card text-[13px] text-admin-text-muted @(selRow != null ? "hidden" : "")">
            @if (!string.IsNullOrEmpty(Model.Selected) && selRow == null)
            {
                <text>Выбранное соревнование (<code>@Model.Selected</code>) не видно при текущих фильтрах@(Model.Unpaged ? "" : " или на этой странице списка").</text>
            }
            else
            {
                <text>Выбери соревнование в списке слева — здесь откроются его данные и действия.</text>
            }
        </div>

        @foreach (var u in items)
        {
            var rowKey = Swimm.Application.Mapping.CompetitionRowKey.Of(u);
            <partial name="/Pages/Admin/Competitions/_CompChecklist.cshtml" model="await ChecklistView(u, rowKey)" />
        }

        @* Превью — шаг 6 чек-листа; JS переносит блок в слот панели своей строки (этап 4). *@
        <partial name="/Pages/Admin/Competitions/_CompPreview.cshtml" model="Model.ClubRules" />
    </div>
</div>

@* Качество результатов: список помеченных строк + прогон проверок. Пометка НЕ скрывает
   и НЕ удаляет заплыв — он остаётся в протоколе, но выпадает из детекции рекордов. *@
<dialog id="quality-modal"
        class="m-auto w-[min(56rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Качество результатов</h2>
                <div id="quality-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="quality-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>

        <p class="mt-3 text-[12px] text-admin-text-muted">
            Проверка ищет ошибки самого протокола — то, что не лечится переимпортом.
            Помеченный заплыв остаётся в результатах, но не участвует в рекордах.
            Ручные решения переживают переимпорт, автоматические пересчитываются заново.
        </p>

        <div class="mt-3 flex items-center gap-3">
            <button type="button" id="quality-scan" class="admin-btn admin-btn-primary py-1 px-3">Проверить</button>
            <span id="quality-stats" class="text-[12px] text-admin-text-muted"></span>
        </div>

        @* Ручная пометка. Нужна потому, что правила ловят не всё: ошибка протокола бывает
           медленнее рекорда и не нарушает ни одного порога — её видит только человек,
           знающий пловца (200 вольным за 1:53 при стольнике 1:05). *@
        <div class="mt-3 flex flex-wrap items-center gap-2">
            <input type="search" id="quality-search" placeholder="Пометить вручную: имя, клуб, время или дистанция"
                   class="admin-input py-1 px-2 text-[13px] w-[22rem] max-w-full" />
            <button type="button" id="quality-search-btn" class="admin-btn admin-btn-ghost py-1 px-3">Найти</button>
            <span id="quality-search-hint" class="text-[11px] text-admin-text-muted"></span>
        </div>

        <div id="quality-found" class="mt-3"></div>
        <div id="quality-body" class="mt-4 max-h-[60vh] overflow-y-auto"></div>
    </div>
</dialog>
@* Стартовый протокол (С5): забор идёт минутами, а раньше отчёт писался в «sync-info»
   в шапке страницы — прокрученному вниз пользователю казалось, что кнопка мертва.
   Модалка не закрывается сама: по ней и снимают диагностику при ошибке. *@
<dialog id="startlist-modal"
        class="m-auto w-[min(48rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Стартовый протокол</h2>
                <div id="startlist-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="startlist-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>
        <div id="startlist-status" class="mt-3 text-[13px]"></div>
        <pre id="startlist-log"
             class="mt-3 max-h-[50vh] overflow-auto whitespace-pre-wrap break-words rounded border border-admin-border bg-admin-bg p-3 text-[12px] leading-relaxed text-admin-text-muted"></pre>
        <div class="mt-3 flex items-center gap-2">
            <button type="button" id="startlist-copy" class="admin-btn admin-btn-ghost py-1 px-3">Скопировать отчёт</button>
            <span id="startlist-copy-hint" class="text-[11px] text-admin-text-muted"></span>
        </div>
    </div>
</dialog>

@* Справка о старте (Т1, docs/plans/start-list-ticket-plan.md): разминка по дням и флаг
   «чемпионат». Разминка вводится РУКАМИ из регламента — автоматического источника у неё
   нет; флаг ставит забор, здесь его можно только переопределить. *@
<dialog id="meetinfo-modal"
        class="m-auto w-[min(40rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Разминка и тип старта</h2>
                <div id="meetinfo-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="meetinfo-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>

        <div id="meetinfo-body" class="mt-4 text-[13px]"></div>

        <div class="mt-4 flex items-center gap-2">
            <button type="button" id="meetinfo-save" class="admin-btn admin-btn-primary py-1 px-3">Сохранить</button>
            <span id="meetinfo-hint" class="text-[11px] text-admin-text-muted"></span>
        </div>
        <p class="mt-3 text-[11px] leading-relaxed text-admin-text-muted">
            Время — местное, из регламента (תקנון). Витрина показывает «приезжать к» за
            30 минут до разминки, и только на чемпионате — залогиненному, отметившему
            «I'm coming». Пустое поле стирает время дня.
        </p>
    </div>
</dialog>



@* Источники стартового протокола соревнования: какие compID федерации в него входят.
   Один наш старт бывает собран из нескольких протоколов (окружные чемпионаты), поэтому
   привязка — список, а не поле. *@
<dialog id="sources-modal"
        class="m-auto w-[min(52rem,calc(100vw-2rem))] rounded-lg border border-admin-border bg-admin-surface p-0 text-admin-text shadow-xl shadow-black/50">
    <div class="p-5">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="text-base font-semibold text-white">Источники стартового протокола</h2>
                <div id="sources-title" class="mt-0.5 truncate text-sm text-admin-text-muted"></div>
            </div>
            <button type="button" id="sources-close" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</button>
        </div>

        <p class="mt-3 text-[12px] text-admin-text-muted">
            Из каких compID федерации собирается таб «Start list». Импорт привязывает свой
            compID сам; руками добавляют остальные — например четыре окружных протокола одного
            чемпионата. Привязка ничего не тянет: после неё нажмите «Стартовый протокол»
            на строке источника во «Входящих».
        </p>

        <div id="sources-status" class="mt-3 text-[13px]"></div>
        <div id="sources-body" class="mt-3 max-h-[60vh] overflow-y-auto"></div>
    </div>
</dialog>

@section Scripts {
<script>
    // Данные из Razor — до скрипта страницы, он их читает (wwwroot/js/admin/competitions-index.js).
    // Словарь discovery-строк на странице: id → { name, languages } — чтобы действия не
    // тащили имя через onclick (проблемы экранирования иврита/кавычек).
    window.__DISC = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Result.Items.Where(u => u.Site != null)
            .GroupBy(u => u.Site!.DiscoveredId).Select(g => g.First())
            .ToDictionary(u => u.Site!.DiscoveredId.ToString(),
                u => new { name = u.Site!.Name, languages = u.Site!.Languages, orgCompId = u.Site!.OrgCompId })));
</script>
<script src="~/js/admin/competitions-index.js" asp-append-version="true"></script>
}
