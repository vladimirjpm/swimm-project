@using Swimm.API.Pages.Admin.Shared
@model ApiEndpoint
@*
    Карточка одного эндпоинта в каталоге /Admin/Api. Highlighted-варианты (Import/Clear/Enrich)
    показывают описание как <p> + блок Body/Response вместо .desc; остальные — .desc
    (+ опциональный Response-блок, если задан). Run-кнопка вызывает общий runApi() из
    Api.cshtml — параметры передаются через data-param/data-path/data-body на инпутах.
*@
@{
    var hasParams = Model.Params is { Count: > 0 };
    var wrapperClass = "api-card bg-white/[.05] rounded-lg mb-3 px-5 py-4"
        + (Model.Highlighted ? $" border-l-[3px] {Model.HighlightBorderClass}" : "");
}
<div class="@wrapperClass">
    <div class="flex items-center gap-2.5 mb-2 flex-wrap">
        <span class="method-badge method-@Model.Method.ToLowerInvariant()">@Model.Method</span>
        <span class="path">@Model.Path</span>
        @if (Model.AuthBadge != null)
        {
            <span class="auth-badge">@Model.AuthBadge</span>
        }
    </div>

    @if (Model.Highlighted)
    {
        <p class="text-[#b0bec5] text-sm mb-3">@Html.Raw(Model.Description)</p>
    }
    else
    {
        <div class="desc">@Html.Raw(Model.Description)</div>
    }

    @if (Model.BodyShape != null || Model.ResponseShape != null)
    {
        <div class="text-xs text-[#90a4ae] mb-2">
            @if (Model.BodyShape != null)
            {
                <text><strong>Body:</strong> @Html.Raw(Model.BodyShape)<br /></text>
            }
            @if (Model.ResponseShape != null)
            {
                <text><strong>Response:</strong> <code>@Model.ResponseShape</code></text>
            }
        </div>
    }

    @if (hasParams)
    {
        <table class="params-table">
            <thead><tr><th>Param</th><th>Type</th><th>In</th><th>Description</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Params!)
                {
                    <tr>
                        <td class="param-name">@p.Name</td>
                        <td class="param-type">@p.Type</td>
                        <td class="param-loc">@p.In</td>
                        <td>@Html.Raw(p.Description)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Note != null)
    {
        <div class="text-[#546e7a] text-xs italic">@Html.Raw(Model.Note)</div>
    }

    @if (Model.Runnable)
    {
        <div class="param-inputs">
            @if (hasParams)
            {
                @foreach (var p in Model.Params!)
                {
                    <label>
                        @p.Name
                        @if (p.Type == "bool")
                        {
                            var opts = p.BoolFalseFirst ? new[] { "false", "true" } : new[] { "true", "false" };
                            <select data-param="@p.Name" data-body="@(p.In == "body" ? "true" : null)">
                                @foreach (var o in opts)
                                {
                                    <option value="@o">@o</option>
                                }
                            </select>
                        }
                        else
                        {
                            var inputType = p.Type is "int" or "long" ? "number" : p.Type == "DateTime" ? "date" : "text";
                            <input type="@inputType" data-param="@p.Name"
                                   data-path="@(p.In == "path" ? "true" : null)"
                                   value="@p.DefaultValue"
                                   style="@(p.InputWidth != null ? $"width:{p.InputWidth}" : null)" />
                        }
                    </label>
                }
            }
            <button class="py-1.5 px-4 bg-[#4fc3f7] text-[#0f3460] rounded font-semibold text-xs cursor-pointer hover:bg-[#81d4fa] disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                    onclick="runApi(this, '@Model.Method', '@Model.Path', {})">Run</button>
        </div>
        <div class="response-area hidden mt-3 bg-black/20 rounded p-3 overflow-auto max-h-96"><div class="response-status"></div><pre></pre></div>
    }
</div>
