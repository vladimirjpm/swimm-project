@page
@model Swimm.API.Pages.Admin.ServicesModel
@{
    ViewData["Title"] = "Services";
    ViewData["PageSubtitle"] = "Все сайты и кабинеты проекта: зачем каждый и куда нажимать";
}

@* Содержимое — Shared/ServicesCatalog.cs; справка — docs/admin-pages/services.md. *@

<div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-[0.85rem] text-admin-text-muted leading-relaxed">
    Ссылки открываются в новой вкладке. Паролей здесь нет — только где их взять. Что делать, если
    сайт или данные сломались, — <a href="/Admin/Docs/important?file=docs%2Fdeploy.md" class="text-admin-accent hover:underline">docs/deploy.md</a>.
</div>

@foreach (var group in Model.Groups)
{
    <h2 class="mt-8 mb-3 text-sm font-semibold uppercase tracking-wide text-admin-text-muted">@group.Title</h2>
    <div class="grid gap-4 lg:grid-cols-2">
        @foreach (var s in group.Services)
        {
            <div class="admin-card p-4">
                <div class="mb-1 text-base font-semibold text-admin-text">@s.Name</div>
                <p class="mb-3 text-[0.85rem] leading-relaxed text-admin-text-muted">@s.Why</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var link in s.Links)
                    {
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                           class="admin-btn admin-btn-ghost py-1 px-2.5 text-[12.5px] no-underline">@link.Label ↗</a>
                    }
                </div>
                @if (s.Access is not null || s.Cost is not null)
                {
                    <div class="mt-3 border-t border-admin-border pt-2 text-xs leading-relaxed text-admin-text-muted">
                        @if (s.Access is not null)
                        {
                            <div><span class="text-admin-text">Доступ:</span> @s.Access</div>
                        }
                        @if (s.Cost is not null)
                        {
                            <div><span class="text-admin-text">Стоимость:</span> @s.Cost</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
