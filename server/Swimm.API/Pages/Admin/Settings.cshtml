@page
@model Swimm.API.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Settings";
    ViewData["HeaderTitle"] = "⚙️ Settings";
    ViewData["TitleColor"] = "#ffa726";
}

<div class="max-w-[1060px] mx-auto p-6">
    <div class="bg-[rgba(79,195,247,0.08)] border-l-[3px] border-l-[#4fc3f7] rounded-md py-3 px-4 mb-6 text-[0.85rem] text-[#90a4ae] leading-relaxed">
        Параметры хранятся <strong class="text-gray-300">в памяти</strong> и сбрасываются при перезапуске сервера.<br>
        <strong class="text-gray-300">Scope</strong> показывает к чему относится параметр:
        <span class="text-[0.7rem] py-0.5 px-1.5 rounded-sm font-semibold uppercase whitespace-nowrap bg-[rgba(79,195,247,0.15)] text-[#4fc3f7]">admin</span> — только админ-панель,
        <span class="text-[0.7rem] py-0.5 px-1.5 rounded-sm font-semibold uppercase whitespace-nowrap bg-[rgba(129,199,132,0.15)] text-[#81c784]">livesite</span> — только публичная часть,
        <span class="text-[0.7rem] py-0.5 px-1.5 rounded-sm font-semibold uppercase whitespace-nowrap bg-[rgba(206,147,216,0.15)] text-[#ce93d8]">both</span> — и то и другое.<br>
        Изменение параметров со scope <span class="text-[0.7rem] py-0.5 px-1.5 rounded-sm font-semibold uppercase whitespace-nowrap bg-[rgba(79,195,247,0.15)] text-[#4fc3f7]">admin</span> автоматически сбрасывает кеш схемы БД.
    </div>

    <div class="flex gap-1.5 mb-5 flex-wrap" id="scope-tabs">
        <button class="scope-tab active py-1.5 px-4 rounded-[5px] border border-[#546e7a] bg-transparent text-[#90a4ae] cursor-pointer text-xs font-[inherit] transition-all hover:border-[#4fc3f7] hover:text-[#4fc3f7]" data-scope="all">All</button>
        <button class="scope-tab py-1.5 px-4 rounded-[5px] border border-[#546e7a] bg-transparent text-[#90a4ae] cursor-pointer text-xs font-[inherit] transition-all hover:border-[#4fc3f7] hover:text-[#4fc3f7]" data-scope="admin">Admin</button>
        <button class="scope-tab py-1.5 px-4 rounded-[5px] border border-[#546e7a] bg-transparent text-[#90a4ae] cursor-pointer text-xs font-[inherit] transition-all hover:border-[#4fc3f7] hover:text-[#4fc3f7]" data-scope="livesite">LiveSite</button>
        <button class="scope-tab py-1.5 px-4 rounded-[5px] border border-[#546e7a] bg-transparent text-[#90a4ae] cursor-pointer text-xs font-[inherit] transition-all hover:border-[#4fc3f7] hover:text-[#4fc3f7]" data-scope="both">Both</button>
    </div>

    <table class="w-full border-collapse">
        <thead>
            <tr>
                <th class="text-left text-[#78909c] text-[0.7rem] uppercase py-2 px-2.5 border-b border-white/10">Parameter</th>
                <th class="text-left text-[#78909c] text-[0.7rem] uppercase py-2 px-2.5 border-b border-white/10">Scope</th>
                <th class="text-left text-[#78909c] text-[0.7rem] uppercase py-2 px-2.5 border-b border-white/10">Type</th>
                <th class="text-left text-[#78909c] text-[0.7rem] uppercase py-2 px-2.5 border-b border-white/10">Value</th>
                <th class="text-left text-[#78909c] text-[0.7rem] uppercase py-2 px-2.5 border-b border-white/10">Description</th>
            </tr>
        </thead>
        <tbody id="settings-body">
            <tr><td colspan="5" style="text-align:center;color:#546e7a;padding:2rem">Loading...</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
<script>
(async function () {
    const API = '/api/admin/settings';
    let settings = [];
    let activeScope = 'all';

    function renderValueControl(s) {
        const id = `val-${s.key}`;
        const okId = `ok-${s.key}`;

        if (s.dataType === 'bool') {
            const checked = s.value.toLowerCase() === 'true' ? 'checked' : '';
            const isDanger = s.key === 'MaintenanceMode';
            const cls = isDanger ? 'toggle-switch danger' : 'toggle-switch';
            const label = s.value.toLowerCase() === 'true'
                ? (isDanger ? '<span class="text-[0.78rem] text-[#ef5350] ml-0.5">ON</span>' : '<span class="text-[0.78rem] text-[#90a4ae] ml-0.5">ON</span>')
                : '<span class="text-[0.78rem] text-[#90a4ae] ml-0.5">OFF</span>';
            return `<div class="flex items-center gap-1.5 flex-wrap">
                <label class="${cls}">
                    <input type="checkbox" ${checked} onchange="saveBool('${esc(s.key)}', this.checked)">
                    <span class="toggle-slider"></span>
                </label>
                ${label}
                <span class="saved-icon text-[#66bb6a] text-[0.85rem] opacity-0 transition-opacity duration-300" id="${okId}">&#10003;</span>
            </div>`;
        }

        const widthCls = s.dataType === 'string' ? 'w-[200px]' : 'w-[140px]';
        return `<div class="flex items-center gap-1.5 flex-wrap">
            <input class="bg-black/30 border border-[#546e7a] rounded py-1 px-2 text-gray-300 text-[0.82rem] font-[inherit] ${widthCls} focus:outline-none focus:border-[#4fc3f7]" id="${id}" value="${esc(s.value)}"
                   onkeydown="if(event.key==='Enter')saveField('${esc(s.key)}')">
            <button class="bg-[#66bb6a] border-none text-white py-1 px-3 rounded cursor-pointer text-[0.78rem] font-[inherit] transition-opacity hover:opacity-85" onclick="saveField('${esc(s.key)}')">Save</button>
            <span class="saved-icon text-[#66bb6a] text-[0.85rem] opacity-0 transition-opacity duration-300" id="${okId}">&#10003;</span>
        </div>`;
    }

    const scopeClasses = {
        admin: 'bg-[rgba(79,195,247,0.15)] text-[#4fc3f7]',
        livesite: 'bg-[rgba(129,199,132,0.15)] text-[#81c784]',
        both: 'bg-[rgba(206,147,216,0.15)] text-[#ce93d8]'
    };

    function render() {
        const tbody = document.getElementById('settings-body');
        const filtered = activeScope === 'all'
            ? settings
            : settings.filter(s => s.scope === activeScope);

        if (!filtered.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-[#546e7a] py-8">No settings for this scope</td></tr>';
            return;
        }

        tbody.innerHTML = filtered.map(s => `
            <tr class="hover:bg-white/[.03]">
                <td class="py-2.5 px-2.5 text-[0.85rem] border-b border-white/[.05] align-top"><span class="text-[#ffd54f] font-semibold">${esc(s.key)}</span></td>
                <td class="py-2.5 px-2.5 text-[0.85rem] border-b border-white/[.05] align-top"><span class="text-[0.7rem] py-0.5 px-1.5 rounded-sm font-semibold uppercase whitespace-nowrap ${scopeClasses[s.scope] || ''}">${esc(s.scope)}</span></td>
                <td class="py-2.5 px-2.5 text-[0.85rem] border-b border-white/[.05] align-top"><span class="text-[0.7rem] text-[#546e7a] italic">${esc(s.dataType)}</span></td>
                <td class="py-2.5 px-2.5 text-[0.85rem] border-b border-white/[.05] align-top">${renderValueControl(s)}</td>
                <td class="py-2.5 px-2.5 text-[0.85rem] border-b border-white/[.05] align-top"><span class="text-[#90a4ae] text-[0.78rem] leading-snug">${esc(s.description)}</span></td>
            </tr>
        `).join('');
    }

    function flashOk(key) {
        const el = document.getElementById('ok-' + key);
        if (!el) return;
        el.classList.add('show');
        setTimeout(() => el.classList.remove('show'), 2000);
    }

    window.saveField = async function (key) {
        const input = document.getElementById('val-' + key);
        if (!input) return;
        const newValue = input.value;
        try {
            await api(`${API}/${encodeURIComponent(key)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ value: newValue })
            });
            const s = settings.find(x => x.key === key);
            if (s) s.value = newValue;
            flashOk(key);
            toast(`${key} = ${newValue}`);
        } catch (e) {
            toast(`Error: ${e.message}`);
        }
    };

    window.saveBool = async function (key, checked) {
        try {
            const newValue = String(checked);
            await api(`${API}/${encodeURIComponent(key)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ value: newValue })
            });
            const s = settings.find(x => x.key === key);
            if (s) s.value = newValue;
            flashOk(key);
            toast(`${key} = ${checked}`);
            render();
        } catch (e) {
            toast(`Error: ${e.message}`);
        }
    };

    document.getElementById('scope-tabs').addEventListener('click', (e) => {
        const btn = e.target.closest('.scope-tab');
        if (!btn) return;
        document.querySelectorAll('.scope-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeScope = btn.dataset.scope;
        render();
    });

    try {
        settings = await api(API);
        render();
    } catch (e) {
        console.error('Settings load failed', e);
        document.getElementById('settings-body').innerHTML =
            '<tr><td colspan="5" style="text-align:center;color:#ef5350;padding:2rem">Failed to load settings. Check Admin access.</td></tr>';
    }
})();
</script>
}
