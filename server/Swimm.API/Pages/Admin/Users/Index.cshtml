@page
@model Swimm.API.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    ViewData["PageSubtitle"] = "Пользователи и логины: кто онлайн, активность, отзыв сессий";

    var flash = TempData["Flash"] as string;
}

@if (!string.IsNullOrEmpty(flash))
{
    <script>
        document.addEventListener('DOMContentLoaded', () => toast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(flash)), 3000));
    </script>
}

@* ── Счётчики логинов ── *@
<div class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="admin-card">
        <div class="text-2xl font-bold tabular-nums text-admin-text">@Model.Stats.OnlineNow</div>
        <div class="text-xs text-admin-text-muted">онлайн сейчас (≤15 мин)</div>
    </div>
    <div class="admin-card">
        <div class="text-2xl font-bold tabular-nums text-admin-text">@Model.Stats.Logins7d</div>
        <div class="text-xs text-admin-text-muted">логинов за 7 дней</div>
    </div>
    <div class="admin-card">
        <div class="text-2xl font-bold tabular-nums text-admin-text">@Model.Stats.Logins30d</div>
        <div class="text-xs text-admin-text-muted">логинов за 30 дней</div>
    </div>
    <div class="admin-card">
        <div class="text-2xl font-bold tabular-nums @(Model.Stats.FailedLogins7d > 0 ? "text-admin-warning" : "text-admin-text")">@Model.Stats.FailedLogins7d</div>
        <div class="text-xs text-admin-text-muted">неудачных попыток за 7 дней</div>
    </div>
</div>

@* ── Фильтр списка (?show=): чип — ссылка, число — сколько подходит без фильтра ── *@
<div class="mb-3 flex flex-wrap gap-2">
    @foreach (var (key, label) in Swimm.API.Pages.Admin.Users.IndexModel.Filters)
    {
        if (key == "changed" && !Model.CanResetPersonas) { continue; }
        var active = (Model.Show ?? "all") == key || (key == "all" && !Swimm.API.Pages.Admin.Users.IndexModel.Filters.Any(f => f.Key == Model.Show));
        var count = Model.AllUsers.Count(u => Model.Matches(u, key));
        <a href="@Url.Page("Index", new { show = key == "all" ? null : key })"
           class="admin-btn @(active ? "admin-btn-primary" : "admin-btn-ghost") py-1 px-2.5">
            @label <span class="tabular-nums">@count</span>
        </a>
    }
</div>

<div class="overflow-x-auto">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Пользователь</th>
                <th>Роли</th>
                <th>Вход</th>
                <th>Последняя активность</th>
                <th class="text-right">Логины 7д / 30д</th>
                <th class="text-right" title="Сколько групп владеет / действующий лимит">Группы</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                var online = Swimm.API.Pages.Admin.Users.IndexModel.IsOnline(u.LastSeenAt);
                var groupLimit = Model.EffectiveHubGroupLimit(u.Roles, u.HubGroupLimit);
                <tr class="@(u.Id == Model.UserId ? "bg-admin-surface-hover" : null)">
                    <td>
                        <a href="@Url.Page("Index", new { userId = u.Id, show = Model.Show })" class="text-admin-accent hover:underline font-medium">@u.DisplayName</a>
                        <div class="text-xs text-admin-text-muted">@u.Email</div>
                    </td>
                    <td>
                        @if (u.Roles.Length == 0)
                        {
                            <span class="text-admin-text-muted">—</span>
                        }
                        @foreach (var r in u.Roles)
                        {
                            <span class="admin-badge border-admin-border bg-admin-surface-hover text-admin-text mr-1">@r</span>
                        }
                    </td>
                    <td class="text-xs text-admin-text-muted whitespace-nowrap">
                        @(u.HasGoogle ? "Google" : null)@(u.HasGoogle && u.HasLocalPassword ? " + " : null)@(u.HasLocalPassword ? "пароль" : null)
                        @if (!u.HasGoogle && !u.HasLocalPassword)
                        {
                            <span>—</span>
                        }
                    </td>
                    <td class="whitespace-nowrap">
                        @if (online)
                        {
                            <span class="admin-badge border-admin-success/30 bg-admin-success/15 text-admin-success">● online</span>
                        }
                        else if (u.LastSeenAt != null)
                        {
                            <span class="text-xs text-admin-text-muted" title="@u.LastSeenAt UTC">@u.LastSeenAt.Value.ToString("dd.MM.yyyy HH:mm") UTC</span>
                        }
                        else
                        {
                            <span class="text-admin-text-muted">—</span>
                        }
                    </td>
                    <td class="text-right tabular-nums">@u.Logins7d / @u.Logins30d</td>
                    <td class="text-right tabular-nums whitespace-nowrap">
                        @u.HubGroupsOwned / @(groupLimit?.ToString() ?? "∞")
                        @if (u.HubGroupLimit != null && !u.Roles.Contains("Admin"))
                        {
                            <span class="admin-badge border-admin-accent/30 bg-admin-accent/15 text-admin-accent ml-1" title="Персональный лимит — исключение из лимита по роли">перс.</span>
                        }
                    </td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="admin-badge border-admin-success/30 bg-admin-success/15 text-admin-success">active</span>
                        }
                        else
                        {
                            <span class="admin-badge border-admin-danger/30 bg-admin-danger/15 text-admin-danger">disabled</span>
                        }
                    </td>
                    <td class="text-right whitespace-nowrap">
                        @* Тестовый персонаж — вернуть в исходное состояние (только Development). *@
                        @if (Model.CanResetPersonas && Swimm.API.Pages.Admin.Users.IndexModel.IsPersona(u.Email))
                        {
                            @* Изменён руками — кнопка горит, в подсказке что именно; не менялся — блёклая. *@
                            var changed = Model.IsPersonaChanged(u.Id);
                            var resetTitle = changed
                                ? "Изменено: " + string.Join(", ", Model.PersonaChanges[u.Id]) + ". Сбросить — вернуть в исходное состояние (id не меняется)"
                                : "Не менялся — совпадает с исходным состоянием";
                            <form method="post" asp-page-handler="ResetPersona" asp-route-show="@Model.Show" class="inline"
                                  data-confirm="Вернуть @u.DisplayName в исходное состояние? Всё, что на нём поменяли руками (избранное, группы, медиа, опрос), будет стёрто."
                                  onsubmit="return confirm(this.dataset.confirm);">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button type="submit" class="admin-btn @(changed ? "admin-btn-primary" : "admin-btn-ghost opacity-50") py-1 px-2.5" title="@resetTitle">Сбросить</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="ForceSignOut" asp-route-show="@Model.Show" class="inline"
                              data-confirm="Отозвать все сессии пользователя @u.Email?"
                              onsubmit="return confirm(this.dataset.confirm);">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button type="submit" class="admin-btn admin-btn-ghost py-1 px-2.5" title="Разлогинить со всех устройств (аккаунт остаётся активным)">Выход везде</button>
                        </form>
                        @if (u.IsActive)
                        {
                            <form method="post" asp-page-handler="SetActive" asp-route-show="@Model.Show" class="inline"
                                  data-confirm="Отключить пользователя @u.Email? Все сессии будут отозваны немедленно."
                                  onsubmit="return confirm(this.dataset.confirm);">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="isActive" value="false" />
                                <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Отключить</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="SetActive" asp-route-show="@Model.Show" class="inline">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="isActive" value="true" />
                                <button type="submit" class="admin-btn admin-btn-primary py-1 px-2.5">Включить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ── Панель деталей: история логинов выбранного пользователя ── *@
@if (Model.Detail is { } d)
{
    <div class="admin-card mt-5">
        <div class="mb-3 flex items-center justify-between">
            <h3 class="font-semibold text-admin-text">
                История логинов — @d.DisplayName <span class="text-admin-text-muted font-normal">(@d.Email)</span>
            </h3>
            <a href="@Url.Page("Index", new { show = Model.Show })" class="admin-btn admin-btn-ghost py-1 px-2.5">Закрыть</a>
        </div>
        <div class="mb-3 flex flex-wrap gap-2 text-xs text-admin-text-muted">
            <span>Создан: @d.CreatedAt.ToString("dd.MM.yyyy")</span>
            <span>· Пароль: @(d.HasLocalPassword ? (d.LocalEmailConfirmed ? "есть (email подтверждён)" : "есть (email НЕ подтверждён)") : "нет")</span>
            @if (d.LocalFailedLoginCount > 0)
            {
                <span class="text-admin-warning">· Неудачных попыток подряд: @d.LocalFailedLoginCount</span>
            }
            @if (d.LocalLockoutEnd is { } lockout && lockout > DateTime.UtcNow)
            {
                <span class="text-admin-danger">· Lockout до @lockout.ToString("dd.MM HH:mm") UTC</span>
            }
        </div>
        @* ── Опрос «Who are you?» со страницы /setup-profile: только ответ о себе, прав не даёт
              (I'm a coach ≠ роль Coach). docs/plans/profile-setup-plan.md ── *@
        @{ var survey = Swimm.API.Pages.Admin.Users.IndexModel.SurveyAnswer(d); }
        <div class="mb-3 flex flex-wrap gap-2 text-xs text-admin-text-muted">
            <span title="Ответ пользователя о себе на странице Set up profile. Ни на что не влияет и прав не даёт">
                Кто он (опрос):
                @if (survey == null)
                {
                    <span>не отвечал</span>
                }
                else if (survey.Length == 0)
                {
                    <span>снял все ответы</span>
                }
                else
                {
                    <span class="font-semibold text-admin-text">@survey</span>
                }
            </span>
            @if (d.ProfileRolesAnsweredAt is { } answeredAt)
            {
                <span>· ответ от @answeredAt.ToString("dd.MM.yyyy")</span>
            }
            @if (d.ProfileSetupDismissedAt is { } dismissedAt)
            {
                <span>· Set up profile закрыт (Dismiss) @dismissedAt.ToString("dd.MM.yyyy")</span>
            }
        </div>
        @* ── Лимит групп: владение и персональное исключение (правило — HubGroupCreationRules) ── *@
        @{ var detailLimit = Model.EffectiveHubGroupLimit(d.Roles, d.HubGroupLimit); }
        <div class="mb-4 rounded-md border border-admin-border p-3">
            <div class="mb-2 text-sm text-admin-text">
                Группы: владеет <span class="font-semibold tabular-nums">@d.HubGroupsOwned</span>
                из <span class="font-semibold tabular-nums">@(detailLimit?.ToString() ?? "∞")</span>
                <span class="text-xs text-admin-text-muted">· @Swimm.API.Pages.Admin.Users.IndexModel.HubGroupLimitSource(d.Roles, d.HubGroupLimit)</span>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <form method="post" asp-page-handler="SetHubGroupLimit" asp-route-show="@Model.Show" class="flex flex-wrap items-center gap-2">
                    <input type="hidden" name="userId" value="@d.Id" />
                    <label for="hubGroupLimit" class="text-xs text-admin-text-muted">Персональный лимит</label>
                    <input id="hubGroupLimit" name="hubGroupLimit" type="number" step="1" min="0"
                           max="@Swimm.Application.Mapping.HubGroupCreationRules.MaxLimit"
                           value="@d.HubGroupLimit" placeholder="по роли" class="admin-input w-28" />
                    <button type="submit" class="admin-btn admin-btn-primary py-1 px-2.5">Сохранить</button>
                </form>
                @if (d.HubGroupLimit != null)
                {
                    <form method="post" asp-page-handler="SetHubGroupLimit" asp-route-show="@Model.Show" class="inline">
                        <input type="hidden" name="userId" value="@d.Id" />
                        <button type="submit" class="admin-btn admin-btn-ghost py-1 px-2.5" title="Снять исключение — будет действовать лимит по роли">Снять</button>
                    </form>
                }
            </div>
            <p class="mt-2 text-xs text-admin-text-muted">
                Пусто — лимит по роли, 0 — запретить создавать группы. Считаются группы, которыми
                пользователь владеет (официальные тоже); уже созданные при снижении лимита остаются.
            </p>
        </div>
        @* ── Удаление аккаунта по просьбе (privacy@, родитель) — тот же сервис и правило, что у
              кнопки «Delete account» на /setup-profile. docs/plans/account-deletion-plan.md, Р7 ── *@
        @if (Model.DeletionImpact is { } del)
        {
            var isAdminTarget = del.BlockReasons.Contains(Swimm.Application.Mapping.AccountDeletionRules.ReasonSiteAdmin);
            <div class="mb-4 rounded-md border border-admin-border p-3">
                <div class="mb-2 text-sm font-semibold text-admin-danger">Удалить аккаунт — насовсем</div>
                <p class="mb-2 text-xs text-admin-text-muted">
                    Уйдёт: избранное @del.Favorites, медиа @del.Media (опубликованных @del.PublishedMedia),
                    реакций @del.Reactions, участий в группах @del.GroupMemberships, админств @del.GroupAdminships,
                    своих групп без других людей @del.GroupsDeleted.Count.
                    Добавленное в чужие группы (@del.GroupContentKept) останется без автора. Результаты и пловцы не трогаются.
                </p>
                @if (isAdminTarget)
                {
                    <p class="text-xs text-admin-danger">У пользователя роль Admin — удалить нельзя, сначала снимите роль.</p>
                }
                else
                {
                    <form method="post" asp-page-handler="DeleteAccount" asp-route-show="@Model.Show" class="flex flex-wrap items-center gap-2"
                          data-confirm="Удалить аккаунт @d.Email насовсем? Отменить будет нельзя."
                          onsubmit="return confirm(this.dataset.confirm);">
                        <input type="hidden" name="userId" value="@d.Id" />
                        @if (del.SharedGroups.Count > 0)
                        {
                            <div class="mb-1 w-full text-xs text-admin-warning">
                                Владеет группами с другими людьми:
                                @string.Join(", ", del.SharedGroups.Select(g => $"«{g.Name}» (ещё {g.OtherPeople})")).
                                <label class="ml-1">
                                    <input type="checkbox" name="deleteSharedGroups" value="true" /> удалить и их
                                </label>
                            </div>
                        }
                        <input name="reason" placeholder="Причина: письмо privacy@@ от …" class="admin-input w-64" autocomplete="off" />
                        <input name="confirmEmail" placeholder="email удаляемого" class="admin-input w-64" autocomplete="off" />
                        <button type="submit" class="admin-btn admin-btn-danger py-1 px-2.5">Удалить</button>
                    </form>
                    <p class="mt-2 text-xs text-admin-text-muted">
                        Причина пишется в аудит <code>user.delete</code> — без email: аудит не должен хранить удалённое.
                    </p>
                }
            </div>
        }
        @if (d.LoginHistory.Count == 0)
        {
            <p class="text-sm text-admin-text-muted">Событий нет (журнал хранится 90 дней).</p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr><th>Когда (UTC)</th><th>Провайдер</th><th>IP</th><th>Результат</th></tr>
                </thead>
                <tbody>
                    @foreach (var h in d.LoginHistory)
                    {
                        <tr>
                            <td class="tabular-nums">@h.LoginAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td>@h.Provider</td>
                            <td class="font-mono text-xs">@(h.IpAddress ?? "—")</td>
                            <td>
                                @if (h.Success)
                                {
                                    <span class="admin-badge border-admin-success/30 bg-admin-success/15 text-admin-success">ok</span>
                                }
                                else
                                {
                                    <span class="admin-badge border-admin-danger/30 bg-admin-danger/15 text-admin-danger">fail</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}
