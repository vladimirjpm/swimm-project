@page
@model Swimm.API.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageSubtitle"] = "Здоровье данных";
}

<!-- Дашборд «Здоровье данных» — вариант 1c (master-detail): строки-блоки слева,
     sticky-панель деталей выбранного блока справа. См. docs/admin-pages/index.md
     и !design_handoff/design_handoff_data_health_dashboard/README.md. -->
<div class="flex items-start gap-5 mb-3">

    <!-- Левая колонка: строки-блоки (drag-reorder) + кастом-слот + системная строка -->
    <div class="flex-1 min-w-0 flex flex-col min-h-[520px]">
        <div id="dash-rows" class="flex flex-col gap-2.5"></div>

        <!-- Кастом-слот: задел под конфигурируемые SQL-счётчики, без функционала -->
        <div class="border border-dashed border-admin-border rounded-lg px-4 py-2.5 flex items-center gap-3.5 text-admin-text-muted mt-0.5">
            <span class="text-xs font-semibold text-admin-text-muted">＋ Кастом-карточка</span>
            <span class="text-[11px]">SQL-счётчик или очередь — добавляется конфигом.</span>
        </div>

        <div id="dash-system" class="mt-auto pt-3 border-t border-admin-border flex gap-6 flex-wrap text-[11px] text-admin-text-muted"></div>
    </div>

    <!-- Правая панель деталей выбранного блока -->
    <div id="dash-detail" class="admin-card w-[540px] flex-shrink-0 sticky top-6"></div>
</div>

<!-- Tabs -->
<div class="flex gap-2 mb-4">
    <button class="tab-btn active py-2 px-5 border border-admin-accent rounded-md bg-transparent text-admin-accent cursor-pointer text-sm transition-colors hover:bg-admin-accent/10" data-tab="users">👥 Users</button>
</div>

<!-- Users tab -->
<div class="tab-content active" id="tab-users">

    <!-- Filter bar -->
    <div class="admin-card flex gap-3 items-end flex-wrap px-4 py-3 mb-4">
        <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
            Поиск
            <input id="uf-search" type="text" list="dl-users" autocomplete="off"
                   class="admin-input w-48"
                   placeholder="Имя или email…">
            <datalist id="dl-users"></datalist>
        </label>
        <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
            Роль
            <select id="uf-role" class="admin-input w-32">
                <option value="">Все роли</option>
            </select>
        </label>
        <label class="text-xs text-admin-text-muted flex flex-col gap-0.5">
            Статус
            <select id="uf-status" class="admin-input w-28">
                <option value="">Все</option>
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
        </label>
        <span id="uf-count" class="text-xs text-admin-text-muted self-end pb-1"></span>
    </div>

    <!-- Table + Detail panel side-by-side -->
    <div class="flex gap-5 items-start">

        <!-- Table -->
        <div class="flex-1 min-w-0">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Registered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="users-body"></tbody>
            </table>
        </div>

        <!-- Detail panel (hidden by default) -->
        <div id="user-detail-panel" class="w-[300px] flex-shrink-0 hidden sticky top-4"></div>

    </div>
</div>

@section Scripts {
<script>
(async function () {
    const API = '/api/admin';
    let allUsers = [];
    let allRoles = [];
    let selectedUserId = null;

    // --- Helpers ---
    function fmtDate(iso) {
        if (!iso) return '—';
        return new Date(iso).toLocaleDateString('ru-RU');
    }
    function fmtDateTime(iso) {
        if (!iso) return '—';
        const d = new Date(iso);
        return d.toLocaleDateString('ru-RU') + ' ' + d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
    }
    function roleBadge(r) {
        const cls = r === 'Admin' ? 'bg-[#ff6b6b] text-white' : 'bg-[#4fc3f7] text-[#0f3460]';
        return `<span class="inline-block py-0.5 px-2 rounded text-xs font-semibold ${cls}">${esc(r)}</span>`;
    }

    // --- Дашборд «Здоровье данных» (1c: master-detail) ---
    // Нулевые метрики сворачиваются в чипы «✓ Название · 0».
    const COLLAPSE_ZERO = true;
    // Порог «рекорды устарели», месяцев.
    const RECORDS_STALE_MONTHS = 3;
    const ORDER_KEY = 'admin:dashboard:block-order';

    // Цвет значения метрики по семантике README: зелёный=0 проблем, оранжевый=есть работа,
    // красный=блокирующее, серый=не проверялось/долг, голубой=инфо.
    const TONE_CLS = {
        ok:     'text-admin-success',
        warn:   'text-admin-warning',
        danger: 'text-admin-danger',
        gray:   'text-admin-text-muted',
        info:   'text-admin-accent',
    };
    function toneCls(tone, v) { return TONE_CLS[v === 0 ? 'ok' : tone] || TONE_CLS.gray; }
    function fmtN(n) { return (n ?? 0).toLocaleString('ru-RU'); }
    function fmtDT(iso) {
        if (!iso) return '—';
        const d = new Date(iso);
        return d.toLocaleDateString('ru-RU') + ' ' + d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
    }

    let dashStatus = null;
    let dashOrder = null;   // массив ключей блоков в текущем порядке
    let dashSelected = null; // ключ выбранного блока
    let dashDrag = null;    // ключ блока, который тащат

    // Строит массив блоков 1c из DashboardStatusSummary. Каждый блок: key, title, href,
    // heroValue, heroSubs, metrics: [{ v, label, sub, tone, href, chip? }].
    function buildBlocks(s) {
        const sw = s.swimmers, cl = s.clubs, co = s.competitions, re = s.results,
              me = s.media, ug = s.usersGroups;

        return [
            buildChecksBlock(s.checks || null),
            {
                key: 'swimmers', title: 'Пловцы', href: '/Admin/Swimmers',
                heroValue: fmtN(sw.total),
                heroSubs: `isr ${fmtN(sw.originIsr)} · local ${fmtN(sw.originLocal)} · SYNTH ${fmtN(sw.synthetic)}`,
                metrics: [
                    { v: sw.unsureCandidates, label: 'Спорные дубли', sub: `уверенных: ${fmtN(sw.sureCandidates)}`, tone: 'warn', href: '/Admin/Swimmers?filter=dedup-unsure' },
                    { v: sw.orphans, label: 'Сироты', sub: 'без результатов/групп/медиа', tone: 'warn', href: '/Admin/Swimmers?filter=orphans' },
                    { v: sw.noOrgId, label: 'Без SwimmerOrgId', sub: 'isr без ID федерации', tone: 'warn', href: '/Admin/Swimmers?filter=no-org-id' },
                    { v: sw.noResults, label: 'Без результатов', sub: 'ни одного заплыва', tone: 'warn', href: '/Admin/Swimmers?filter=no-results' },
                    { v: sw.loglig.unlinked, label: 'Loglig не привязано', sub: `на проверке ${fmtN(sw.loglig.suggested)} · отклонено ${fmtN(sw.loglig.rejected)}`, tone: 'info', href: '/Admin/Swimmers/Loglig?filter=loglig-unlinked' },
                ],
            },
            {
                key: 'clubs', title: 'Клубы', href: '/Admin/Clubs',
                heroValue: fmtN(cl.total),
                heroSubs: `реальных ${fmtN(cl.total - cl.pseudo)} · псевдо ${fmtN(cl.pseudo)}`,
                metrics: [
                    { v: cl.unsureCandidates, label: 'Спорные дубли', sub: `уверенных: ${fmtN(cl.sureCandidates)}`, tone: 'warn', href: '/Admin/Clubs?filter=dedup-unsure' },
                    { v: cl.noSwimmers, label: 'Без пловцов', sub: 'мусор после merge', tone: 'warn', href: '/Admin/Clubs?filter=no-swimmers' },
                    { v: cl.noCountry, label: 'Без страны', sub: 'CountryId is null', tone: 'gray', href: '/Admin/Clubs?filter=no-country' },
                    { v: cl.clubRequestsPending, label: 'Заявки на статус клуба', sub: 'pending — очередь админа', tone: 'warn', href: '/Admin/HubGroupClubRequests?status=pending' },
                ],
            },
            {
                key: 'competitions', title: 'Соревнования', href: '/Admin/Competitions',
                heroValue: fmtN(co.total),
                heroSubs: `с результатами ${fmtN(co.withResults)} · пустых ${fmtN(co.total - co.withResults)}`,
                metrics: [
                    { v: co.discoveryNew, label: 'Входящие не загружено', sub: 'discovery: new', tone: 'warn', href: '/Admin/Competitions?filter=discovery-new' },
                    { v: co.discoveryErrors, label: 'Discovery с ошибкой', sub: 'LastError != null', tone: 'danger', href: '/Admin/Competitions?filter=discovery-error' },
                    { v: co.duplicateStandings, label: 'Дубль клубного зачёта', sub: 'два ❄ или ☀ у группы за сезон — ошибка в 🏆/бассейне', tone: 'danger', href: '/Admin/Competitions?kind=champ' },
                    { v: co.noOrgCompId, label: 'Без OrgCompId', sub: 'долг бэкфилла', tone: 'gray', href: '/Admin/Competitions?filter=no-org-comp-id' },
                    { v: co.total - co.withResults, label: 'Без результатов', sub: 'импорт упал/забыт', tone: 'warn', href: '/Admin/Competitions?filter=no-results' },
                    { v: co.discoveryIgnored, label: 'Ignored', sub: '', tone: 'gray', chip: true, href: '/Admin/Competitions?filter=ignored' },
                ],
            },
            buildClubPointsBlock(s.clubPoints || null),
            {
                key: 'results', title: 'Результаты', href: '/Admin/Results',
                heroValue: fmtN(re.total),
                heroSubs: `TimeFail (DQ/DNS/DNF) ${fmtN(re.timeFail)}`,
                metrics: [
                    { v: re.fkAnomalies, label: 'FK-аномалии', sub: 'без клуба / без пловца', tone: 'danger', href: '/Admin/Results?filter=fk-anomaly' },
                    { v: re.emptyRelays, label: 'Эстафеты без участников', sub: 'Relay без RelayMember', tone: 'warn', href: '/Admin/Results?filter=empty-relay' },
                ],
            },
            buildRecordsBlock(s.recordSets || [], s.recordQuality || null),
            {
                key: 'media', title: 'Медиа', href: '/Admin/Media',
                heroValue: fmtN(me.total),
                heroSubs: `видео ${fmtN(me.video)} · фото ${fmtN(me.photo)}`,
                metrics: [
                    { v: me.broken, label: 'Битые ссылки', sub: 'LinkOk = false', tone: 'danger', href: '/Admin/Media?filter=broken-links' },
                    { v: me.unchecked, label: 'Не проверялось', sub: 'LinkCheckedAt is null', tone: 'gray', href: '/Admin/Media?filter=unchecked' },
                    { v: me.moderationPending, label: 'На модерации', sub: 'pending visibility — очередь', tone: 'warn', href: '/Admin/Media?filter=moderation-pending' },
                ],
            },
            {
                key: 'usersGroups', title: 'Пользователи и группы', href: '/Admin/Users',
                heroValue: fmtN(ug.usersTotal),
                heroSubs: `активных за 7 дн ${fmtN(ug.active7d)} · деактив. ${fmtN(ug.deactivated)}`,
                metrics: [
                    { v: ug.joinRequestsPending, label: 'Заявки на вступление', sub: 'approval-группы', tone: 'warn', href: '/Admin/HubGroups?tab=requests' },
                    { v: ug.groupsTotal, label: 'Группы', sub: `официальных ${fmtN(ug.groupsOfficial)}`, tone: 'info', href: '/Admin/HubGroups' },
                ],
            },
        ];
    }

    // Блок «Проверки данных» — сводка реестра (docs/data-integrity.md, Д3). Дашборд НЕ считает
    // это сам: числа берутся из последнего прогона, потому дата прогона стоит на видном месте.
    // Прогонов не было — говорим об этом прямо: нули тут читались бы как «всё чисто».
    function buildChecksBlock(c) {
        const neverRan = !c || !c.lastRunAt;
        const open = neverRan ? 0 : c.errors + c.warnings + c.infos;

        const metrics = neverRan ? [] : [
            { v: c.errors, label: 'Ошибки', sub: 'испорченные данные', tone: 'danger', href: '/Admin/Health' },
            { v: c.warnings, label: 'Предупреждения', sub: 'подозрительно — смотреть глазами', tone: 'warn', href: '/Admin/Health' },
            { v: c.infos, label: 'Инфо', sub: 'есть что почистить', tone: 'gray', href: '/Admin/Health' },
        ];
        if (!neverRan && c.failedChecks) {
            metrics.push({ v: c.failedChecks, label: 'Проверки упали', sub: 'их числа недостоверны', tone: 'danger', href: '/Admin/Health' });
        }

        // Разбивка по проверкам — только в панели деталей: в строке она не поместится.
        const lines = (c && c.lines || []).map(l =>
            `<a href="/Admin/Health" class="flex items-baseline gap-3 py-1.5 px-2 no-underline hover:bg-admin-surface-hover rounded-md">
                <span class="w-14 text-right text-[13px] font-bold ${l.failed ? TONE_CLS.danger : TONE_CLS[['gray', 'warn', 'danger'][l.severity]]}">${l.failed ? '—' : fmtN(l.total)}</span>
                <span class="flex-1 min-w-0 font-mono text-[11px] text-admin-text-muted">${esc(l.checkId)}</span>
                ${l.failed ? '<span class="text-admin-danger text-[11px]">не выполнилась</span>' : ''}
            </a>`).join('');

        return {
            key: 'checks', title: 'Проверки данных', href: '/Admin/Health',
            heroValue: neverRan ? '—' : fmtN(open),
            // esc не нужен: renderDashDetail экранирует heroSubs сам.
            heroSubs: neverRan
                ? 'прогонов не было — открой /Admin/Health и нажми «Прогнать»'
                : `прогон ${fmtDT(c.lastRunAt)} · ${c.lastRunTrigger || ''}`,
            metrics,
            extraDetailHtml: lines
                ? `<div class="mt-3 text-admin-text-muted/70 text-[11px] uppercase tracking-wide px-2">По проверкам</div>${lines}`
                : '',
        };
    }

    // Блок «Клубные очки» — итоги ручной сверки зачёта с официальным (admin-pages/pointsrules.md).
    // Соревнование с расхождением — единственное место, где сайт ПУБЛИЧНО спорит с федерацией,
    // поэтому они перечислены поимённо в панели деталей, а не свёрнуты в счётчик.
    function buildClubPointsBlock(cp) {
        if (!cp) return { key: 'clubPoints', title: 'Клубные очки', href: '/Admin/PointsRules',
                          heroValue: '—', heroSubs: 'нет данных', metrics: [] };

        const metrics = [
            { v: cp.mismatchEvents, label: 'Расходятся с официальным', sub: 'сверено вручную, верны наши', tone: 'warn', href: '/Admin/PointsRules?kind=clubs&filter=mismatch' },
            // Бейдж «★ расхождение» без пояснения читатель проверить не может — это долг.
            { v: cp.mismatchWithoutNote, label: 'Без пояснения', sub: 'бейдж на витрине без доказательства', tone: 'danger', href: '/Admin/PointsRules?kind=clubs&filter=mismatch' },
            { v: cp.noRuleEvents, label: 'Без правила очков', sub: 'клубный зачёт такого соревнования пуст', tone: 'warn', href: '/Admin/Competitions' },
            { v: cp.uncheckedEvents, label: 'Не сверялось', sub: 'правило есть, глазами не смотрели', tone: 'gray', href: '/Admin/PointsRules?kind=clubs&filter=none' },
        ];

        const rows = (cp.mismatches || []).map(m => {
            // Эталона может не быть: он приезжает только из пособытийного источника loglig.
            const diff = m.officialPoints == null ? null : m.ourPoints - m.officialPoints;
            const diffTxt = diff == null
                ? 'эталона нет — величина расхождения только в пояснении'
                : `наши ${fmtN(m.ourPoints)} · официальные ${fmtN(m.officialPoints)} · ${diff > 0 ? '+' : ''}${fmtN(diff)}` +
                  (m.mismatchedRows ? ` · строк ${fmtN(m.mismatchedRows)}` : '');
            return `<div class="py-2 px-2 rounded-md hover:bg-admin-surface-hover">
                <div class="flex items-baseline gap-2">
                    <a href="/competitions/${m.competitionId}" target="_blank" rel="noopener"
                       class="flex-1 min-w-0 truncate text-[13px] text-admin-text no-underline hover:text-admin-accent">${esc(m.name)}</a>
                    <span class="text-[11px] text-admin-text-muted whitespace-nowrap">${esc(m.date)}</span>
                </div>
                <div class="text-[11px] text-admin-text-muted mt-0.5">${esc(diffTxt)}</div>
                ${m.hasNote
                    ? ''
                    : '<div class="text-[11px] text-admin-danger mt-0.5">пояснения нет — бейдж без доказательства</div>'}
            </div>`;
        }).join('');

        return {
            key: 'clubPoints', title: 'Клубные очки', href: '/Admin/PointsRules',
            heroValue: fmtN(cp.mismatchEvents),
            heroSubs: `сверено ${fmtN(cp.verifiedEvents)} · принято ${fmtN(cp.acceptedEvents)} · не сверялось ${fmtN(cp.uncheckedEvents)}`,
            metrics,
            extraDetailHtml: rows
                ? `<div class="mt-3 text-admin-text-muted/70 text-[11px] uppercase tracking-wide px-2">Где спорим с федерацией</div>${rows}`
                : '',
        };
    }

    // Заголовок набора рекордов: world → «World», country/ISR → «Israel», иначе «type:code».
    function recordSetTitle(rs) {
        if (rs.regionType === 'world') return 'World';
        if (rs.regionType === 'country' && rs.regionCode === 'ISR') return 'Israel';
        return `${rs.regionType}:${rs.regionCode}`;
    }
    function recordSetHref(rs) {
        if (rs.regionType === 'world') return '/Admin/Records?region=world';
        if (rs.regionType === 'country' && rs.regionCode === 'ISR') return '/Admin/Records?region=israel';
        return '/Admin/Records';
    }
    function isRecordSetStale(rs) {
        const ms = Date.now() - new Date(rs.lastUpdatedAt).getTime();
        return ms > RECORDS_STALE_MONTHS * 30.4 * 24 * 3600 * 1000;
    }

    function buildRecordsBlock(recordSets, quality) {
        const metrics = recordSets.map(rs => {
            const stale = isRecordSetStale(rs);
            return {
                v: rs.count,
                label: recordSetTitle(rs),
                sub: `обновлено ${fmtDT(rs.lastUpdatedAt)}${stale ? ` · устарело (> ${RECORDS_STALE_MONTHS} мес)` : ''}`,
                tone: stale ? 'gray' : 'info',
                href: recordSetHref(rs),
            };
        });
        // Качество справочника: спорные записи + сверка с нашими протоколами.
        // ⚠ «Не найдено» НЕ означает ошибку источника — протоколы загружены не за все годы,
        // поэтому тон серый (нейтральный), а не warning. Формулировку не «улучшать».
        if (quality) {
            metrics.push({
                v: quality.issuesOpen, label: 'Спорные записи',
                sub: quality.issuesTotal > quality.issuesOpen
                    ? `открытых из ${fmtN(quality.issuesTotal)} · ошибки источника не чиним`
                    : 'ошибки источника не чиним, а помечаем',
                tone: 'warn', href: '/Admin/Records?filter=issues',
            });
            metrics.push({
                v: quality.found - quality.foundWrongDate, label: 'Подтверждены протоколом',
                sub: 'нашёлся заплыв с этим временем и в этот день',
                tone: 'info', href: '/Admin/Records',
            });
            metrics.push({
                // Время встречается часто, поэтому совпадение без даты — слабый сигнал,
                // а не подтверждение: скорее всего это чужой заплыв с тем же временем.
                v: quality.foundWrongDate, label: 'Время совпало, дата другая',
                sub: 'слабое совпадение — смотреть глазами',
                tone: 'gray', href: '/Admin/Records',
            });
            metrics.push({
                v: quality.notFound, label: 'Не найдены в протоколах',
                sub: 'данные загружены не за все годы — это НЕ баг',
                tone: 'gray', href: '/Admin/Records',
            });
        }
        return {
            key: 'records', title: 'Рекорды', href: '/Admin/Records',
            heroValue: fmtN(recordSets.reduce((a, r) => a + r.count, 0)),
            heroSubs: recordSets.map(recordSetTitle).join(' · ') || 'нет наборов',
            metrics,
            extraDetailHtml: renderRecordsCheck() + renderRecordQuality(quality),
        };
    }

    // --- «Проверить апдейты» рекордов: синхронный dry-run fetch+дифф по трём источникам ---
    // Дифф НЕ пишется в БД (fetch только строит превью, см. RecordsImportController);
    // применение — на /Admin/Import. Состояние живёт в recCheck и переживает переключение блоков.
    const REC_SOURCES = [
        { key: 'worldrecords',   label: 'World Aquatics',   pool: '25m' },
        { key: 'isrorg-age',     label: 'Age (isr.org.il)', pool: '25m' },
        { key: 'isrorg-masters', label: 'Masters (isr.org.il)', pool: '50m' },
    ];
    let recCheck = { status: 'idle', src: {}, total: 0 };

    function renderRecordsCheck() {
        const running = recCheck.status === 'running';
        const rows = REC_SOURCES.map(s => {
            const st = recCheck.src[s.key];
            let mark = '<span class="text-admin-text-muted/60">·</span>';
            let note = '';
            if (st?.state === 'running') mark = '<span class="inline-block w-2.5 h-2.5 rounded-full border-2 border-admin-accent/25 border-t-admin-accent animate-spin"></span>';
            else if (st?.state === 'ok') { mark = '<span class="text-admin-success">✓</span>'; note = st.changes > 0 ? `+${st.added} / ~${st.changed}` : 'без изменений'; }
            else if (st?.state === 'err') { mark = '<span class="text-admin-danger">✗</span>'; note = st.error; }
            return `<div class="flex items-center gap-2 text-[12px] py-0.5">
                <span class="w-3 flex-shrink-0 text-center">${mark}</span>
                <span class="text-admin-text">${esc(s.label)}</span>
                <span class="text-admin-text-muted truncate">${esc(note)}</span></div>`;
        }).join('');
        const summary = recCheck.status === 'done'
            ? (recCheck.total > 0
                ? `<a href="/Admin/Import?diff=records" class="text-admin-warning text-[12px] font-semibold no-underline hover:underline">Найдено изменений: ${recCheck.total} → дифф в /Admin/Import</a>`
                : `<span class="text-admin-success text-[12px]">Изменений нет — рекорды актуальны.</span>`)
            : '';
        return `<div class="mt-3">
            <button id="btn-check-records" ${running ? 'disabled' : ''}
                class="admin-btn admin-btn-primary text-sm ${running ? 'opacity-50 cursor-not-allowed' : ''}">${running ? 'Проверяю…' : 'Проверить апдейты'}</button>
            ${recCheck.status !== 'idle' ? `<div class="mt-2">${rows}</div>` : ''}
            ${summary ? `<div class="mt-1.5">${summary}</div>` : ''}</div>`;
    }

    // --- Качество рекордов: сверка с протоколами + реестр спорных записей ---
    // docs/plans/records-quality-plan.md. Ошибки федерации НЕ чиним: наша копия обязана
    // совпадать с источником, иначе следующий импорт вернёт всё назад.
    let recVerify = { status: 'idle', text: '' };

    function renderRecordQuality(q) {
        if (!q) return '';
        const issues = (q.issues || []).map(i => `
            <div class="py-1 border-t border-admin-border/60">
                <div class="text-[12px] text-admin-text">
                    <span class="font-semibold">${esc(i.style)} ${esc(i.distance)}</span>
                    · ${esc(i.poolType)} · ${esc(i.gender === 'female' ? '♀' : '♂')}
                    · ${esc(i.category)}${i.ageKey ? ' ' + esc(i.ageKey) : ''}
                    <span class="text-admin-warning font-semibold ml-1">${esc(i.flaggedTime)}</span>
                </div>
                <div class="text-[11px] text-admin-text-muted line-clamp-2">${esc(i.note)}</div>
            </div>`).join('');
        const running = recVerify.status === 'running';
        return `<div class="mt-4 pt-3 border-t border-admin-border">
            <div class="text-[12px] font-semibold text-admin-text mb-1">Сверка с протоколами</div>
            <div class="text-[11px] text-admin-text-muted mb-2">
                Последняя сверка: ${q.lastCheckedAt ? esc(fmtDT(q.lastCheckedAt)) : 'не запускалась'}.
                «Не найдено» — это не ошибка справочника: у нас загружены не все годы.
            </div>
            <button id="btn-verify-records" ${running ? 'disabled' : ''}
                class="admin-btn text-sm ${running ? 'opacity-50 cursor-not-allowed' : ''}">${running ? 'Сверяю…' : 'Сверить с протоколами'}</button>
            ${recVerify.text ? `<div class="mt-1.5 text-[12px] text-admin-text-muted">${esc(recVerify.text)}</div>` : ''}
            ${renderAgeAxis(q)}
            ${issues ? `<div class="mt-3"><div class="text-[12px] font-semibold text-admin-text mb-1">Спорные записи (open)</div>${issues}</div>` : ''}
        </div>`;
    }

    // Ось возраста ступеней: по какой оси ступень справочника сходится с найденным пловцом.
    // Оси различимы только у заплывов сентября–декабря, поэтому «обе» — самая частая метка
    // и она НИЧЕГО не говорит об источнике. Смотреть надо на «только календарная» vs
    // «только сезонная» (docs/data-integrity.md §13).
    function renderAgeAxis(q) {
        if (!q || !q.ageAxisChecked) return '';

        const axisLabel = q.ageAxis === 'season'
            ? 'сезонная (год окончания сезона)'
            : 'календарная (год заплыва, как федерация)';
        const decisive = q.ageAxisCalendarOnly + q.ageAxisSeasonOnly;
        const mismatchCls = q.ageAxisMismatch > 0 ? 'text-admin-warning' : 'text-admin-text-muted';

        return `<div class="mt-3 pt-2 border-t border-admin-border/60">
            <div class="text-[12px] font-semibold text-admin-text mb-1">Ось возраста ступеней</div>
            <div class="text-[11px] text-admin-text-muted mb-1">
                Текущая настройка RecordAgeAxis: <span class="text-admin-text">${esc(axisLabel)}</span>.
                Проверено ступеней: ${fmtN(q.ageAxisChecked)}.
            </div>
            <div class="text-[12px] text-admin-text">
                Различают ось: <span class="font-semibold">${fmtN(decisive)}</span>
                → календарная <span class="font-semibold">${fmtN(q.ageAxisCalendarOnly)}</span>
                · сезонная <span class="font-semibold">${fmtN(q.ageAxisSeasonOnly)}</span>
            </div>
            <div class="text-[11px] text-admin-text-muted">
                Обе оси совпали (заплыв янв–авг): ${fmtN(q.ageAxisBoth)} ·
                ступень не сошлась вовсе: ${fmtN(q.ageAxisNone)}
            </div>
            <div class="text-[12px] mt-1 ${mismatchCls}">
                Не сходится с текущей осью: <span class="font-semibold">${fmtN(q.ageAxisMismatch)}</span>
                ${q.ageAxisMismatch > 0 ? ' — на этих записях сверка попадёт не в ту строку справочника' : ''}
            </div>
        </div>`;
    }

    async function verifyRecords() {
        recVerify = { status: 'running', text: '' };
        renderRows();
        try {
            const res = await fetch('/api/admin/records/verify', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'X-XSRF-TOKEN': _csrfToken }
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
            recVerify = { status: 'done', text: `Проверено ${data.checked}: найдено ${data.found}, не найдено ${data.notFound}${data.foundWrongDate ? `, с другой датой ${data.foundWrongDate}` : ''}. Перезагрузите страницу, чтобы обновить счётчики.` };
        } catch (e) {
            recVerify = { status: 'done', text: `Ошибка: ${e.message}` };
        }
        renderRows();
    }

    async function checkRecordUpdates() {
        recCheck = { status: 'running', src: {}, total: 0 };
        REC_SOURCES.forEach(s => recCheck.src[s.key] = { state: 'wait' });
        renderRows();
        for (const s of REC_SOURCES) {
            recCheck.src[s.key] = { state: 'running' };
            renderRows();
            try {
                const form = new FormData();
                form.append('source', s.key);
                form.append('poolType', s.pool);
                const res = await fetch('/api/admin/records/fetch', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'X-XSRF-TOKEN': _csrfToken }, body: form
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
                const added = data.addedCount || 0, changed = data.changedCount || 0;
                recCheck.src[s.key] = { state: 'ok', added, changed, changes: added + changed };
                recCheck.total += added + changed;
            } catch (e) {
                recCheck.src[s.key] = { state: 'err', error: e.message };
            }
            renderRows();
        }
        recCheck.status = 'done';
        renderRows();
    }

    function buildSystemItems(sys) {
        return [
            { label: 'Последний импорт', val: `${fmtDT(sys.lastImportAt)}${sys.lastImportAt ? (sys.lastImportApproved ? ' · OK' : ' · ?') : ''}`, href: '/Admin/ImportHistory', warn: false },
            { label: 'Проверка медиа-ссылок', val: fmtDT(sys.lastMediaCheckAt), href: '/Admin/Media?filter=unchecked', warn: false },
            { label: 'Discovery-скан', val: fmtDT(sys.lastDiscoverySeenAt), href: '/Admin/Competitions?filter=discovery-new', warn: false },
            { label: 'Действия audit за 7 дней', val: fmtN(sys.auditActions7d), href: '/Admin/Audit?period=7d', warn: sys.auditActions7d > 0 },
        ];
    }

    // --- Рендер: строка блока (мини-пилюли метрик) ---
    function renderMini(m) {
        if (m.chip || (m.v === 0 && COLLAPSE_ZERO)) {
            const cls = m.v === 0 ? 'text-admin-success border-admin-success/35' : `${toneCls(m.tone, m.v)} border-current/35`;
            const mark = m.v === 0 ? '✓ ' : '';
            return `<span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${cls}">${mark}${esc(m.label)} · ${fmtN(m.v)}</span>`;
        }
        return `<span class="inline-flex items-center gap-1 bg-admin-bg border border-admin-border rounded-md px-2.5 py-1 text-[11px] whitespace-nowrap">
            <span class="font-bold text-[13px] ${toneCls(m.tone, m.v)}">${fmtN(m.v)}</span>
            <span class="text-admin-text-muted">${esc(m.label)}</span></span>`;
    }

    function renderRow(b, isSelected) {
        const rowCls = isSelected
            ? 'bg-[#20242e] border-admin-accent'
            : 'bg-admin-surface border-admin-border hover:border-admin-accent/50';
        return `<div data-key="${b.key}" draggable="false"
                class="flex items-center gap-3.5 rounded-lg border px-4 py-3 cursor-pointer transition-colors ${rowCls}">
            <span draggable="true" data-drag-handle="1" title="Перетащить — изменить порядок; первый блок открывает детали автоматически"
                  class="cursor-grab text-admin-text-muted/70 hover:text-admin-accent select-none px-0.5 flex-shrink-0 text-[15px] leading-none">⠿</span>
            <div class="w-[190px] flex-shrink-0">
                <div class="text-admin-text text-[13px] font-semibold">${esc(b.title)}</div>
                <div class="text-admin-text text-xl font-bold mt-0.5">${b.heroValue}</div>
            </div>
            <div class="flex-1 flex flex-wrap gap-1.5 items-center min-w-0">${b.metrics.map(renderMini).join('')}</div>
            <div class="text-admin-text-muted/60 text-sm flex-shrink-0">›</div>
        </div>`;
    }

    function renderDetailRow(m) {
        return `<a href="${m.href}" class="flex items-baseline gap-3 py-2.5 px-2 border-b border-admin-border/70 rounded-md hover:bg-admin-surface-hover no-underline">
            <span class="w-14 text-right text-[17px] font-bold ${toneCls(m.tone, m.v)}">${fmtN(m.v)}</span>
            <span class="flex-1 min-w-0"><span class="text-admin-text text-[13px]">${esc(m.label)}</span>${m.sub ? `<span class="text-admin-text-muted/70 text-[11px]"> — ${esc(m.sub)}</span>` : ''}</span>
            <span class="text-admin-accent text-[11px] whitespace-nowrap">${m.href.replace(/^\/Admin/, '')} →</span>
        </a>`;
    }

    function renderDashDetail(b) {
        document.getElementById('dash-detail').innerHTML = `
            <a href="${b.href}" class="text-white text-base font-semibold no-underline hover:text-admin-accent">${esc(b.title)}</a>
            <a href="${b.href}" class="block text-admin-accent text-xs mt-0.5 hover:text-[#81d4fa] no-underline">${b.href} →</a>
            <div class="flex items-baseline gap-2.5 mt-3.5 mb-1">
                <span class="text-admin-text text-[34px] font-bold leading-none">${b.heroValue}</span>
                <span class="text-admin-text-muted text-xs">${esc(b.heroSubs)}</span>
            </div>
            <div class="flex flex-col mt-3">${b.metrics.map(renderDetailRow).join('')}</div>
            ${b.extraDetailHtml || ''}
            <div class="mt-4 border border-dashed border-[#3a3f4c] rounded-lg h-[100px] flex items-center justify-center text-admin-text-muted/70 font-mono text-[11px]">тренд метрики по снапшотам — v2</div>`;
    }

    function renderSystem(s) {
        document.getElementById('dash-system').innerHTML = buildSystemItems(s).map(i =>
            `<a href="${i.href}" class="no-underline hover:text-admin-text-muted">${esc(i.label)}: <span class="${i.warn ? 'text-admin-warning' : 'text-admin-text-muted'}">${esc(i.val)}</span></a>`
        ).join('');
    }

    // --- Порядок блоков (localStorage) ---
    function loadOrder(keys) {
        let order;
        try { order = JSON.parse(localStorage.getItem(ORDER_KEY) || 'null'); } catch { order = null; }
        if (!Array.isArray(order)) order = [];
        // оставляем только реально существующие ключи, сохраняя сохранённый порядок
        order = order.filter(k => keys.includes(k));
        // дописываем недостающие (новые блоки) в дефолтном порядке в конец
        keys.forEach(k => { if (!order.includes(k)) order.push(k); });
        return order;
    }
    function saveOrder(order) {
        localStorage.setItem(ORDER_KEY, JSON.stringify(order));
    }

    function renderRows() {
        const blocks = buildBlocks(dashStatus);
        const byKey = Object.fromEntries(blocks.map(b => [b.key, b]));
        if (!dashOrder) dashOrder = loadOrder(blocks.map(b => b.key));
        if (dashSelected == null) dashSelected = dashOrder[0];

        const rowsHtml = dashOrder.map(k => renderRow(byKey[k], k === dashSelected)).join('');
        document.getElementById('dash-rows').innerHTML = rowsHtml;
        renderDashDetail(byKey[dashSelected] || blocks[0]);
        renderSystem(dashStatus.system);
        wireRowEvents(byKey);
    }

    function wireRowEvents(byKey) {
        const container = document.getElementById('dash-rows');
        container.querySelectorAll('[data-key]').forEach(row => {
            const key = row.dataset.key;
            row.addEventListener('click', (e) => {
                if (e.target.closest('[data-drag-handle]')) return;
                dashSelected = key;
                renderRows();
            });
            row.addEventListener('dragover', (e) => e.preventDefault());
            row.addEventListener('drop', (e) => {
                e.preventDefault();
                if (dashDrag == null || dashDrag === key) return;
                const from = dashOrder.indexOf(dashDrag);
                const to = dashOrder.indexOf(key);
                if (from < 0 || to < 0) return;
                const order = [...dashOrder];
                const [moved] = order.splice(from, 1);
                order.splice(to, 0, moved);
                dashOrder = order;
                dashSelected = order[0]; // первый блок после drag открывает свои детали
                saveOrder(dashOrder);
                dashDrag = null;
                renderRows();
            });
            const handle = row.querySelector('[data-drag-handle]');
            handle.addEventListener('dragstart', (e) => {
                dashDrag = key;
                e.dataTransfer.effectAllowed = 'move';
            });
            handle.addEventListener('dragend', () => { dashDrag = null; });
        });
    }

    async function loadStatus() {
        dashStatus = await api(`${API}/dashboard/status`);
        renderRows();
    }

    // Кнопка живёт внутри перерисовываемой панели — слушаем контейнер (делегирование).
    document.getElementById('dash-detail').addEventListener('click', (e) => {
        if (e.target.closest('#btn-check-records') && recCheck.status !== 'running')
            checkRecordUpdates();
        if (e.target.closest('#btn-verify-records') && recVerify.status !== 'running')
            verifyRecords();
    });

    // --- Filters ---
    function getFiltered() {
        const q     = document.getElementById('uf-search').value.toLowerCase().trim();
        const role  = document.getElementById('uf-role').value;
        const stat  = document.getElementById('uf-status').value;
        return allUsers.filter(u => {
            if (q && !u.displayName.toLowerCase().includes(q) && !u.email.toLowerCase().includes(q)) return false;
            if (role && !u.roles.includes(role)) return false;
            if (stat === '1' && !u.isActive) return false;
            if (stat === '0' && u.isActive)  return false;
            return true;
        });
    }

    function applyFilters() {
        const filtered = getFiltered();
        const cnt = document.getElementById('uf-count');
        cnt.textContent = filtered.length !== allUsers.length
            ? `${filtered.length} из ${allUsers.length}`
            : `${allUsers.length} польз.`;
        renderTable(filtered);
    }

    function populateRoleFilter() {
        const sel = document.getElementById('uf-role');
        // remove old dynamic options
        while (sel.options.length > 1) sel.remove(1);
        allRoles.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.name; opt.textContent = r.name;
            sel.appendChild(opt);
        });
    }

    function populateUserDatalist() {
        const dl = document.getElementById('dl-users');
        const vals = [...new Set([
            ...allUsers.map(u => u.displayName),
            ...allUsers.map(u => u.email)
        ])].sort();
        dl.innerHTML = vals.map(v => `<option value="${esc(v)}"></option>`).join('');
    }

    // --- Table ---
    function renderTable(users) {
        document.getElementById('users-body').innerHTML = users.map(u => {
            const sel = u.id === selectedUserId;
            const rolesHtml = u.roles.map(roleBadge).join(' ') || '<span class="text-[#546e7a] text-xs">—</span>';
            const statusHtml = u.isActive
                ? '<span class="text-[#66bb6a] text-xs font-semibold">Active</span>'
                : '<span class="inline-block py-0.5 px-2 rounded text-xs font-semibold bg-[#546e7a] text-[#cfd8dc]">Inactive</span>';
            const avatarHtml = u.avatarUrl
                ? `<img class="w-6 h-6 rounded-full align-middle mr-1.5 inline-block" src="${esc(u.avatarUrl)}" alt="">`
                : '';

            const missingRoles = allRoles.filter(r => !u.roles.includes(r.name));
            const addBtns = missingRoles.map(r =>
                `<button class="py-0.5 px-2 rounded text-xs text-white bg-[#66bb6a] hover:opacity-80 transition-opacity"
                    onclick="event.stopPropagation();addRole(${u.id},${r.id})">+ ${esc(r.name)}</button>`
            ).join('');
            const removeBtns = u.roles.map(rName => {
                const role = allRoles.find(r => r.name === rName);
                return role
                    ? `<button class="py-0.5 px-2 rounded text-xs text-white bg-[#ef5350] hover:opacity-80 transition-opacity"
                           onclick="event.stopPropagation();removeRole(${u.id},${role.id})">&minus; ${esc(rName)}</button>`
                    : '';
            }).join('');
            const toggleBtn = `<button class="py-0.5 px-2 rounded text-xs text-white bg-[#ffa726] hover:opacity-80 transition-opacity"
                onclick="event.stopPropagation();toggleActive(${u.id},${!u.isActive})">${u.isActive ? 'Disable' : 'Enable'}</button>`;

            const rowCls = sel
                ? 'border-b border-white/[.08] cursor-pointer bg-[#4fc3f7]/10'
                : 'border-b border-white/[.08] cursor-pointer hover:bg-white/[.04] transition-colors';

            return `<tr class="${rowCls}" data-uid="${u.id}" onclick="openDetail(${u.id})">
                <td class="py-2.5 px-3 text-sm">${avatarHtml}${esc(u.displayName)}</td>
                <td class="py-2.5 px-3 text-sm text-[#90a4ae]">${esc(u.email)}</td>
                <td class="py-2.5 px-3 text-sm">${rolesHtml}</td>
                <td class="py-2.5 px-3 text-sm">${statusHtml}</td>
                <td class="py-2.5 px-3 text-sm text-[#546e7a]">${fmtDate(u.createdAt)}</td>
                <td class="py-2.5 px-3 text-sm"><div class="flex gap-1 flex-wrap">${addBtns}${removeBtns}${toggleBtn}</div></td>
            </tr>`;
        }).join('');
    }

    // --- Actions ---
    window.addRole = async function (userId, roleId) {
        await api(`${API}/users/${userId}/roles/${roleId}`, { method: 'POST' });
        toast('Role added');
        await refreshUsers();
    };
    window.removeRole = async function (userId, roleId) {
        await api(`${API}/users/${userId}/roles/${roleId}`, { method: 'DELETE' });
        toast('Role removed');
        await refreshUsers();
    };
    window.toggleActive = async function (userId, isActive) {
        await api(`${API}/users/${userId}/active`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isActive })
        });
        toast(isActive ? 'User activated' : 'User deactivated');
        await refreshUsers();
    };

    async function refreshUsers() {
        allUsers = await api(`${API}/users`);
        populateUserDatalist();
        applyFilters();
        if (selectedUserId !== null) openDetail(selectedUserId);
    }

    // --- Detail panel ---
    window.openDetail = async function (userId) {
        selectedUserId = userId;
        // Re-render table to update highlight (filters keep current selection)
        const filtered = getFiltered();
        renderTable(filtered);

        const panel = document.getElementById('user-detail-panel');
        panel.classList.remove('hidden');
        panel.innerHTML = `<div class="bg-white/[.05] rounded-lg p-6 text-center text-[#90a4ae] text-sm">Загрузка…</div>`;

        try {
            const d = await api(`${API}/users/${userId}/details`);
            renderDetail(d);
        } catch (e) {
            panel.innerHTML = `<div class="bg-white/[.05] rounded-lg p-4 text-[#ef5350] text-sm">Ошибка: ${esc(e.message)}</div>`;
        }
    };

    window.closeDetail = function () {
        selectedUserId = null;
        document.getElementById('user-detail-panel').classList.add('hidden');
        applyFilters(); // re-render to remove highlight
    };

    function renderDetail(d) {
        const missingRoles = allRoles.filter(r => !d.roles.includes(r.name));
        const addBtns = missingRoles.map(r =>
            `<button class="py-0.5 px-2 rounded text-xs text-white bg-[#66bb6a] hover:opacity-80 transition-opacity"
                onclick="addRole(${d.id},${r.id})">+ ${esc(r.name)}</button>`
        ).join('');
        const removeBtns = d.roles.map(rName => {
            const role = allRoles.find(r => r.name === rName);
            return role
                ? `<button class="py-0.5 px-2 rounded text-xs text-white bg-[#ef5350] hover:opacity-80 transition-opacity"
                       onclick="removeRole(${d.id},${role.id})">&minus; ${esc(rName)}</button>`
                : '';
        }).join('');

        // Auth methods
        let authLines = '';
        d.externalLogins.forEach(e => {
            const verified = e.emailVerified
                ? '<span class="text-[#66bb6a] ml-1">✓</span>'
                : '<span class="text-[#ffa726] ml-1">?</span>';
            authLines += `<div class="flex items-center gap-2 text-xs py-1 border-b border-white/5">
                <span class="text-[#4fc3f7] font-semibold w-14 flex-shrink-0">${esc(e.provider)}</span>
                <span class="text-[#90a4ae] flex-1 truncate" title="${esc(e.email||'')}">${esc(e.email || '—')}</span>
                ${verified}
            </div>`;
        });
        if (d.hasLocalPassword) {
            const emailStatus = d.localEmailConfirmed
                ? '<span class="text-[#66bb6a]">подтверждён</span>'
                : '<span class="text-[#ffa726]">не подтверждён</span>';
            const failBadge = d.localFailedLoginCount > 0
                ? `<span class="text-[#ef5350] ml-1">${d.localFailedLoginCount}✗</span>` : '';
            const lockout = d.localLockoutEnd && new Date(d.localLockoutEnd) > new Date()
                ? `<div class="text-xs text-[#ef5350] mt-0.5">🔒 до ${fmtDateTime(d.localLockoutEnd)}</div>` : '';
            authLines += `<div class="text-xs py-1 border-b border-white/5">
                <span class="text-[#ce93d8] font-semibold">Local</span>
                <span class="text-[#90a4ae] ml-2">email: ${emailStatus}${failBadge}</span>
                ${lockout}
            </div>`;
        }
        if (!authLines) authLines = '<div class="text-xs text-[#546e7a]">Нет привязок</div>';

        // Login history
        let historyHtml = '';
        if (d.loginHistory.length > 0) {
            historyHtml = d.loginHistory.map(h => `
                <div class="flex items-center gap-2 text-xs py-0.5 border-b border-white/5">
                    <span class="text-[#4fc3f7] w-14 flex-shrink-0">${esc(h.provider)}</span>
                    <span class="text-[#546e7a] flex-1 truncate" title="${esc(h.ipAddress||'')}">${esc(h.ipAddress || '—')}</span>
                    <span class="text-[#90a4ae] whitespace-nowrap">${fmtDateTime(h.loginAt)}</span>
                </div>`).join('');
        } else {
            historyHtml = '<div class="text-xs text-[#546e7a]">История пуста</div>';
        }

        const avatarHtml = d.avatarUrl
            ? `<img src="${esc(d.avatarUrl)}" class="w-10 h-10 rounded-full flex-shrink-0" alt="">`
            : `<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-lg flex-shrink-0">👤</div>`;

        document.getElementById('user-detail-panel').innerHTML = `
        <div class="bg-white/[.05] rounded-lg p-4 text-sm">

            <!-- Header -->
            <div class="flex justify-between items-start mb-3">
                <div class="flex items-center gap-2.5 min-w-0">
                    ${avatarHtml}
                    <div class="min-w-0">
                        <div class="font-semibold leading-tight truncate">${esc(d.displayName)}</div>
                        <div class="text-xs text-[#90a4ae] truncate">${esc(d.email)}</div>
                    </div>
                </div>
                <button onclick="closeDetail()" class="text-[#546e7a] hover:text-white text-base leading-none flex-shrink-0 ml-2 mt-0.5" title="Закрыть">✕</button>
            </div>

            <!-- Meta -->
            <div class="flex gap-x-3 gap-y-0.5 items-center mb-4 text-xs flex-wrap">
                ${d.isActive
                    ? '<span class="text-[#66bb6a] font-semibold">● Active</span>'
                    : '<span class="text-[#ef5350] font-semibold">● Inactive</span>'}
                <span class="text-[#546e7a]">с ${fmtDate(d.createdAt)}</span>
                ${d.updatedAt ? `<span class="text-[#546e7a]">· обн. ${fmtDate(d.updatedAt)}</span>` : ''}
                ${d.swimmerId ? `<span class="text-[#90a4ae]">· 🏊 #${d.swimmerId}</span>` : ''}
            </div>

            <!-- Roles -->
            <div class="mb-4">
                <div class="text-xs uppercase text-[#546e7a] font-semibold mb-1.5 tracking-wide">Роли</div>
                <div class="flex gap-1 flex-wrap mb-1.5">
                    ${d.roles.map(roleBadge).join(' ') || '<span class="text-[#546e7a] text-xs">Нет</span>'}
                </div>
                <div class="flex gap-1 flex-wrap">${addBtns}${removeBtns}</div>
            </div>

            <!-- Auth -->
            <div class="mb-4">
                <div class="text-xs uppercase text-[#546e7a] font-semibold mb-1.5 tracking-wide">Auth</div>
                ${authLines}
            </div>

            ${d.linkedSwimmerName ? `
            <div class="mb-4">
                <div class="text-xs uppercase text-[#546e7a] font-semibold mb-1.5 tracking-wide">Спортсмен</div>
                <div class="text-sm">${esc(d.linkedSwimmerName)}</div>
            </div>` : ''}

            <!-- Login history -->
            <div class="mb-4">
                <div class="text-xs uppercase text-[#546e7a] font-semibold mb-1.5 tracking-wide">
                    История входов
                    ${d.loginHistory.length > 0 ? `<span class="text-[#546e7a] normal-case font-normal">(${d.loginHistory.length})</span>` : ''}
                </div>
                ${historyHtml}
            </div>

            <!-- Actions -->
            <div class="border-t border-white/10 pt-3">
                <button onclick="toggleActive(${d.id},${!d.isActive})"
                    class="py-1 px-3 rounded text-xs text-white cursor-pointer border-none transition-opacity hover:opacity-80 ${d.isActive ? 'bg-[#ef5350]' : 'bg-[#66bb6a]'}">
                    ${d.isActive ? 'Деактивировать' : 'Активировать'}
                </button>
            </div>
        </div>`;
    }

    // --- Tabs ---
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
        });
    });

    // --- Filter listeners ---
    ['uf-search', 'uf-role', 'uf-status'].forEach(id =>
        document.getElementById(id).addEventListener('input', applyFilters)
    );

    // --- Init ---
    try {
        // Deep-link с дашборда: ?filter=deactivated — вкладка Users с фильтром Inactive.
        if (new URLSearchParams(location.search).get('filter') === 'deactivated')
            document.getElementById('uf-status').value = '0';
        [allRoles] = await Promise.all([api(`${API}/roles`), loadStatus()]);
        populateRoleFilter();
        allUsers = await api(`${API}/users`);
        populateUserDatalist();
        applyFilters();
    } catch (e) {
        console.error('Admin init failed', e);
    }
})();
</script>
}
