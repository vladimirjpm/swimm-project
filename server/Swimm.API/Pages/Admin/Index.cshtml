@page
@model Swimm.API.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
    ViewData["HeaderTitle"] = "🔧 Swimm Admin";
    ViewData["TitleColor"] = "#ff6b6b";
    ViewData["BodyClass"] = "font-sans min-h-screen text-gray-300";
}

<div class="max-w-[1100px] mx-auto p-6">
    <!-- Stats -->
    <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-4 mb-8" id="stats-grid"></div>

    <!-- Tabs -->
    <div class="flex gap-2 mb-6">
        <button class="tab-btn active py-2 px-5 border border-[#4fc3f7] rounded-md bg-transparent text-[#4fc3f7] cursor-pointer text-sm transition-colors hover:bg-[rgba(79,195,247,0.12)]" data-tab="users">👥 Users</button>
    </div>

    <!-- Users tab -->
    <div class="tab-content active" id="tab-users">
        <table class="w-full border-collapse">
            <thead>
                <tr>
                    <th class="py-2.5 px-3 text-left border-b border-white/[.08] text-[#90a4ae] font-semibold text-xs uppercase">User</th>
                    <th class="py-2.5 px-3 text-left border-b border-white/[.08] text-[#90a4ae] font-semibold text-xs uppercase">Email</th>
                    <th class="py-2.5 px-3 text-left border-b border-white/[.08] text-[#90a4ae] font-semibold text-xs uppercase">Roles</th>
                    <th class="py-2.5 px-3 text-left border-b border-white/[.08] text-[#90a4ae] font-semibold text-xs uppercase">Status</th>
                    <th class="py-2.5 px-3 text-left border-b border-white/[.08] text-[#90a4ae] font-semibold text-xs uppercase">Registered</th>
                    <th class="py-2.5 px-3 text-left border-b border-white/[.08] text-[#90a4ae] font-semibold text-xs uppercase">Actions</th>
                </tr>
            </thead>
            <tbody id="users-body"></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(async function () {
    const API = '/api/admin';
    let allRoles = [];

    function formatDate(iso) {
        if (!iso) return '—';
        return new Date(iso).toLocaleDateString('ru-RU');
    }

    async function loadStats() {
        const s = await api(`${API}/stats`);
        const grid = document.getElementById('stats-grid');
        const items = [
            { label: 'Users', value: s.users },
            { label: 'Results', value: s.results.toLocaleString() },
            { label: 'Competitions', value: s.competitions },
            { label: 'Swimmers', value: s.swimmers.toLocaleString() },
            { label: 'Clubs', value: s.clubs },
        ];
        grid.innerHTML = items.map(i => `
            <div class="bg-white/[.07] rounded-[10px] p-5 text-center">
                <div class="text-3xl font-bold text-[#4fc3f7]">${i.value}</div>
                <div class="text-sm text-[#90a4ae] mt-1">${i.label}</div>
            </div>
        `).join('');
    }

    async function loadUsers() {
        const users = await api(`${API}/users`);
        const tbody = document.getElementById('users-body');

        tbody.innerHTML = users.map(u => {
            const rolesHtml = u.roles.map(r =>
                `<span class="inline-block py-0.5 px-2 rounded text-xs font-semibold ${r === 'Admin' ? 'bg-[#ff6b6b] text-white' : 'bg-[#4fc3f7] text-[#0f3460]'}">${r}</span> `
            ).join('');

            const statusHtml = u.isActive
                ? '<span style="color:#66bb6a">Active</span>'
                : '<span class="inline-block py-0.5 px-2 rounded text-xs font-semibold bg-[#546e7a] text-[#cfd8dc]">Inactive</span>';

            const avatarHtml = u.avatarUrl
                ? `<img class="w-7 h-7 rounded-full align-middle mr-1.5" src="${u.avatarUrl}" alt="">`
                : '';

            const missingRoles = allRoles.filter(r => !u.roles.includes(r.name));
            const addBtns = missingRoles.map(r =>
                `<button class="py-1 px-2.5 rounded border-none cursor-pointer text-xs text-white transition-opacity hover:opacity-80 bg-[#66bb6a]" onclick="addRole(${u.id}, ${r.id})">+ ${r.name}</button>`
            ).join('');

            const removeBtns = u.roles.map(rName => {
                const role = allRoles.find(r => r.name === rName);
                return role
                    ? `<button class="py-1 px-2.5 rounded border-none cursor-pointer text-xs text-white transition-opacity hover:opacity-80 bg-[#ef5350]" onclick="removeRole(${u.id}, ${role.id})">&minus; ${rName}</button>`
                    : '';
            }).join('');

            const toggleBtn = `<button class="py-1 px-2.5 rounded border-none cursor-pointer text-xs text-white transition-opacity hover:opacity-80 bg-[#ffa726]" onclick="toggleActive(${u.id}, ${!u.isActive})">${u.isActive ? 'Disable' : 'Enable'}</button>`;

            return `<tr>
                <td class="py-2.5 px-3 text-sm border-b border-white/[.08]">${avatarHtml}${u.displayName}</td>
                <td class="py-2.5 px-3 text-sm border-b border-white/[.08]">${u.email}</td>
                <td class="py-2.5 px-3 text-sm border-b border-white/[.08]">${rolesHtml}</td>
                <td class="py-2.5 px-3 text-sm border-b border-white/[.08]">${statusHtml}</td>
                <td class="py-2.5 px-3 text-sm border-b border-white/[.08]">${formatDate(u.createdAt)}</td>
                <td class="py-2.5 px-3 text-sm border-b border-white/[.08]"><div class="flex gap-1 flex-wrap">${addBtns}${removeBtns}${toggleBtn}</div></td>
            </tr>`;
        }).join('');
    }

    window.addRole = async function (userId, roleId) {
        await api(`${API}/users/${userId}/roles/${roleId}`, { method: 'POST' });
        toast('Role added');
        loadUsers();
    };

    window.removeRole = async function (userId, roleId) {
        await api(`${API}/users/${userId}/roles/${roleId}`, { method: 'DELETE' });
        toast('Role removed');
        loadUsers();
    };

    window.toggleActive = async function (userId, isActive) {
        await api(`${API}/users/${userId}/active`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isActive })
        });
        toast(isActive ? 'User activated' : 'User deactivated');
        loadUsers();
    };

    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
        });
    });

    try {
        allRoles = await api(`${API}/roles`);
        await Promise.all([loadStats(), loadUsers()]);
    } catch (e) {
        console.error('Admin init failed', e);
    }
})();
</script>
}
