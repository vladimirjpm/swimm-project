@page
@using Swimm.API.Pages.Admin.Shared
@model Swimm.API.Pages.Admin.ApiModel
@{
    ViewData["Title"] = "API Reference";
    ViewData["PageSubtitle"] = "Каталог эндпоинтов + Results/Competitions браузер";
}

<div class="max-w-[1100px] mx-auto">

    <div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-sm text-admin-text-muted leading-relaxed">
        <strong>Swimm API Reference</strong> — список всех доступных эндпоинтов сервера.
        Нажмите <strong>Run</strong> для выполнения запроса прямо из браузера.
    </div>

    <!-- Tabs -->
    <div class="flex gap-2 mb-6">
        <button class="tab-btn active py-2 px-5 border border-admin-accent rounded-md bg-transparent text-admin-accent cursor-pointer text-sm font-[inherit] transition-colors hover:bg-admin-accent/10 disabled:opacity-45 disabled:cursor-not-allowed" data-tab="public">🌍 Public API</button>
        <button class="tab-btn py-2 px-5 border border-admin-accent rounded-md bg-transparent text-admin-accent cursor-pointer text-sm font-[inherit] transition-colors hover:bg-admin-accent/10 disabled:opacity-45 disabled:cursor-not-allowed" data-tab="admin" id="admin-tab-btn" disabled>🔒 Admin API</button>
        <button class="tab-btn py-2 px-5 border border-admin-warning rounded-md bg-transparent text-admin-warning cursor-pointer text-sm font-[inherit] transition-colors hover:bg-admin-warning/10" data-tab="results">📊 Results</button>
        <button class="tab-btn py-2 px-5 border border-admin-success rounded-md bg-transparent text-admin-success cursor-pointer text-sm font-[inherit] transition-colors hover:bg-admin-success/10" data-tab="competitions" id="competitions-tab-btn" disabled>🏊 Competitions</button>
    </div>

    <!-- ======================== PUBLIC API ======================== -->
    <div class="tab-content active" id="tab-public">
        @foreach (var group in ApiCatalog.PublicGroups)
        {
            <div class="mb-8">
                @if (!string.IsNullOrEmpty(group.Title))
                {
                    <h2>@group.Title</h2>
                }
                @foreach (var endpoint in group.Endpoints)
                {
                    <partial name="/Pages/Admin/Shared/_ApiEndpointCard.cshtml" model="endpoint" />
                }
            </div>
        }
    </div>

    <!-- ======================== ADMIN API ======================== -->
    <div class="tab-content" id="tab-admin">

        <div class="admin-note">
            ⚠️ Эндпоинты ниже требуют роль <strong>Admin</strong>. Они не предназначены для общего доступа.
        </div>

        @foreach (var group in ApiCatalog.AdminGroups)
        {
            @if (!string.IsNullOrEmpty(group.Title))
            {
                <div class="mb-8">
                    <h2>@group.Title</h2>
                    @foreach (var endpoint in group.Endpoints)
                    {
                        <partial name="/Pages/Admin/Shared/_ApiEndpointCard.cshtml" model="endpoint" />
                    }
                </div>
            }
            else
            {
                @foreach (var endpoint in group.Endpoints)
                {
                    <partial name="/Pages/Admin/Shared/_ApiEndpointCard.cshtml" model="endpoint" />
                }
            }
        }

    </div>

    <!-- ======================== COMPETITIONS TAB ======================== -->
    <div class="tab-content" id="tab-competitions">

        <div class="bg-[rgba(79,195,247,0.08)] border-l-[3px] border-l-[#4fc3f7] rounded-md py-3 px-4 mb-6 text-sm text-[#90a4ae] leading-relaxed">
            Список соревнований. Редактируйте флаги и удаляйте соревнования вместе с результатами.
        </div>

        <div class="flex gap-3 mb-4 items-center">
            <button id="comp-refresh" class="py-1.5 px-4 bg-[#66bb6a] text-[#1a2e1a] rounded font-semibold text-xs cursor-pointer hover:bg-[#81c784] transition-colors">↻ Обновить</button>
            <span id="comp-status" class="text-xs text-[#90a4ae]"></span>
        </div>

        <div id="comp-list" class="flex flex-col gap-2"></div>
        <div id="comp-empty" class="hidden text-center text-[#546e7a] italic py-10">Нет соревнований.</div>

    </div>

    <!-- ======================== RESULTS TAB ======================== -->
    <div class="tab-content" id="tab-results">

        <div class="bg-white/[.05] rounded-lg px-5 py-4 mb-4">
            <h2 class="text-[#ffa726] text-base mb-3">🔍 Фильтры</h2>
            <div class="flex flex-wrap gap-3 items-end" id="results-filters">
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Имя / Фамилия
                    <input type="text" id="rf-name" list="dl-name" autocomplete="off"
                           class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-36 focus:outline-none focus:border-[#4fc3f7]"
                           placeholder="Фамилия…" />
                    <datalist id="dl-name"></datalist>
                </label>
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Соревнование
                    <input type="text" id="rf-competition" list="dl-competition" autocomplete="off"
                           class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-40 focus:outline-none focus:border-[#4fc3f7]"
                           placeholder="Название…" />
                    <datalist id="dl-competition"></datalist>
                </label>
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Клуб
                    <input type="text" id="rf-club" list="dl-club" autocomplete="off"
                           class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-32 focus:outline-none focus:border-[#4fc3f7]"
                           placeholder="Клуб…" />
                    <datalist id="dl-club"></datalist>
                </label>
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Стиль
                    <input type="text" id="rf-style" list="dl-style" autocomplete="off"
                           class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-28 focus:outline-none focus:border-[#4fc3f7]"
                           placeholder="freestyle…" />
                    <datalist id="dl-style"></datalist>
                </label>
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Дистанция
                    <input type="text" id="rf-distance" list="dl-distance" autocomplete="off"
                           class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-20 focus:outline-none focus:border-[#4fc3f7]"
                           placeholder="50…" />
                    <datalist id="dl-distance"></datalist>
                </label>
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Пол
                    <select id="rf-gender" class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-20 focus:outline-none focus:border-[#4fc3f7]">
                        <option value="">—</option>
                        <option value="M">M</option>
                        <option value="F">F</option>
                    </select>
                </label>
                <label class="text-xs text-[#90a4ae] flex flex-col gap-0.5">
                    Бассейн
                    <select id="rf-pool" class="bg-black/30 border border-[#546e7a] rounded text-[#e0e0e0] px-2 py-1 text-sm font-[inherit] w-20 focus:outline-none focus:border-[#4fc3f7]">
                        <option value="">—</option>
                        <option value="LCM">LCM</option>
                        <option value="SCM">SCM</option>
                    </select>
                </label>
                <button id="rf-search" class="py-1.5 px-5 bg-[#ffa726] text-[#1a1a2e] rounded font-semibold text-xs cursor-pointer hover:bg-[#ffb74d] transition-colors">Поиск</button>
            </div>
        </div>

        <div id="results-status" class="text-xs text-[#90a4ae] mb-2 hidden"></div>

        <div class="overflow-x-auto">
            <table class="w-full text-xs border-collapse" id="results-table">
                <thead>
                    <tr class="text-left text-[#546e7a] uppercase text-[0.7rem]">
                        <th class="py-2 px-2 border-b border-white/10">#</th>
                        <th class="py-2 px-2 border-b border-white/10">Дата</th>
                        <th class="py-2 px-2 border-b border-white/10">Пловец</th>
                        <th class="py-2 px-2 border-b border-white/10">Год</th>
                        <th class="py-2 px-2 border-b border-white/10">Клуб</th>
                        <th class="py-2 px-2 border-b border-white/10">Дистанция</th>
                        <th class="py-2 px-2 border-b border-white/10">Стиль</th>
                        <th class="py-2 px-2 border-b border-white/10">Время</th>
                        <th class="py-2 px-2 border-b border-white/10">Место</th>
                        <th class="py-2 px-2 border-b border-white/10">Соревнование</th>
                        <th class="py-2 px-2 border-b border-white/10">Бассейн</th>
                    </tr>
                </thead>
                <tbody id="results-body" class="text-gray-300"></tbody>
            </table>
        </div>

        <div class="flex gap-3 items-center mt-4" id="results-pager">
            <button id="rf-prev" class="py-1 px-3 bg-white/10 text-[#4fc3f7] rounded text-xs cursor-pointer hover:bg-white/20 transition-colors disabled:opacity-40 disabled:cursor-not-allowed" disabled>← Назад</button>
            <span id="rf-page-info" class="text-xs text-[#90a4ae]"></span>
            <button id="rf-next" class="py-1 px-3 bg-white/10 text-[#4fc3f7] rounded text-xs cursor-pointer hover:bg-white/20 transition-colors disabled:opacity-40 disabled:cursor-not-allowed" disabled>Вперёд →</button>
        </div>

    </div>

</div>

@section Scripts {
<script src="~/js/admin/api.js" asp-append-version="true"></script>
}
