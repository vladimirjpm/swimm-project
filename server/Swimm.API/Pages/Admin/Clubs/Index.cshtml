@page
@model Swimm.API.Pages.Admin.Clubs.IndexModel
@{
    ViewData["Title"] = "Clubs";
    ViewData["PageSubtitle"] = "Дубли клубов: кандидаты, dry-run и склейка";
}

<div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-[0.85rem] text-admin-text-muted leading-relaxed">
    Кандидаты ищутся по четырём эвристикам: полностью совпадающее имя у разных Id
    (<code>same-name</code>), мусорный хвост парсера (<code>suffix</code>), общие
    пловцы между клубами (<code>swimmers</code>), опечатка в названии (<code>levenshtein</code>).
    Отметь пары → <b>Dry-run</b> покажет план без изменений; <b>Merge выбранные</b> —
    необратимо: связи дубля перевешиваются на канонический клуб.
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
    <button id="btn-reload" class="admin-btn admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-[13px] font-semibold">Обновить кандидатов</button>
    <button id="btn-check-sure" class="cursor-pointer rounded-md border border-admin-border px-3 py-2 text-[13px] text-admin-text-muted">Выбрать все уверенные</button>
    <span id="info" class="text-[12.5px] text-admin-text-muted"></span>
    <form method="get" action="/Admin/Clubs/Edit" class="ml-auto flex items-center gap-2">
        <input type="number" name="id" min="1" class="admin-input w-40" placeholder="Клуб по Id…" autocomplete="off" />
        <button type="submit" class="admin-btn admin-btn-ghost">Открыть / переименовать</button>
    </form>
</div>

<div class="overflow-x-auto">
    <table class="admin-table">
        <thead>
            <tr>
                <th></th>
                <th>Канонический (остаётся)</th>
                <th>Дубль (удаляется)</th>
                <th>Эвристика</th>
                <th>Общих пловцов</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="cand-body"></tbody>
    </table>
</div>
<div id="empty-msg" class="hidden text-center text-admin-text-muted italic py-10">Кандидатов на склейку нет.</div>

<details id="ignored-wrap" class="mt-3 hidden text-[12.5px] text-admin-text-muted">
    <summary class="cursor-pointer select-none" id="ignored-summary">Скрытые пары</summary>
    <div id="ignored-body" class="mt-2 leading-relaxed"></div>
</details>

<div class="mt-4 flex gap-3">
    <button id="btn-dryrun" class="admin-btn admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-[13px] font-semibold">Dry-run</button>
    <button id="btn-merge" class="cursor-pointer rounded-md bg-admin-danger/20 border border-admin-danger/50 px-4 py-2 text-[13px] font-semibold text-[#ef9a9a] disabled:opacity-40" disabled>
        Merge выбранные (необратимо)
    </button>
</div>

<div id="status-line" class="admin-card mt-6 hidden p-4">
    <div class="mb-2 text-sm font-semibold text-admin-text" id="status-title"></div>
    <div id="status-summary" class="mb-3 text-[13px] text-admin-text-muted"></div>
    <div id="status-body" class="text-[13px] leading-relaxed"></div>
</div>

<details id="quality-wrap" class="mt-10 max-w-[900px]">
    <summary id="quality-summary" class="cursor-pointer select-none text-sm font-semibold text-admin-text">Качество данных</summary>
    <div class="mt-2 mb-2 flex flex-wrap gap-2 text-[12.5px]">
        <button class="admin-btn admin-btn-ghost py-1 px-2.5" data-qfilter="no-swimmers">Без пловцов</button>
        <button class="admin-btn admin-btn-ghost py-1 px-2.5" data-qfilter="no-country">Без страны</button>
        <button id="btn-del-empty" class="hidden cursor-pointer rounded-md bg-admin-danger/20 border border-admin-danger/50 px-2.5 py-1 font-semibold text-[#ef9a9a]">
            Удалить все пустые
        </button>
    </div>
    <div class="mb-2 text-[12.5px] text-admin-text-muted leading-relaxed">
        <b>Без пловцов</b> — клубы, у которых нет ни пловцов, ни результатов: как правило мусор
        парсера («фамилия + клуб»). Merge им не поможет (склеивать нечего), поэтому здесь есть
        «✕» — удалить. Склеенные клубы в список не попадают: их строки-надгробия держат старые
        ссылки <code>/clubs/{id}</code>, удалять их нельзя. <b>Без страны</b> — клубы живые,
        им нужно проставить страну, а не удалять.
    </div>
    <div id="quality-body" class="text-[13px] text-admin-text-muted">Выбери фильтр.</div>
</details>

<partial name="/Pages/Admin/Shared/_ConfirmDialog.cshtml" />

@section Scripts {
<script src="~/js/admin/clubs.js" asp-append-version="true"></script>
}
