@page
@model Swimm.API.Pages.Admin.Swimmers.LogligModel
@{
    ViewData["Title"] = "Loglig ID";
    ViewData["PageSubtitle"] = "Привязка пловцов к профилям loglig.com";
}

<div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-[0.85rem] text-admin-text-muted leading-relaxed">
    «Find loglig ID» ищет профиль пловца по имени и сверяет его с нашими результатами; если
    находится ровно один надёжный кандидат — привязка сохраняется автоматически, иначе показывается
    список кандидатов на выбор. Привязку можно также поставить вручную, вставив ссылку на карточку
    (<code>loglig.com/Players/Details/{id}</code>) или просто число. Привязка — только обогащение
    данных: она не влияет на права, зачёты и рекорды. Снять привязку можно кнопкой «Отвязать».
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
    <input id="q" type="text" placeholder="Поиск по имени…" dir="rtl"
           class="rounded-md border border-admin-border bg-transparent px-3 py-2 text-[13px] w-64" />
    <select id="status" class="rounded-md border border-admin-border bg-transparent px-3 py-2 text-[13px]">
        <option value="">Все</option>
        <option value="unlinked">Непривязанные</option>
        <option value="linked">Привязанные</option>
        <option value="suggested">На проверке</option>
        <option value="rejected">Отклонённые</option>
    </select>
    <button id="btn-search" class="admin-btn admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-[13px] font-semibold">Найти</button>
    <button id="btn-batch" class="cursor-pointer rounded-md border border-admin-border px-3 py-2 text-[13px] text-admin-text-muted"
            title="Прогнать через поиск+сверку N непривязанных пловцов с наибольшим числом результатов (каждый — 1–3 платных Serper-запроса)">
        Батч ×20
    </button>
    <span id="info" class="text-[12.5px] text-admin-text-muted"></span>
</div>

<div class="overflow-x-auto">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Имя</th>
                <th>Год</th>
                <th>Клуб</th>
                <th>Статус</th>
                <th>Loglig ID</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody id="rows-body"></tbody>
    </table>
</div>
<div id="empty-msg" class="hidden text-center text-admin-text-muted italic py-10">Ничего не найдено.</div>

@section Scripts {
<script>
    // Данные из Razor — до скрипта страницы, он их читает (wwwroot/js/admin/swimmers-loglig.js).
    window.__LOGLIG_SEASON = @Model.SeasonId;
</script>
<script src="~/js/admin/swimmers-loglig.js" asp-append-version="true"></script>
}
