@page
@model Swimm.API.Pages.Admin.Swimmers.IndexModel
@{
    ViewData["Title"] = "Swimmers";
    ViewData["PageSubtitle"] = "Дубли пловцов: кандидаты, dry-run и склейка";
}

<div class="admin-card border-l-[3px] border-l-admin-accent py-3 px-4 mb-6 text-[0.85rem] text-admin-text-muted leading-relaxed">
    Кандидаты ищутся по нормализованному имени (иврит: финальные буквы, гереш ↔ апостроф),
    Левенштейн ≤ 2, одинаковый год рождения; та же логика, что в
    <code>docs/tasks/dedup-report.md</code>. Отметь пары → <b>Dry-run</b> покажет полный план
    без изменений; <b>Применить</b> — необратимо: связи дубля перевешиваются на канонического,
    дубль удаляется. Пары с общим заплывом сервис откажется мержить сам.
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
    <button id="btn-reload" class="admin-btn admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-[13px] font-semibold">Обновить кандидатов</button>
    <button id="btn-check-sure" class="cursor-pointer rounded-md border border-admin-border px-3 py-2 text-[13px] text-admin-text-muted">Отметить уверенные</button>
    <span id="info" class="text-[12.5px] text-admin-text-muted"></span>
</div>

<div class="overflow-x-auto">
    <table class="admin-table">
        <thead>
            <tr>
                <th></th>
                <th>Канонический (остаётся)</th>
                <th>Дубль (удаляется)</th>
                <th>Год</th>
                <th>Клубы</th>
                <th>Рез.</th>
                <th>dist</th>
                <th>Тип</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="cand-body"></tbody>
    </table>
</div>
<div id="empty-msg" class="hidden text-center text-admin-text-muted italic py-10">Кандидатов на склейку нет.</div>

<details id="ignored-wrap" class="mt-3 hidden text-[12.5px] text-admin-text-muted">
    <summary class="cursor-pointer select-none" id="ignored-summary">Скрытые пары</summary>
    <div id="ignored-body" class="mt-2 leading-relaxed"></div>
</details>

<div class="mt-4 flex gap-3">
    <button id="btn-dryrun" class="admin-btn admin-btn-primary cursor-pointer rounded-md px-4 py-2 text-[13px] font-semibold">Dry-run выбранных</button>
    <button id="btn-apply" class="cursor-pointer rounded-md bg-admin-danger/20 border border-admin-danger/50 px-4 py-2 text-[13px] font-semibold text-[#ef9a9a] disabled:opacity-40" disabled>
        Применить (необратимо)
    </button>
</div>

<div id="plan-card" class="admin-card mt-6 hidden p-4">
    <div class="mb-2 text-sm font-semibold text-admin-text" id="plan-title"></div>
    <div id="plan-body" class="text-[13px] leading-relaxed"></div>
</div>

<h2 class="mt-10 mb-2 text-sm font-semibold text-admin-text">Сироты (0 результатов, 0 связей)</h2>
<div class="mb-3">
    <button id="btn-delete-orphans" class="cursor-pointer rounded-md bg-admin-danger/20 border border-admin-danger/50 px-4 py-2 text-[13px] font-semibold text-[#ef9a9a] disabled:opacity-40" disabled>
        Удалить всех сирот (0)
    </button>
</div>
<div id="orphans" class="text-[12.5px] text-admin-text-muted leading-relaxed"></div>

<details id="search-hidden-wrap" class="mt-10 max-w-[900px]">
    <summary id="search-hidden-summary" class="cursor-pointer select-none text-sm font-semibold text-admin-text">Скрыты из поиска</summary>
    <div class="mt-2 mb-3 text-[12.5px] text-admin-text-muted leading-relaxed">
        По просьбе (письмо на privacy@@swimhub.co.il, страница <code>/privacy</code>): страница пловца получает
        <code>noindex</code> и уходит из <code>sitemap.xml</code>. Это не удаление — страница
        открывается по ссылке, результаты остаются в соревнованиях (Р76).
    </div>
    <div class="mb-3 flex flex-wrap items-center gap-2 text-[13px]">
        <input id="search-hide-id" type="number" min="1" placeholder="Id пловца"
               class="w-32 rounded-md border border-admin-border bg-transparent px-2 py-1.5 text-admin-text" />
        <button id="btn-search-hide" class="admin-btn admin-btn-primary cursor-pointer rounded-md px-3 py-1.5 text-[13px] font-semibold">Скрыть из поиска</button>
    </div>
    <div id="search-hidden-body" class="text-[13px] text-admin-text-muted">Загружаю…</div>
</details>

<details id="quality-wrap" class="mt-10 max-w-[900px]">
    <summary id="quality-summary" class="cursor-pointer select-none text-sm font-semibold text-admin-text">Качество данных</summary>
    <div class="mt-2 mb-2 flex flex-wrap gap-2 text-[12.5px]">
        <button class="admin-btn admin-btn-ghost py-1 px-2.5" data-qfilter="no-org-id">Без OrgId</button>
        <button class="admin-btn admin-btn-ghost py-1 px-2.5" data-qfilter="no-results">Без результатов</button>
    </div>
    <div id="quality-body" class="text-[13px] text-admin-text-muted">Выбери фильтр.</div>
</details>

@section Scripts {
<script src="~/js/admin/swimmers.js" asp-append-version="true"></script>
}
