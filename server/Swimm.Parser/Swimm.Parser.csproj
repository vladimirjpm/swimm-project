<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Swimm.Parser</RootNamespace>
    <AssemblyName>Swimm.Parser</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Запускаемся через доверенный хост dotnet.dll, а не через apphost-exe:
         обходит политику Windows Application Control (Smart App Control / WDAC),
         которая блокирует свежесобранный неподписанный .exe. Только для Debug —
         Release/publish продолжает собирать обычный исполняемый файл. -->
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="Services\Parsers\IsrOrgAgeRecords\ai-helper\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="UglyToad.PdfPig.DocumentLayoutAnalysis" Version="1.7.0-custom-5" />
  </ItemGroup>

</Project>
